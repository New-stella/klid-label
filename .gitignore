# IDE
.idea/
.vscode/
*.iml

# OS
.DS_Store
Thumbs.db

# Claude
.claude-plan-*.md
.code-review-result
.claude/settings.local.json

# 환경 설정
.env
.env.local
# ★ 백업본도 무시한다 — .env.bak.* 는 평문 시크릿(DB 비밀번호·JWT/스트림 서명키)을 그대로 담는데
#   위 두 줄만으로는 잡히지 않아 `git add -A` 한 번이면 원격으로 나간다(실측: git check-ignore 미매치).
.env.bak*
.env.backup*
.env.*.bak
*.local
# .env.example 은 커밋 (placeholder 만)
!.env.example

# 빌드 산출물
build/
dist/
node_modules/
.next/

# Python
__pycache__/
*.pyc
.venv/
*.egg-info/
.mypy_cache/
.pytest_cache/

# 외부 도구 바이너리 (scripts/hwpx_fill.py가 1회 자동 다운로드)
tools/plantuml.jar

# 외부 업체 제공 문서 원본 (저작권 — 서버 업로드 제외, 전사본은 docs/v2-wiki/22-deid-solution-api.md)
docs/비식별화 솔루션 API 연동 방안.pdf

# 리포트 (로컬 생성물)
# ★ `reports/` 가 아니라 `reports/*` 로 쓴다 — 디렉토리 자체가 제외되면 그 안쪽을 부정 규칙으로
#   되살릴 수 없다(git 은 제외된 디렉토리를 아예 훑지 않는다).
reports/*

# ⚠ 구 예외 `!reports/logicraft-audit-2/` 는 폐기한다(2026-08-09 사용자 확정).
# 당시 근거는 "라운드가 진행 중이라 재개문서·판정 근거가 필요하다" 였는데 그 라운드가 끝났고,
# 남길 가치가 있는 결론은 전부 다른 계층으로 옮겨졌다 — 구속 정책은 CLAUDE.md, 절차·함정은
# .claude/rules/, 교훈은 auto-memory, 검증 케이스는 docs/test-cases/. 남은 것은 작업 로그이며
# 그건 이 저장소 규약상 로컬 계층이다.
# ⚠ 대가(인지·수용): 이 워크트리를 지우면 그 로그는 사라진다. 필요하면 지우기 전에 꺼내 둘 것.

# 외부 참조 소스 (CVAT 원본 트리 — 커스텀 라벨링 도구 레퍼런스)
cvat/

# 로컬 스토리지 (시드 placeholder 이미지, TUS 업로드 임시 등 — 운영은 NAS 마운트)
# ★ 반드시 선행 슬래시로 앵커링한다 — 비앵커 `storage/` 는 트리 어디든 'storage' 라는 이름의
#   디렉토리를 전부 무시하여 Java 패키지(common/storage/) 소스까지 커밋에서 누락시킨다.
/storage/
backend/storage/

# Playwright MCP 캐시
.playwright-mcp/

# Frontend TypeScript 빌드 산출물 (vite/vitest config 컴파일 결과)
frontend/vite.config.d.ts
frontend/vite.config.js
frontend/vitest.config.d.ts
frontend/vitest.config.js
frontend/*.tsbuildinfo

# 설계 산출물 hwpx 변환본 (바이너리·대용량 — 레포 제외, 로컬/별도 공유)
docs/design/hwpx/

.claude-plan.md
.claude-progress.md
.claude-design.md
# 변형 접미사 붙은 하네스 산출물 (.claude-plan.deident-*, .claude-design.keypoint-* 등)
.claude-plan.*
.claude-design.*

# 로그 (빌드/테스트 출력 캡처)
*.log

# 루트 스크래치 스크린샷 (검증 중 캡처 — d5-*.png, keypoint-*.png, label-*.png 등)
/*.png

# E2E 테스트 산출물
frontend/test-results/
frontend/playwright-report/

# pytest JUnit 리포트 (ai-server 회귀 실행 산출물)
ai-server/test-results.xml

# vitest JUnit 리포트 (frontend 전체 회귀를 --reporter=junit 로 돌릴 때 생기는 산출물).
# 설정에 붙어 있지 않고 QA 실행 커맨드에서만 만들어지지만, 수십 MB 라 한 번 딸려 들어가면
# 되돌리기 어렵다(이 저장소에 대용량 파일 커밋 사고 이력이 있다).
frontend/vitest-results.xml

# 문서 자동 백업본 (타임스탬프 접미사)
*.bak-*
.bak-*/
docs/design/backup/

# cc-forge 하네스 작업파일 (런타임 중립 접두)
.cc-plan.md
.cc-plan.*
.cc-design.md
.cc-progress.md
.cc-review-result

# LogiCraft 화면 키트 — 다운로더 산출물(재생성 가능, 약 30MB)
docs/screen-design/*/.staging*/
docs/screen-design/*/.verify*/
docs/screen-design/*/.wf-*/

# 설계 사본·파생 산출물은 저장소에 두지 않는다 (2026-08-09 사용자 확정).
# 정본은 LogiCraft 서버다. 사본은 서버가 움직이는 순간 낡기 시작하고 되받을 경로가 없다
# (다운로더가 인증을 요구하는데 발급된 키가 없다). 실측: 가장 나은 사본도 화면 32건 중 12건만 최신.
# 낡은 사본이 저장소에 있으면 누군가 그것을 정본으로 읽는다 — 이 라운드에 여러 번 그럴 뻔했다.
# 와이어프레임 HTML 은 그 낡은 본문에서 생성된 파생물이라 같은 이유로 제외한다.
# ⚠ bin/ 의 검증 도구는 제외 대상이 아니다 — 규칙 파일이 그 도구를 쓰라고 지목한다.
docs/screen-design/*/baseline/
docs/screen-design/*/wireframes-generated/

# 로컬 DB 덤프 (재기동 전 백업 — PII 포함 가능, 커밋 금지)
backup/

# 반입 매체 압축본 — 별도 배포용으로 로컬에 남긴다(1GB+). 절대 커밋하지 않는다.
deploy/*.tgz
deploy/*.tar.gz
# ★분할본도 같다 — 자료실 1건당 3GB 한도 때문에 쪼갠 조각이며 각각이 GB 급이다.
#   확장자가 .tgz 로 끝나지 않아 위 두 줄에 걸리지 않는다(실제로 1.86GiB 조각이
#   추적 대상으로 남아 있었다).
deploy/*.part-*
deploy/*.tgz.part*
# 반입 인계 폴더 — 위 산출물을 하드링크로 모아 두는 자리다. 실체는 같은 파일이라
# 여기서 지워도 원본은 남고 그 반대도 같다(둘 중 하나만 지운다고 용량이 줄지 않는다).
# ★압축본만 막고 README·무결성표는 남긴다 — 그 둘은 <무엇을 어떤 순서로 들고 가는지>의
#   기록이라 다음 사람이 매체 없이도 읽을 수 있어야 한다.
deploy/반입/*
!deploy/반입/README.md
!deploy/반입/SHA256SUMS
