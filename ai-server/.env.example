# ai-server 환경변수 예시
# 운영 환경에서는 .env 또는 환경변수로 주입 (시크릿 평문 커밋 금지)

# 동작 모드
# 로컬 외부0개 자족: AI_MOCK_MODE=false(실추론) + AI_DEVICE=cpu (GPU 불필요).
#   가중치 부재 시 자동으로 mock fallback 되므로 false 라도 안전.
AI_MOCK_MODE=false           # true: 가중치 없이 mock 응답 / false: 실제 모델 로드
AI_DEVICE=cpu                # cpu | cuda

# 탐지/트래킹 백엔드: yolo | rtdetr
#   rtdetr: RT-DETRv2(transformers). 첫 기동 시 HuggingFace 에서 RTDETR_MODEL_ID(~100MB) 다운로드 후 캐시.
#   yolo  : 로컬 .pt 가중치 사용(오프라인). 둘 다 CPU 동작.
DETECTOR_BACKEND=rtdetr
# RTDETR_MODEL_ID=PekingU/rtdetr_v2_r50vd   # 기본값

# 보안
MAX_IMAGE_SIZE_MB=10         # image_b64 최대 크기 (1~100)

# 모델 가중치 (DETECTOR_BACKEND=yolo 및 SAM2 에 사용. rtdetr 은 HF 캐시 사용)
# yolov8m 기본, 부재 시 YOLO_WEIGHTS_FALLBACK_PATH(yolov8n) 자동 대체. 둘 다 부재 시 mock(weights_missing).
YOLO_WEIGHTS_PATH=./weights/yolov8m.pt
YOLO_WEIGHTS_FALLBACK_PATH=./weights/yolov8n.pt
# 저장소에 동봉된 실제 파일명과 일치 (sam2_t.pt). 부재 시 SAM2 는 mock.
SAM2_WEIGHTS_PATH=./weights/sam2_t.pt
VLM_MODEL_NAME=openai/clip-vit-base-patch32

# CORS — prd에서는 Spring Boot 도메인만 (콤마 구분)
CORS_ALLOW_ORIGINS=*

# uvicorn 포트 (옵션)
PORT=9300
