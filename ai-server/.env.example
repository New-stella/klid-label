# ai-server 환경변수 예시
# 운영 환경에서는 .env 또는 환경변수로 주입 (시크릿 평문 커밋 금지)

# 동작 모드
AI_MOCK_MODE=true            # true: 가중치 없이 mock 응답 / false: 실제 모델 로드
AI_DEVICE=cpu                # cpu | cuda

# 보안
MAX_IMAGE_SIZE_MB=10         # image_b64 최대 크기 (1~100)

# 모델 가중치
# Phase 1 (모델 업그레이드): yolov8m 기본. 부재 시 YOLO_WEIGHTS_FALLBACK_PATH 로 자동 대체.
# 둘 다 부재 시 mock 응답 (mock_reason=weights_missing)
YOLO_WEIGHTS_PATH=./weights/yolov8m.pt
YOLO_WEIGHTS_FALLBACK_PATH=./weights/yolov8n.pt
SAM2_WEIGHTS_PATH=./weights/sam2.pt
VLM_MODEL_NAME=openai/clip-vit-base-patch32

# CORS — prd에서는 Spring Boot 도메인만 (콤마 구분)
CORS_ALLOW_ORIGINS=*

# uvicorn 포트 (옵션)
PORT=9300
