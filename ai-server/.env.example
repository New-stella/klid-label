# ai-server 환경변수 예시
# 운영 환경에서는 .env 또는 환경변수로 주입 (시크릿 평문 커밋 금지)

# 동작 모드
# 로컬 외부0개 자족: AI_MOCK_MODE=false(실추론) + AI_DEVICE=cpu (GPU 불필요).
#   가중치 부재 시 자동으로 mock fallback 되므로 false 라도 안전.
AI_MOCK_MODE=false           # true: 가중치 없이 mock 응답 / false: 실제 모델 로드
AI_DEVICE=cpu                # cpu | cuda

# 배포 환경 표식 (backend 와 동일 신호: local | dev | stg | prd)
#   stg/prd 에서 AI_MOCK_MODE=true 면 기동을 거부한다(app/startup_guard.py) —
#   mock 응답은 실제 객체와 무관한 합성 라벨(person, score=0.9)이라 학습데이터를 오염시킨다.
ENV=local

# 탐지/트래킹 백엔드: YOLOX (ONNX Runtime) + ByteTrack 단일 백엔드.
#   YOLOX_WEIGHTS_PATH 의 ONNX 가중치 사용(오프라인, CPU 동작).
#   부재 시 mock(weights_missing) 응답.

# 보안
MAX_IMAGE_SIZE_MB=10         # image_b64 최대 크기 (1~100)

# 모델 가중치 (YOLOX ONNX 탐지 및 SAM2 에 사용)
# 부재 시 mock(weights_missing) 응답.
YOLOX_WEIGHTS_PATH=./weights/yolox_s.onnx
# SAM2 는 로컬 가중치 파일이 아니라 HuggingFace 모델 ID 로 적재한다
#   (app/models/sam2_loader.py → SAM2ImagePredictor.from_pretrained).
#   ⚠ 구 키 SAM2_WEIGHTS_PATH(=./weights/sam2_t.pt)는 ultralytics SAM 시절 잔재라 제거했다 —
#     config.Settings 에 대응 필드가 없고 extra="ignore" 라 <조용히 무시>되던 값이다.
SAM2_MODEL_ID=facebook/sam2-hiera-tiny
VLM_MODEL_NAME=openai/clip-vit-base-patch32

# CORS — prd에서는 Spring Boot 도메인만 (콤마 구분)
CORS_ALLOW_ORIGINS=*

# uvicorn 포트 (옵션)
PORT=9300
