<?xml version="1.0" encoding="UTF-8"?>
<!--
  klid-label backend — JBoss EAP 배포 서술자  [@design DEPLOY-001 · RUNBOOK-001]

  대상 WAS: JBoss EAP 8.1 (standalone) + Java 17  — 2026-09-04 현장 실측
    · JBOSS_HOME 예: /GCLOUD/JBOSS/jboss-eap-8.1
    · 배포 위치    : $JBOSS_HOME/standalone/deployments/api.war

  ★ 이 파일이 왜 필요한가 — 없으면 <로그 마스킹이 조용히 사라진다>.
    EAP 는 자체 로깅 서브시스템(org.jboss.logmanager)으로 배포물의 로깅을 가로챈다.
    그러면 WEB-INF/classes/logback-spring.xml 이 무시될 수 있는데, 그 파일은 단순 포맷 설정이
    아니라 <민감정보 마스킹>(common.logging 의 마스킹 레이아웃)을 거는 자리다.
    가로채기가 일어나도 <서버는 정상 기동하고 로그도 나온다> — 개인정보가 평문으로 찍히는
    것으로만 드러난다(CWE-359). 그래서 배포 시점에 아무 신호가 없다.

    현장 실측으로 EAP 가 -Dlogging.configuration=.../standalone/configuration/logging.properties
    로 기동 중임을 확인했다(로깅 서브시스템 활성).

  ★ 톰캣에는 이런 파일이 필요 없다. 이 파일은 EAP/WildFly 계열에서만 읽히며, 다른 컨테이너에
    배포해도 <무시될 뿐 해가 없다>. 그래서 컨테이너별로 WAR 를 나누지 않는다.

  ⚠ 이 파일을 지우거나 exclude-subsystems 를 지우지 말 것. "안 쓰는 설정처럼 보인다"는
    이유로 정리하면 마스킹이 함께 사라진다.
-->
<jboss-deployment-structure xmlns="urn:jboss:deployment-structure:1.3">
  <deployment>

    <exclude-subsystems>
      <!--
        logging — 필수.
          배포물이 자기 로깅 설정(logback-spring.xml)을 그대로 쓰게 한다.
          이걸 빼면 EAP 로깅 서브시스템이 배포물의 로그 컨텍스트를 가져가고,
          logback 설정과 그 안의 마스킹이 적용되지 않을 수 있다.
      -->
      <subsystem name="logging"/>

      <!--
        jpa — 방어적.
          스프링이 EntityManagerFactory 를 직접 만들고(LocalContainerEntityManagerFactoryBean)
          persistence.xml 을 쓰지 않으므로 지금은 EAP 의 JPA 서브시스템이 발동하지 않는다.
          다만 나중에 누군가 persistence.xml 을 추가하면 컨테이너가 퍼시스턴스 유닛을 <자기가>
          관리하려 들면서 스프링이 만든 것과 이중이 된다. 그때는 원인을 찾기 어렵다.
          지금 빼 두면 그 경로가 처음부터 닫힌다. 현재 동작에는 영향이 없다.
      -->
      <subsystem name="jpa"/>
    </exclude-subsystems>

    <exclusions>
      <!--
        WAR 가 이미 자기 판을 WEB-INF/lib 에 담고 있는 로깅 모듈들이다.
        컨테이너가 같은 이름의 모듈을 암묵 의존으로 얹으면 클래스가 두 벌이 되어
        어느 쪽이 이기는지가 배포 순서에 따라 갈린다.
          · slf4j-api 2.0.13        (WEB-INF/lib)
          · logback-classic/core    (WEB-INF/lib)
          · jboss-logging 3.5.3     (WEB-INF/lib — 하이버네이트 의존)
        ⚠ 목록에 없는 모듈을 지정해도 오류가 아니라 무시되므로, 판이 올라가며 모듈 이름이
          바뀌어도 배포가 깨지지 않는다.
      -->
      <module name="org.jboss.logging"/>
      <module name="org.slf4j"/>
      <module name="org.slf4j.impl"/>
      <module name="org.apache.commons.logging"/>
      <module name="org.apache.log4j"/>
      <module name="org.jboss.logmanager"/>
    </exclusions>

  </deployment>
</jboss-deployment-structure>
