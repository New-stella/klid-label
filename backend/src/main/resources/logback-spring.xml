<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!--
        A-ISSUE-24 (CWE-532): MaskingPatternLayout 은 Layout(PatternLayout 상속)이지 Converter 가 아니다.
        구 설정은 이를 <conversionRule converterClass=...> 로 등록했는데, 그 자리에 필요한 것은
        ClassicConverter 구현체다. 그래서 어떤 패턴에서도 참조될 수 없었고 local 패턴은 평문 %msg 를
        그대로 출력했다(마스킹 미적용 = 죽은 코드). 죽은 conversionRule 을 제거하고, 인코더가 이 Layout 을
        직접 감싸도록(LayoutWrappingEncoder) 배선해 appender 출력 종단에서 마스킹이 적용되게 한다.
        dev/stg/prd 는 JSON 인코더의 MaskingJsonValueMasker 로 이미 적용되어 있다.
    -->
    <springProfile name="local">
        <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder class="ch.qos.logback.core.encoder.LayoutWrappingEncoder">
                <charset>UTF-8</charset>
                <layout class="kr.co.cudo.authoring.common.logging.MaskingPatternLayout">
                    <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level [%X{traceId:-}] %logger{36} - %msg%n</pattern>
                </layout>
            </encoder>
        </appender>
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>
        <logger name="kr.co.cudo.authoring" level="DEBUG"/>
    </springProfile>

    <springProfile name="dev,stg,prd">
        <!--
            HIGH-1 fix (CWE-532, OWASP A09): MaskingPatternLayout 은 PatternLayout 전용이라
            LogstashEncoder 사용 시 password/token/Authorization 이 마스킹되지 않았다.
            LoggingEventCompositeJsonEncoder + ValueMasker 로 마스킹 적용.

            A-ISSUE-62 (HIGH, CWE-359/532): 마스커가 <message> provider 하위에만 걸려 있어
            <stackTrace/> 로 나가는 예외 메시지·스택에 실린 자격증명/PII 는 전혀 마스킹되지 않았다
            (local 의 MaskingPatternLayout 은 throwable 포함 전체 문자열을 처리하므로 환경 간 비대칭).
            마스커를 인코더 레벨의 MaskingJsonGeneratorDecorator 로 올려 JSON 의 <b>모든 문자열 값</b>
            (message + stack_trace 포함)에 동일 규칙이 적용되게 한다. provider 별 중복 선언은
            제거한다 — 같은 문자열을 두 번 정규식 처리해 hot path 비용만 늘기 때문.
        -->
        <appender name="JSON" class="ch.qos.logback.core.ConsoleAppender">
            <encoder class="net.logstash.logback.encoder.LoggingEventCompositeJsonEncoder">
                <jsonGeneratorDecorator class="net.logstash.logback.mask.MaskingJsonGeneratorDecorator">
                    <valueMasker class="kr.co.cudo.authoring.common.logging.MaskingJsonValueMasker"/>
                </jsonGeneratorDecorator>
                <providers>
                    <timestamp/>
                    <version/>
                    <logLevel/>
                    <loggerName/>
                    <threadName/>
                    <mdc>
                        <includeMdcKeyName>traceId</includeMdcKeyName>
                    </mdc>
                    <message/>
                    <stackTrace/>
                    <pattern>
                        <pattern>{"app":"klid-la-authoring"}</pattern>
                    </pattern>
                </providers>
            </encoder>
        </appender>
        <root level="INFO">
            <appender-ref ref="JSON"/>
        </root>
    </springProfile>
</configuration>
