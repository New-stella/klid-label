<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <conversionRule conversionWord="mask"
                    converterClass="kr.co.cudo.authoring.common.logging.MaskingPatternLayout"/>

    <springProfile name="local">
        <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
                <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level [%X{traceId:-}] %logger{36} - %msg%n</pattern>
            </encoder>
        </appender>
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>
        <logger name="kr.co.cudo.authoring" level="DEBUG"/>
    </springProfile>

    <springProfile name="dev,stg,prd">
        <!--
            HIGH-1 fix (CWE-532, OWASP A09): MaskingPatternLayout 은 PatternLayout 전용이라
            LogstashEncoder 사용 시 password/token/Authorization 이 마스킹되지 않았다.
            LoggingEventCompositeJsonEncoder + ValueMasker 로 message 필드에 마스킹 적용.
        -->
        <appender name="JSON" class="ch.qos.logback.core.ConsoleAppender">
            <encoder class="net.logstash.logback.encoder.LoggingEventCompositeJsonEncoder">
                <providers>
                    <timestamp/>
                    <version/>
                    <logLevel/>
                    <loggerName/>
                    <threadName/>
                    <mdc>
                        <includeMdcKeyName>traceId</includeMdcKeyName>
                    </mdc>
                    <message>
                        <valueMasker class="kr.co.cudo.authoring.common.logging.MaskingJsonValueMasker"/>
                    </message>
                    <stackTrace/>
                    <pattern>
                        <pattern>{"app":"klid-la-authoring"}</pattern>
                    </pattern>
                </providers>
            </encoder>
        </appender>
        <root level="INFO">
            <appender-ref ref="JSON"/>
        </root>
    </springProfile>
</configuration>
