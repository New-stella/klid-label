ENV=local

# JWT (관제서버/포털 공통 발급 서버)
JWT_SECRET=
JWT_ISSUER=klid-auth
# 개발/검수 전용 토큰 발급 API: POST /api/v1/dev/tokens (활성: !prd, prd 에서 404)

# 관제서버 DB (klid_system 공유)
# 로컬 개발: docker mariadb:10.11 컨테이너 (klid-mariadb), localhost:3307/klid_system
#   기본 자격증명은 application-local.yml의 fallback (klid_user/klid_local_2024) 사용 — 별도 설정 불필요
# 운영(dev/stg/prd): 192.168.102.101:13307 (관제서버팀과 공유)
CONTROL_DB_HOST=192.168.102.101
CONTROL_DB_PORT=13307
CONTROL_DB_NAME=klid_system
CONTROL_DB_USERNAME=
CONTROL_DB_PASSWORD=

# 포털 DB (공유)
# 로컬 개발: docker mariadb:10.11 컨테이너, localhost:3307/portal
PORTAL_DB_HOST=
PORTAL_DB_PORT=3306
PORTAL_DB_NAME=portal
PORTAL_DB_USERNAME=
PORTAL_DB_PASSWORD=

# 외부 연동
CONTROL_SERVER_API_URL=
CONTROL_M2M_TOKEN=
PORTAL_SERVER_API_URL=
PORTAL_M2M_TOKEN=
DEIDENTIFY_API_URL=
AI_SERVER_URL=http://localhost:9300
GITEA_BASE_URL=
GITEA_TOKEN=
GITEA_OWNER=authoring
GITEA_REPO=labels

# 저장소 경로
STORAGE_RAW_PATH=./storage/raw
STORAGE_DEIDENTIFIED_PATH=./storage/deidentified
