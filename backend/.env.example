ENV=local

# ============================================================================
# 백엔드 환경변수 예시 (네이티브 bootRun 용).
#   도커 스택(compose)은 리포지토리 루트의 .env.example 을 사용한다 — 이 파일이 아니다.
#
# ★ dev 프로파일 필수 키 표시 규칙
#   [필수-기동]  미주입 시 부팅 실패 (기본값 없는 ${VAR})
#   [필수-기능]  기동은 되지만 해당 기능이 조용히 죽음 (빈 기본값 — local 기본값을 상속하지 않음)
#   전체 목록·증상·서버 반영 절차: docs/operations/config-key-changes-20260727.md §4-2
# ============================================================================

# ---- 프로파일 ----
# local(자족) / dev(cudo_246, mock-server 실연동) / stg / prd
SPRING_PROFILES_ACTIVE=local

# JWT (관제서버/포털 공통 발급 서버)
# [필수-기동] openssl rand -hex 48 (>= 256bit). local 프로파일만 개발용 기본값 보유.
JWT_SECRET=
JWT_ISSUER=klid-auth
# 개발/검수 전용 토큰 발급 API: POST /api/v1/dev/tokens (활성: !prd, prd 에서 404)

# ---- [필수-기능] 미주입 시 기동은 되지만 기능이 죽는 키 (dev/stg/prd 공통) ----
# 영상 스트림 단기 서명 시크릿(JWT_SECRET 과 분리, >= 32B). 빈 값이면 서명 발급·검증 전면
#   fail-closed → 마킹/라벨링 화면에서 영상이 재생되지 않는다. openssl rand -hex 32
STREAM_SIGN_SECRET=
# CORS allowlist. 빈 값이면 브라우저 요청이 전부 403("Invalid CORS request") — FE 전면 차단.
CORS_ALLOWED_ORIGINS=
# 관리자 role-claim 공유 비밀번호 BCrypt 해시(cost >= 12). 빈 값이면 관리자 클레임 불가.
ADMIN_CLAIM_PASSWORD_HASH=

# 관제서버 DB (klid_system 공유) — PostgreSQL
# [필수-기동] dev/stg/prd 는 기본값이 없다(내부 IP 평문 커밋 제거). 미주입 시 부팅 실패.
#   로컬 개발: docker postgres 컨테이너 (klid-postgres), localhost:5432/klid_system
#     기본 자격증명은 application-local.yml 의 fallback 사용 — 별도 설정 불필요
CONTROL_DB_HOST=
CONTROL_DB_PORT=5432
CONTROL_DB_NAME=klid_system
CONTROL_DB_USERNAME=
CONTROL_DB_PASSWORD=

# 포털 DB (공유) — PostgreSQL
# [필수-기동] 위와 동일
# 로컬 개발: docker postgres 컨테이너, localhost:5432/portal
PORTAL_DB_HOST=
PORTAL_DB_PORT=5432
PORTAL_DB_NAME=portal
PORTAL_DB_USERNAME=
PORTAL_DB_PASSWORD=

# 외부 연동
# 관제/포털 양방향 통합 및 외부 학습데이터 API 는 deprecated — 관련 env 미사용.
DEIDENTIFY_API_URL=
AI_SERVER_URL=http://localhost:9300

# ---- 비식별(KPST) ----
# ★ 구속 원칙: 본 프로그램이 스스로 결과를 채우는 내부 self-fill 경로는 쓰지 않는다.
#   DEIDENTIFY_MOCK_MODE=true 는 외부 무접촉으로 원본을 비식별 경로에 복사해 "성공"을 만든다
#   (연동 검증 불가). dev 기본값은 false 이며, 목업 벤더 서버(mock-server)에 실제 위탁한다.
#   네이티브 기동 시 mock-server 를 직접 띄우고 localhost:9400 을 주입할 것.
DEIDENTIFY_MOCK_MODE=false
KPST_DEID_ENABLED=true
KPST_DEID_BASE_URL=http://localhost:9400
# https 주소를 주입하는 경우에만 필요(CWE-295 fail-closed — 미주입 시 부팅 차단)
KPST_DEID_CA_CERT_PATH=

# 외부 VLM 시계열 메타 분석 서비스
#  - false 면 VlmClient 가 외부 호출 없이 SKIPPED 를 반환해 VLM 단계가 통째로 빈다.
#  - dev 기본값 true + mock-server. 코드가 읽는 키는 vlm.client.url(=VLM_SERVICE_URL).
VLM_CLIENT_ENABLED=true
VLM_SERVICE_URL=http://localhost:9400
VLM_SERVICE_TOKEN=

# 외부 시스템이 결과를 push 할 콜백 수신 base URL (+ /v1/vlm/callback, /v1/aug/callback).
#   도커에서는 반드시 컨테이너에서 도달 가능한 주소여야 한다(http://klid-backend:8080/api).
#   localhost 로 두면 목/외부 서버가 자기 자신에게 POST 해 결과가 전부 유실된다.
WEBHOOK_CALLBACK_BASE_URL=http://localhost:8080/api

# Phase 2 — 외부 시스템 결과 수신 webhook HMAC 시크릿 (경로별 분리)
#  - 시크릿 미설정 시 webhook 경로 자체 401 (fail-closed). 빈 시크릿 회피 차단.
#  - HMAC-SHA256("{timestamp}.{body}", secret) → hex 헤더 X-Signature 와 비교.
#  - timestamp 윈도우 기본 300s (replay 방지).
WEBHOOK_HMAC_SECRET_DEIDENTIFY=
WEBHOOK_HMAC_SECRET_VLM=
# [필수-기능] 빈 값이면 증강 콜백이 401 로 거부된다.
WEBHOOK_HMAC_SECRET_AUGMENT=
WEBHOOK_HMAC_TIMESTAMP_WINDOW=300

# 저장소 경로
STORAGE_RAW_PATH=./storage/raw
STORAGE_DEIDENTIFIED_PATH=./storage/deidentified
