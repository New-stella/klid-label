ENV=local

# JWT (관제서버/포털 공통 발급 서버)
JWT_SECRET=
JWT_ISSUER=klid-auth
# 개발/검수 전용 토큰 발급 API: POST /api/v1/dev/tokens (활성: !prd, prd 에서 404)

# 관제서버 DB (klid_system 공유) — PostgreSQL
# 로컬 개발: docker postgres 컨테이너 (klid-postgres), localhost:5432/klid_system
#   기본 자격증명은 application-local.yml의 fallback (klid_user/klid_local_2024) 사용 — 별도 설정 불필요
# 운영(dev/stg/prd): 192.168.102.101:5432 (관제서버팀과 공유, PostgreSQL)
CONTROL_DB_HOST=192.168.102.101
CONTROL_DB_PORT=5432
CONTROL_DB_NAME=klid_system
CONTROL_DB_USERNAME=
CONTROL_DB_PASSWORD=

# 포털 DB (공유) — PostgreSQL
# 로컬 개발: docker postgres 컨테이너, localhost:5432/portal
PORTAL_DB_HOST=
PORTAL_DB_PORT=5432
PORTAL_DB_NAME=portal
PORTAL_DB_USERNAME=
PORTAL_DB_PASSWORD=

# 외부 연동
# 관제/포털 양방향 통합 및 외부 학습데이터 API 는 deprecated — 관련 env 미사용.
DEIDENTIFY_API_URL=
AI_SERVER_URL=http://localhost:9300

# 관제 완료/수정 통지 (D-48) — 단방향 outbound 통지는 유지된다(양방향 M2M 만 deprecated).
#   local 은 목 서버(mock-server :9400)로 실제 전송한다. 네이티브 bootRun 기본값은
#   application-local.yml 의 http://localhost:9400 이며, 아래로 override 할 수 있다.
CONTROL_NOTIFY_ENABLED=true
CONTROL_NOTIFY_URL=http://localhost:9400

# 외부 VLM 시계열 메타 분석 서비스 (Phase 1 — 외부 위탁 전환)
#  - 기본 비활성(VLM_CLIENT_ENABLED=false) — local/dev 영향 0건.
#  - 외부 계약 확정 시 stg/prd 에서 true 로 활성화 + URL/TOKEN 주입.
#  - VLM_ALLOW_INSECURE_URL: 평문 http + 사설 IP URL 완화(local/dev 목업 전용).
#    ★ local/dev 프로파일 밖에서 true 면 기동 실패(fail-closed). stg/prd 는 설정 금지 —
#      미설정(false)이면 HTTPS 전용 + 사설망 차단이 강제된다.
VLM_CLIENT_ENABLED=false
VLM_SERVICE_URL=http://localhost:9400
VLM_SERVICE_TOKEN=
VLM_ALLOW_INSECURE_URL=false

# Phase 2 — 외부 시스템 결과 수신 webhook HMAC 시크릿 (경로별 분리)
#  - 시크릿이 빈 값이면 **애플리케이션 기동 실패**(fail-closed) — 조용한 401 금지 (E-ISSUE-04).
#  - ★ 예시 파일에 실값을 두지 않는다 — 커밋된 기본값은 공개 키라 서명 위조가 가능해진다
#    (DEV_FIX H-1, CWE-1392/798). 아래로 생성해 .env 에 채운다:  openssl rand -hex 32
#  - 32B(256bit) 미만이거나 커밋된 placeholder 값이면 local 외 프로파일에서 기동이 차단된다.
#  - HMAC-SHA256("{timestamp}.{body}", secret) → hex 헤더 X-Signature 와 비교.
#  - timestamp 윈도우 기본 300s (replay 방지).
# (UC018 — 비식별은 KPST 폴링으로 단일화되어 콜백 시크릿 미사용)
#WEBHOOK_HMAC_SECRET_DEIDENTIFY=
# (VLM describe 콜백은 벤더 v2.0.1 무서명 규격 — HMAC 미사용)
#WEBHOOK_HMAC_SECRET_VLM=
WEBHOOK_HMAC_SECRET_AUGMENT=
WEBHOOK_HMAC_TIMESTAMP_WINDOW=300

# webhook 클라이언트 IP 산출 · 무서명 콜백 출처 제한 (DEV_FIX M-3 / N-3 / N-4)
#  ★ 예시 파일에 'none' 을 기본값으로 두지 않는다 — "안전하지 않은 답"을 기본값으로 건네면
#    프록시 뒤 배포에서 그대로 복사돼 자기유발 DoS 로 이어진다(N-3). 값은 배포 형상에 맞게 채운다.
#  - WEBHOOK_TRUSTED_PROXY_CIDRS: 이 대역에서 온 요청의 X-Forwarded-For 만 해석(CWE-348).
#    LB/Nginx 뒤 → 신뢰 대역 CIDR(예: 10.0.0.0/8) / 프록시 없이 직접 노출 → none 명시.
#    운영(prd)은 미설정 시 기동 차단, 형식 오류(오타·호스트명)도 기동 차단.
#  - WEBHOOK_VLM_ALLOWED_IP_CIDRS: VLM 무서명 콜백 3계층 방어의 첫 계층(벤더 송신 대역).
#    미적용을 의도하면 'none'. 운영(prd)은 미설정 시 기동 차단.
WEBHOOK_TRUSTED_PROXY_CIDRS=
WEBHOOK_VLM_ALLOWED_IP_CIDRS=
#  - WEBHOOK_GENAI_ALLOWED_IP_CIDRS: 생성형 AI 무서명 웹훅(/v1/genai/callback) IP allowlist.
#    VLM 과 달리 **미설정이면 전면 차단**(fail-closed). 외부 송신 대역 CIDR 을 CSV 로 지정한다.
WEBHOOK_GENAI_ALLOWED_IP_CIDRS=

# 저장소 경로
STORAGE_RAW_PATH=./storage/raw
STORAGE_DEIDENTIFIED_PATH=./storage/deidentified
# co-locate 산출(Phase 5A) 경로 가드용 고정 allowlist (콤마 구분).
#   dirname(RAW_FILE_PATH_NM) 이 이 목록 하위여야 산출물(비식별 영상·프레임 JPG·JSON)을 쓴다.
#   위반 시 기본 루트로 폴백하지 않고 실패한다(CWE-22 fail-closed).
#   네이티브 로컬 실행은 backend/ 를 작업 디렉터리로 잡으므로 위 두 경로와 같은 상대경로면 된다.
#   ⚠ '/' 등 파일시스템 루트는 가드를 무력화하므로 기동이 차단된다. 운영은 실제 NAS 마운트 서브트리를 지정.
STORAGE_RAW_MOUNT_ROOTS=./storage/raw,./storage/deidentified

# 외부 증강 (생성형 AI) 위탁 — Phase 7-A1, 「생성형 AI API 연동명세서 v1.1」 정합
#  - AUGMENT_EXTERNAL_MODE: http(실제 POST /api/genai/jobs, 공통 기본) | noop(외부 미연동 —
#    dev/stg/prd yml 이 명시) | dev(로컬 자족 콜백 시뮬레이터 — application-local.yml 기본)
#  - AUGMENT_API_BASE_URL: 벤더/목 서버 base URL. http|https 만 허용(그 외 스키마는 기동 차단).
#  - 인증 헤더 없음(명세서·벤더 목 모두 인증 미구현이 확정 계약).
#AUGMENT_EXTERNAL_MODE=http
#AUGMENT_API_BASE_URL=http://localhost:9400
#AUGMENT_API_TIMEOUT_SECONDS=10
#AUGMENT_MAX_INPUT_FILES=100
