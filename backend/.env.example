ENV=local

# ============================================================================
# 백엔드 환경변수 예시 (네이티브 bootRun 용).
#   도커 스택(compose)은 리포지토리 루트의 .env.example 을 사용한다 — 이 파일이 아니다.
#
# ★ dev 프로파일 필수 키 표시 규칙
#   [필수-기동]  미주입 시 부팅 실패 (기본값 없는 ${VAR})
#   [필수-기능]  기동은 되지만 해당 기능이 조용히 죽음 (빈 기본값 — local 기본값을 상속하지 않음)
#   전체 목록·증상·서버 반영 절차: docs/operations/config-key-changes-20260727.md §4-2
# ============================================================================

# ---- 프로파일 ----
# local(자족) / dev(cudo_246, mock-server 실연동) / stg / prd
SPRING_PROFILES_ACTIVE=local

# JWT (관제서버/포털 공통 발급 서버)
# [필수-기동] openssl rand -hex 48 (>= 256bit). local 프로파일만 개발용 기본값 보유.
JWT_SECRET=
JWT_ISSUER=klid-auth
# 개발/검수 전용 토큰 발급 API: POST /api/v1/dev/tokens (활성: !prd, prd 에서 404)

# ---- [필수-기능] 미주입 시 기동은 되지만 기능이 죽는 키 (dev/stg/prd 공통) ----
# 영상 스트림 단기 서명 시크릿(JWT_SECRET 과 분리, >= 32B). 빈 값이면 서명 발급·검증 전면
#   fail-closed → 마킹/라벨링 화면에서 영상이 재생되지 않는다. openssl rand -hex 32
STREAM_SIGN_SECRET=
# 스트림 nonce 쿠키(klid_stream_nonce)에 Secure 속성을 붙일지. 미설정 시 false(기본 OFF).
#   HTTPS 로 서비스되는 배포에서만 true 로 켠다. 평문 HTTP 배포에서 true 면 브라우저가 쿠키를 저장하지
#   않아 서명 검증이 전량 401 → 영상이 재생되지 않는다.
#   ⚠ 빈 값으로 두지 말 것 — 정의된 빈 값은 ${STREAM_COOKIE_SECURE:false} 의 기본값을 무력화한다.
STREAM_COOKIE_SECURE=false
# CORS allowlist. 빈 값이면 브라우저 요청이 전부 403("Invalid CORS request") — FE 전면 차단.
CORS_ALLOWED_ORIGINS=
# 관리자 role-claim 공유 비밀번호 BCrypt 해시(cost >= 12). 빈 값이면 관리자 클레임 불가.
ADMIN_CLAIM_PASSWORD_HASH=

# 관제서버 DB (klid_system 공유) — PostgreSQL
# [필수-기동] dev/stg/prd 는 기본값이 없다(내부 IP 평문 커밋 제거). 미주입 시 부팅 실패.
#   로컬 개발: docker postgres 컨테이너 (klid-postgres), localhost:5432/klid_system
#     기본 자격증명은 application-local.yml 의 fallback 사용 — 별도 설정 불필요
CONTROL_DB_HOST=
CONTROL_DB_PORT=5432
CONTROL_DB_NAME=klid_system
CONTROL_DB_USERNAME=
CONTROL_DB_PASSWORD=

# 포털 DB (공유) — PostgreSQL
# [필수-기동] 위와 동일
# 로컬 개발: docker postgres 컨테이너, localhost:5432/portal

# 외부 연동
# 관제/포털 양방향 통합 및 외부 학습데이터 API 는 deprecated — 관련 env 미사용.
DEIDENTIFY_API_URL=
AI_SERVER_URL=http://localhost:9300

# 관제 완료/수정 통지 (D-48) — 단방향 outbound 통지는 유지된다(양방향 M2M 만 deprecated).
#   local 은 목 서버(mock-server :9400)로 실제 전송한다. 네이티브 bootRun 기본값은
#   application-local.yml 의 http://localhost:9400 이며, 아래로 override 할 수 있다.
CONTROL_NOTIFY_ENABLED=true
CONTROL_NOTIFY_URL=http://localhost:9400

# ---- 비식별(KPST) ----
# ★ 구속 원칙: 본 프로그램이 스스로 결과를 채우는 내부 self-fill 경로는 쓰지 않는다.
#   ★자체 채움(mock) 비식별은 폐지됐다(2026-08-19). 비식별은 항상 외부 위탁이며,
#   로컬도 목 서버(mock-server)를 띄워 실제 HTTP 로 위탁한다.
KPST_DEID_ENABLED=true
KPST_DEID_BASE_URL=http://localhost:9400
# https 주소를 주입하는 경우에만 필요(CWE-295 fail-closed — 미주입 시 부팅 차단)
KPST_DEID_CA_CERT_PATH=

# 외부 VLM 시계열 메타 분석 서비스
#  - 코드가 읽는 키는 vlm.client.url(=VLM_SERVICE_URL). local/dev 는 mock-server 를 가리킨다.
#  - 주소 검증은 스킴(http/https)과 형식만 본다 — 평문 http·사설/내부 호스트가 **모든 환경에서**
#    그대로 통과한다(2026-08-10 확정). https 주소도 그대로 동작한다.
#    ★ 구 완화 플래그 VLM_ALLOW_INSECURE_URL 은 제거됐다(켜든 끄든 결과가 같은 죽은 설정).
#      남아 있어도 읽는 코드가 없으니 되살리지 말 것.
#    ★ 활성/비활성 토글은 폐지됐다 — 미연동 판정은 VLM_SERVICE_URL 주입 여부가 한다.
#      비우면 기동은 정상이고 위탁만 실패한다(조용한 SKIPPED 는 없다).
VLM_SERVICE_URL=http://localhost:9400
VLM_SERVICE_TOKEN=

# 외부 시스템이 결과를 push 할 콜백 수신 base URL (+ /v1/vlm/callback, /v1/genai/callback).
#   도커에서는 반드시 컨테이너에서 도달 가능한 주소여야 한다(http://klid-backend:8080/api).
#   localhost 로 두면 목/외부 서버가 자기 자신에게 POST 해 결과가 전부 유실된다.
WEBHOOK_CALLBACK_BASE_URL=http://localhost:8080/api

# Phase 2 — 외부 시스템 결과 수신 webhook HMAC 시크릿 (경로별 분리)
#  - 시크릿이 빈 값이면 **애플리케이션 기동 실패**(fail-closed) — 조용한 401 금지 (E-ISSUE-04).
#  - ★ 예시 파일에 실값을 두지 않는다 — 커밋된 기본값은 공개 키라 서명 위조가 가능해진다
#    (DEV_FIX H-1, CWE-1392/798). 아래로 생성해 .env 에 채운다:  openssl rand -hex 32
#  - 32B(256bit) 미만이거나 커밋된 placeholder 값이면 local 외 프로파일에서 기동이 차단된다.
#  - HMAC-SHA256("{timestamp}.{body}", secret) → hex 헤더 X-Signature 와 비교.
#  - timestamp 윈도우 기본 300s (replay 방지).
# (UC018 — 비식별은 KPST 폴링으로 단일화되어 콜백 시크릿 미사용)
#WEBHOOK_HMAC_SECRET_DEIDENTIFY=
# (VLM describe 콜백은 벤더 v2.0.1 무서명 규격 — HMAC 미사용)
#WEBHOOK_HMAC_SECRET_VLM=
# [필수-기능] 빈 값이면 증강 콜백이 401 로 거부된다.
WEBHOOK_HMAC_SECRET_AUGMENT=
WEBHOOK_HMAC_TIMESTAMP_WINDOW=300

# webhook 클라이언트 IP 산출 · 무서명 콜백 출처 제한 (DEV_FIX M-3 / N-3 / N-4)
#  ★ 예시 파일에 'none' 을 기본값으로 두지 않는다 — "안전하지 않은 답"을 기본값으로 건네면
#    프록시 뒤 배포에서 그대로 복사돼 자기유발 DoS 로 이어진다(N-3). 값은 배포 형상에 맞게 채운다.
#  - WEBHOOK_TRUSTED_PROXY_CIDRS: 이 대역에서 온 요청의 X-Forwarded-For 만 해석(CWE-348).
#    LB/Nginx 뒤 → 신뢰 대역 CIDR(예: 10.0.0.0/8) / 프록시 없이 직접 노출 → none 명시.
#    운영(prd)은 미설정 시 기동 차단, 형식 오류(오타·호스트명)도 기동 차단.
#  - WEBHOOK_VLM_ALLOWED_IP_CIDRS: VLM 무서명 콜백 3계층 방어의 첫 계층(벤더 송신 대역).
#    미적용을 의도하면 'none'. 운영(prd)은 미설정 시 기동 차단.
WEBHOOK_TRUSTED_PROXY_CIDRS=
WEBHOOK_VLM_ALLOWED_IP_CIDRS=
#  - WEBHOOK_GENAI_ALLOWED_IP_CIDRS: 생성형 AI 무서명 웹훅(/v1/genai/callback) IP allowlist.
#    VLM 과 달리 **미설정이면 전면 차단**(fail-closed). 외부 송신 대역 CIDR 을 CSV 로 지정한다.
#    ★ 빈 값 대입(`KEY=`)으로 두지 않는다 — `${VAR:default}` 는 set-but-empty 면 기본값이 아니라
#      <빈 값>을 쓰므로 프로파일 yml 기본값(local=0.0.0.0/0)이 무력화되고, 증강 위탁이 http 인 형상에서
#      GenAiIntegrationWiringGuard 가 기동을 차단한다. 값을 쓸 때만 주석을 풀어 대역을 채운다.
#WEBHOOK_GENAI_ALLOWED_IP_CIDRS=

# 저장소 경로
STORAGE_RAW_PATH=./storage/raw
STORAGE_DEIDENTIFIED_PATH=./storage/deidentified
# co-locate 산출(Phase 5A) 경로 가드용 고정 allowlist (콤마 구분).
#   dirname(RAW_FILE_PATH_NM) 이 이 목록 하위여야 산출물(비식별 영상·프레임 JPG·JSON)을 쓴다.
#   위반 시 기본 루트로 폴백하지 않고 실패한다(CWE-22 fail-closed).
#   네이티브 로컬 실행은 backend/ 를 작업 디렉터리로 잡으므로 위 두 경로와 같은 상대경로면 된다.
#   ⚠ '/' 등 파일시스템 루트는 가드를 무력화하므로 기동이 차단된다. 운영은 실제 NAS 마운트 서브트리를 지정.
STORAGE_RAW_MOUNT_ROOTS=./storage/raw,./storage/deidentified
# 외부 벤더(생성형 AI) 산출물 <읽기> 전용 허용 루트 — 쓰기 allowlist 와 별개 축.
#   벤더/목이 자기 트리에 쓴 결과 이미지를 읽어 파생 프레임으로 복사할 때만 쓰인다(우리는 쓰지 않는다).
#   미설정이면 읽기 허용 범위 = 쓰기 allowlist 와 동일(fail-closed). docker 스택은 compose 가 /app/genai-out 주입.
STORAGE_EXTERNAL_READ_ROOTS=

# 외부 증강 (생성형 AI) 위탁 — Phase 7-A1, 「생성형 AI API 연동명세서 v1.1」 정합
#  - AUGMENT_EXTERNAL_MODE: http(실제 POST /api/genai/jobs, 공통 기본 · local 도 목서버로 실 위탁)
#    | noop(외부 미연동 — dev/stg/prd yml 이 명시). 이 둘이 전부다 — 구 dev(자족 콜백 시뮬레이터)
#    모드는 Phase 7-A2 에서 제거됐고, 'dev' 를 넣으면 클라이언트 빈 미등록으로 기동이 실패한다.
#  - AUGMENT_API_BASE_URL: 벤더/목 서버 base URL. http|https 만 허용(그 외 스키마는 기동 차단).
#  - 인증 헤더 없음(명세서·벤더 목 모두 인증 미구현이 확정 계약).
#AUGMENT_EXTERNAL_MODE=http
#AUGMENT_API_BASE_URL=http://localhost:9400
#AUGMENT_API_TIMEOUT_SECONDS=10
#AUGMENT_MAX_INPUT_FILES=100

# 증강 파생영상 폐기 유예 · 실삭제 (Phase 7)
#  REVIEWER 가 증강 결과를 반려하면 파생영상에 폐기 표식이 찍히고, 아래 유예가 지나면 배치가
#  DB 행 + 생성 파일을 <영구 삭제>한다. 유예 내에는 POST /v1/augments/{id}/restore 로 복구할 수 있다.
#  ★ AUGMENT_DISCARD_GRACE_DAYS 는 최소 1이며 0/음수·비정상 값이면 <기동이 실패>한다.
#    0 은 "반려 즉시 영구 삭제" 를 뜻해 잘못 누른 반려를 되돌릴 수 없기 때문이다.
#  ★ 값을 <비워두지 말 것> — 빈 값은 ${KEY:default} 의 기본값을 무력화해 조용히 다르게 동작한다.
AUGMENT_DISCARD_ENABLED=true
AUGMENT_DISCARD_GRACE_DAYS=7
AUGMENT_DISCARD_INTERVAL_MS=3600000
AUGMENT_DISCARD_INITIAL_DELAY_MS=600000
AUGMENT_DISCARD_BATCH_SIZE=50
AUGMENT_DISCARD_CLAIM_STALE_MINUTES=60
#  파일 정리 재시도 상한(회). DB 는 지웠는데 파일 삭제가 실패한 비석을 몇 번까지 자동 재시도할지.
#  초과하면 재시도 큐에서 빼고(데드레터) 사람이 수동 정리한다 — 최소 1(0 이하는 기동 실패).
#  ★ AUGMENT_DISCARD_INTERVAL_MS 와 곱한 값이 <자동 복구를 포기하기까지의 시간>이다
#    (기본 1h × 5회 = 5시간). NAS 장애가 그보다 길 수 있으면 이 값을 올릴 것.
AUGMENT_DISCARD_FILE_CLEANUP_MAX_ATTEMPTS=5

# 「처리 중」 고착 회수 스윕 (2026-08-13)
#  재기동/묶음 재수행은 요청 안에서 배치 단계를 PROCESSING 으로 선점하고 실행은 전용 풀로 넘긴다.
#  그 대기 중에 노드가 재시작·재배포되면 큐는 사라지는데 선점 표시는 DB 에 남아, 그 영상은 이후 모든
#  재기동이 409 로 막힌다. 이 스윕이 애플리케이션 안의 유일한 복구 경로다(상태만 되돌리고 자동
#  재시도하지 않는다 — 사람이 다시 누른다).
#  ★ BATCH_STUCK_RECLAIM_TIMEOUT_MINUTES 는 최소 60 이며 그 미만·0·음수·비정상 값이면 <기동이 실패>한다.
#    임계가 짧으면 <정상 실행 중인> 파이프라인의 선점을 회수해 같은 영상이 두 번 실행되고
#    외부 위탁이 중복으로 나간다. 판정은 「선점 시각」과 「배치 진행 로그 마지막 갱신」 중 더 나중이
#    이 시간을 넘겼는가이므로, 큐 대기 + 가장 긴 단일 단계(오토라벨: 프레임마다 ai 추론)보다 커야 한다.
#    ★ 그 단계의 소요는 <호출당 타임아웃>이 아니라 <프레임 수 x 호출 시간>이고 프레임 수 상한은 코드에
#      없다. 호출당 타임아웃만 보고 "최장 단계가 1분 남짓"으로 읽어 값을 내리지 말 것 — 프레임이 수천
#      장이면 그 단계 하나가 몇 시간이 될 수 있다.
#    ★ 값을 낮춰서 얻는 것은 <회수가 빨라지는 것>뿐이고, 잃는 것은 <살아 있는 선점을 뺏지 않는다는
#      보장>이다. 하한 60 은 바닥일 뿐 안전한 값이라는 뜻이 아니다. 조정은 올리는 방향만 권장한다.
#    ★ 판정은 서로 다른 노드가 기록한 시각을 비교하므로 <노드 간 시계 동기(NTP)>를 전제한다.
#      시계가 어긋나면 임계가 그만큼 밀린다(앞선 노드는 일찍 뺏고, 뒤처진 노드는 늦게 회수한다).
#  ★ 기본값(1440분=24시간)은 크게 잡았다 — 살아 있는 선점을 뺏지 않는 것이 회수 지연보다 중요하기
#    때문이다. 잘못 회수하면 완주 영상이 실패로 강등돼 사람이 손댄 보간 라벨이 파괴되지만, 늦게
#    회수해도 결과는 복구가 늦어질 뿐이다(대가: 실제로 고착된 영상도 최대 24시간은 재기동이 막힌
#    채 방치된다). 운영에서 필요하면 이 값을 조정한다.
#  ★ 값을 <비워두지 말 것> — 빈 값은 ${KEY:default} 의 기본값을 무력화해 조용히 다르게 동작한다.
#  ⚠ 남는 위험(인지·수용 — 이 스윕이 만든 결함이 아니라 기존 진입 가드의 한계): 회수 직후 다른 주체가
#    같은 영상을 선점하면 큐에서 뒤늦게 깨어난 옛 작업이 소유권 확인 없이 병행 실행될 수 있고, 판정과
#    조건부 UPDATE 사이의 좁은 창에 갓 접수된 정상 선점을 뺏을 수 있다. 닫으려면 선점 소유권 토큰이라는
#    별도 설계가 필요하며, 기본 임계가 24시간이라 도달 가능성이 매우 낮아 수용한다.
BATCH_STUCK_RECLAIM_ENABLED=true
BATCH_STUCK_RECLAIM_INTERVAL_MS=900000
BATCH_STUCK_RECLAIM_INITIAL_DELAY_MS=600000
BATCH_STUCK_RECLAIM_TIMEOUT_MINUTES=1440
BATCH_STUCK_RECLAIM_BATCH_SIZE=50
