{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/secret-filter.sh",
            "timeout": 5000
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/config-guard.sh",
            "timeout": 5000
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/structure-change-detect.sh",
            "timeout": 5000
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/output-secret-filter.sh",
            "timeout": 5000
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/memory-sync.sh",
            "timeout": 5000
          }
        ]
      },
      {
        "matcher": "Bash|Write|Edit|NotebookEdit|Task|SendMessage|TaskCreate|TaskUpdate|EnterPlanMode|ExitPlanMode|Skill",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/work-tracker-tool.sh",
            "timeout": 5000
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/work-tracker-prompt.sh",
            "timeout": 3000
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/forge-update-check.sh",
            "timeout": 5000
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/context-sync-suggest.sh",
            "timeout": 5000
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/work-tracker-stop.sh",
            "timeout": 5000
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/session-wrap-suggest.sh",
            "timeout": 5000
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/pre-compact-guard.sh",
            "timeout": 5000
          }
        ]
      }
    ],
    "PermissionDenied": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/permission-denied-logger.sh",
            "timeout": 3000
          }
        ]
      }
    ],
    "TaskCreated": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/task-created-logger.sh",
            "timeout": 3000
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Bash(curl *)*",
      "Bash(wget *)*",
      "Bash(nc *)*",
      "Bash(ncat *)*",
      "Bash(ssh *)*",
      "Bash(scp *)*",
      "Bash(*curl*|*)*",
      "Bash(*wget*|*)*",
      "Bash(/usr/bin/curl*)*",
      "Bash(/usr/bin/wget*)*",
      "Bash(kill -9 *)*",
      "Bash(killall *)*",
      "Bash(pkill -9 *)*",
      "Bash(iptables *)*",
      "Bash(ufw *)*",
      "Bash(ssh-keygen *)*",
      "Bash(ssh-copy-id *)*",
      "Bash(docker rm -f *)*",
      "Bash(docker rmi -f *)*",
      "Bash(docker volume rm *)*",
      "Bash(docker network rm *)*",
      "Bash(systemctl stop *)*",
      "Bash(systemctl disable *)*",
      "Bash(launchctl unload *)*",
      "Bash(crontab -r)*",
      "Bash(passwd *)*",
      "Bash(useradd *)*",
      "Bash(userdel *)*",
      "Bash(chown -R *)*"
    ]
  }
}
