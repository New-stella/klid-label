{
  "item": {
    "id": "API-075",
    "project_id": "4ece2c3f-8e99-46f5-9580-71108a76e578",
    "type": "api_endpoint",
    "title": "GET /v1/tasks/{rawSn}/labels",
    "slug": "get-v1tasksrawsnlabels",
    "sub_id": null,
    "status": "draft",
    "data": {
      "path": "/v1/tasks/{rawSn}/labels",
      "tags": [
        "controlnotify",
        "task"
      ],
      "method": "GET",
      "summary": "작업 라벨 조회 (관제 inbound)",
      "security": [
        {
          "jwt": [
            "REVIEWER",
            "WORKER"
          ]
        }
      ],
      "triggers": [],
      "responses": {
        "200": {
          "schema": {
            "type": "object",
            "properties": {
              "data": {
                "type": "object",
                "properties": {
                  "size": {
                    "type": "integer",
                    "description": "한 페이지에 담긴 프레임 수. 지정하지 않으면 20 이고 상한은 100 이다."
                  },
                  "number": {
                    "type": "integer",
                    "description": "현재 페이지 번호. 0 부터 시작한다."
                  },
                  "content": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "srcSn": {
                          "type": "integer",
                          "format": "int64",
                          "description": "프레임 PK (SRC_SN)"
                        },
                        "labels": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "label": {
                                "type": "string",
                                "description": "라벨명 (클래스)"
                              },
                              "lblSn": {
                                "type": "integer",
                                "format": "int64",
                                "description": "라벨 PK"
                              },
                              "points": {
                                "type": "string",
                                "description": "좌표 JSON 문자열"
                              },
                              "lblTypeCd": {
                                "type": "string",
                                "description": "라벨 유형 코드 (예: BBOX, POLYGON)"
                              }
                            }
                          },
                          "description": "해당 프레임의 라벨 목록"
                        },
                        "frameNo": {
                          "type": "integer",
                          "description": "프레임 번호"
                        }
                      }
                    },
                    "description": "이 페이지에 담긴 프레임 단위 라벨 목록. 프레임 번호 오름차순으로 정렬된다."
                  },
                  "totalPages": {
                    "type": "integer",
                    "description": "전체 페이지 수."
                  },
                  "totalElements": {
                    "type": "integer",
                    "format": "int64",
                    "description": "필터를 적용한 전체 프레임 건수. 폐기된 프레임은 세지 않는다."
                  }
                },
                "description": "프레임 단위 라벨 목록 페이지. 배열이 아니라 페이지 객체다."
              },
              "message": {
                "type": "string",
                "nullable": true,
                "description": "응답 메시지 (성공 시 null)"
              },
              "success": {
                "type": "boolean",
                "description": "성공 여부 (성공 시 true)"
              },
              "errorCode": {
                "type": "string",
                "nullable": true,
                "description": "에러 코드 (성공 시 null)"
              }
            }
          },
          "example": {
            "data": {
              "size": 20,
              "number": 0,
              "content": [
                {
                  "srcSn": 70001,
                  "labels": [
                    {
                      "label": "person",
                      "lblSn": 90001,
                      "points": "[[120,80],[260,420]]",
                      "lblTypeCd": "BBOX"
                    }
                  ],
                  "frameNo": 1
                }
              ],
              "totalPages": 1,
              "totalElements": 1
            },
            "message": null,
            "success": true,
            "errorCode": null
          },
          "description": "조회 성공. ApiResponse 래퍼의 data 에는 배열이 아니라 페이지 객체가 담긴다 — 프레임 단위 라벨 목록을 content 에 싣고 number·size·totalElements·totalPages 를 함께 준다.\n\n[배열이 아닌 이유] 한 영상의 프레임 수에 상한이 없어 전건을 한 번에 돌려주면 요청 하나가 그만큼 자원을 쓴다. 목록 조회에 페이징을 두는 규약을 따르므로 무제한 조회를 열지 않는다. 지정하지 않으면 20 건이고, 상한 100 을 넘겨 요청해도 100 으로 줄여 응답한다.\n\n정렬은 프레임 번호 오름차순 고정이다. frameIds 로 조회 범위를 좁힐 수 있고, 그 필터는 페이징보다 먼저 적용된다. 폐기된 프레임은 content 에도 totalElements 에도 들어가지 않는다. 라벨 본문에 파일 경로는 담지 않는다(CWE-359).",
          "content_type": "application/json"
        },
        "400": {
          "schema": {
            "type": "object",
            "properties": {
              "data": {
                "type": "object",
                "nullable": true,
                "description": "에러 시 null"
              },
              "message": {
                "type": "string",
                "description": "사용자 메시지"
              },
              "success": {
                "type": "boolean",
                "description": "성공 여부 (에러 시 false)"
              },
              "errorCode": {
                "type": "string",
                "description": "ErrorCode enum name"
              }
            }
          },
          "example": {
            "data": null,
            "message": "frameIds 는 최대 100개까지 지정할 수 있습니다.",
            "success": false,
            "errorCode": "INVALID_INPUT"
          },
          "description": "frameIds 를 상한인 100 개보다 많이 지정해 거부. ErrorCode=INVALID_INPUT. 페이지 크기는 여기에 해당하지 않는다 — size 는 상한을 넘겨도 거부하지 않고 100 으로 줄여 응답한다.",
          "content_type": "application/json"
        },
        "401": {
          "schema": {
            "type": "object",
            "properties": {
              "data": {
                "type": "object",
                "nullable": true,
