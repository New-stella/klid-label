                  },
                  "evntTypeCd": {
                    "type": "string",
                    "nullable": true,
                    "maxLength": 20,
                    "description": "연결할 이벤트 유형 코드. 종류가 이벤트 유형일 때만 채운다."
                  },
                  "externalCode": {
                    "type": "string",
                    "maxLength": 100,
                    "description": "외부 산출물이 준 분류 식별 문자열."
                  },
                  "externalName": {
                    "type": "string",
                    "nullable": true,
                    "maxLength": 200,
                    "description": "외부 산출물이 준 표시 이름. 나중에 어떤 근거로 연결했는지 되짚는 데 쓴다."
                  }
                }
              },
              "description": "확정할 대응 목록."
            },
