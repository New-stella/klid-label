          "brownfield": {
            "notes": "고도화 신규 — 외부 비식별 솔루션 연동 처리이력(수동 블러 폐기)",
            "status": "new",
            "legacy_source": {
              "type": "table",
              "legacy_dbms": "MariaDB"
