                "흐림",
                "비",
                "눈",
                "안개"
              ],
              "type": "string",
              "example": "맑음",
              "nullable": true,
              "maxLength": 20,
              "description": "날씨. null이면 수동값 삭제(파생 프리필로 폴백)"
            },
            "timeOfDay": {
              "enum": [
                "DAY",
                "NGT"
              ],
              "type": "string",
              "example": "DAY",
              "nullable": true,
              "maxLength": 20,
              "description": "시간대 코드. null이면 수동값 삭제"
            }
          }
        },
        "required": true,
        "content_type": "application/json"
      },
