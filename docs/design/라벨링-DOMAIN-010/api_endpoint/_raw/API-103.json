                      "description": "등록 일시"
                    },
                    "srcSn": {
                      "type": "integer",
                      "format": "int64",
                      "nullable": true,
                      "description": "프레임 참조 (LS_DATA_SRC.SRC_SN, nullable)"
                    },
                    "reason": {
                      "type": "string",
                      "description": "사유 (ISSUE_RSN)"
                    },
                    "issueSn": {
                      "type": "integer",
                      "format": "int64",
                      "description": "이슈 PK (DATA_ISSUE_SN)"
                    },
                    "comments": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "regDt": {
                            "type": "string",
                            "format": "date-time",
                            "description": "댓글 등록 일시"
                          },
