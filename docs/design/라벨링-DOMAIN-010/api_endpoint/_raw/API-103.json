                        "INQUIRY"
                      ],
                      "type": "string",
                      "description": "이슈 유형 (반려 이력/문의)"
                    },
                    "reportedUserNo": {
                      "type": "string",
                      "nullable": true,
                      "description": "작성/대상 사번 (내부 도구 전용 노출)"
                    },
                    "reportedUserName": {
                      "type": "string",
                      "nullable": true,
                      "description": "작성/대상 사용자 이름. 사용자 마스터에 없거나 사번이 숫자가 아니면 null (화면은 사번으로 폴백한다)"
                    },
                    "reportedUserRoleCd": {
                      "type": "string",
                      "nullable": true,
                      "description": "작성/대상 사용자의 역할 코드. 값 공간은 댓글의 authorRoleCd 와 같다. 역할을 해석할 수 없으면(역할 매핑에 없는 사번·숫자가 아닌 사번·사번 없음) null 이며 지어내지 않는다 — 화면은 역할 없이 이름만 보여 준다. 댓글과 해석 시점이 다르다: 댓글은 작성 당시의 역할이 저장돼 있어 그대로 돌려주지만, 스레드에는 그 저장 축이 없어 조회 시점의 현재 역할을 사용자 역할 매핑에서 읽는다. 따라서 등록 후 역할이 바뀐 사용자는 새 역할로 나간다. 스레드에 저장 축을 두지 않은 것은 이미 쌓인 행에 채워 넣을 근거가 없어 그 값이 전부 비게 되기 때문이다. 사번을 모아 한 번에 해석하므로 스레드 수만큼 조회가 늘지 않는다."
                    }
                  }
                },
                "description": "이슈 스레드 목록 (REG_DT 오름차순, 반려+문의 통합)"
              },
