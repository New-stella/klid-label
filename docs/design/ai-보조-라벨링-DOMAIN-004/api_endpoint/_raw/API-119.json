                  "properties": {
                    "label": {
                      "type": "string",
                      "description": "클래스 라벨"
                    },
                    "score": {
                      "type": "number",
                      "format": "float",
                      "maximum": 1,
                      "minimum": 0,
                      "description": "신뢰도"
                    },
                    "points": {
                      "type": "array",
                      "items": {
                        "type": "number",
                        "format": "float"
                      },
                      "maxItems": 4,
                      "minItems": 4,
                      "description": "[x1, y1, x2, y2]"
                    },
                    "track_id": {
                      "type": "integer",
                      "nullable": true,
                      "description": "트래커 부여 객체 ID. 저신뢰 detection은 null 가능"
                    }
                  }
                }
              },
              "mock_reason": {
                "type": "string",
                "nullable": true,
