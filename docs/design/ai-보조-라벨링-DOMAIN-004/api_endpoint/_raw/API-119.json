      ],
      "method": "POST",
      "summary": "YOLO 객체 트래킹 추론 (ai-server)",
      "security": [],
      "triggers": [],
      "responses": {
        "200": {
          "schema": {
            "type": "object",
            "required": [
              "detections"
            ],
            "properties": {
              "mock": {
                "type": "boolean",
                "default": false
              },
              "source": {
                "type": "string",
                "default": "model",
                "description": "mock | model"
              },
              "detections": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "label",
