                        },
                        "failRsnCn": {
                          "type": "string",
                          "nullable": true,
                          "description": "실패 사유(FAILED 상태에서만)"
                        },
                        "uldSttsCd": {
                          "enum": [
                            "UPLOADED",
                            "PROCESSING",
                            "READY",
                            "FAILED"
                          ],
                          "type": "string",
                          "description": "처리 상태"
                        },
                        "uldTypeCd": {
                          "enum": [
                            "IMAGE",
                            "VIDEO"
                          ],
                          "type": "string",
                          "description": "자산 유형"
                        },
                        "mimeTypeNm": {
                          "type": "string",
                          "nullable": true,
                          "description": "확정 MIME 타입"
                        },
                        "orgnlFileNm": {
                          "type": "string",
                          "nullable": true,
                          "description": "원본 파일명(표시용)"
                        }
                      }
                    },
                    "description": "자산 목록(1페이지)"
                  },
                  "totalPages": {
                    "type": "integer",
                    "format": "int32",
                    "description": "총 페이지 수"
                  },
                  "totalElements": {
                    "type": "integer",
                    "format": "int64",
                    "description": "본인 자산 총 건수"
