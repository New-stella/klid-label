    "sub_id": null,
    "status": "draft",
    "data": {
      "dbms": "postgresql",
      "level": "physical",
      "tables": [
        {
          "name": "LS_META_REPL_OUTBOX",
          "columns": [
            {
              "name": "OUTBOX_SN",
              "type": "bigint",
              "unique": false,
              "nullable": false,
              "description": "발신함 항목 PK. GENERATED BY DEFAULT AS IDENTITY(자동 증가).",
              "primary_key": true,
              "logical_column_name": "발신함일련번호"
            },
            {
              "name": "RAW_SN",
              "type": "bigint",
              "unique": false,
              "nullable": false,
              "references": {
                "table": "LS_DATA_RAW",
                "column": "RAW_SN",
                "on_delete": "cascade"
              },
              "description": "복제 대상 영상 단위 식별자(LS_DATA_RAW.RAW_SN). 멱등키 (RAW_SN, SNPSHT_HASH) 의 구성 컬럼이다.",
              "primary_key": false,
              "logical_column_name": "원시영상일련번호"
            },
            {
              "name": "SNPSHT_HASH",
              "type": "varchar(64)",
              "unique": false,
              "nullable": false,
              "description": "복제 대상 메타 스냅샷의 해시. RAW_SN 과 함께 멱등키를 이뤄, 같은 스냅샷이 재전송돼도 포털 upsert 가 중복되지 않게 한다.",
              "primary_key": false,
              "logical_column_name": "스냅샷해시"
            },
            {
              "name": "PAYLOAD_CN",
              "type": "text",
              "unique": false,
              "nullable": true,
              "description": "포털로 push 할 메타 스냅샷 직렬화 본문.",
              "primary_key": false,
              "logical_column_name": "페이로드내용"
            },
            {
              "name": "STTS_CD",
              "type": "varchar(16)",
              "unique": false,
              "default": "PENDING",
              "nullable": false,
              "code_values": {
                "DEAD": "재시도 초과 사장(dead-letter)",
                "DONE": "복제 완료",
                "PENDING": "복제 대기"
              },
              "description": "복제 처리 상태. 기본값 PENDING. IDX_LS_META_REPL_OUTBOX_STATUS 인덱스의 선두 컬럼이다.",
              "primary_key": false,
              "logical_column_name": "처리상태코드"
            },
            {
              "name": "RTRY_NMTM",
              "type": "integer",
              "unique": false,
              "default": "0",
              "nullable": false,
              "description": "복제 재시도 횟수. 기본값 0. 상한을 넘기면 DEAD 로 격리한다.",
              "primary_key": false,
              "logical_column_name": "재시도횟수"
            },
            {
              "name": "REG_DT",
              "type": "timestamp",
              "unique": false,
              "default": "CURRENT_TIMESTAMP",
              "nullable": false,
              "description": "발신함 적재 일시. 기본값 CURRENT_TIMESTAMP. IDX_LS_META_REPL_OUTBOX_STATUS 의 두 번째 컬럼으로 폴링 순서를 정한다.",
              "primary_key": false,
              "logical_column_name": "등록일시"
            },
            {
              "name": "PRCS_DT",
              "type": "timestamp",
              "unique": false,
              "nullable": true,
              "description": "복제 처리 완료 일시. 아직 처리되지 않은(PENDING) 행은 NULL 이다.",
              "primary_key": false,
              "logical_column_name": "처리일시"
            }
          ],
          "indexes": [
            {
              "name": "IDX_LS_META_REPL_OUTBOX_STATUS",
              "unique": false,
              "columns": [
                "STTS_CD",
                "REG_DT"
              ]
            }
          ],
          "brownfield": {
            "notes": "고도화 신규 — 동결 메타의 포털 단방향 복제 발신함",
            "status": "new"
          },
          "description": "동결된 영상 메타를 포털로 단방향 복제하기 위한 발신 대기 원장. 처리 상태와 재시도 횟수로 미발신분을 회수한다. 승인 영상 1건당 1행이 적재된다.",
          "logical_table_name": "메타복제발신함"
        }
      ],
      "brownfield": {
        "notes": "고도화 신규 — 동결 메타의 포털 단방향 복제 발신함",
        "status": "new"
      },
      "description": "동결된 영상 메타 스냅샷(LS_DATASET_VIDEO_META)을 물리 분리된 포털 DB 로 at-least-once 단방향 복제하기 위한 발신함(outbox) 물리 ERD. 검수 승인(APPROVED) 트랜잭션에서 스냅샷과 함께 원자적으로 커밋되고, 별도 워커가 PENDING 행을 폴링해 포털로 push 한 뒤 DONE 으로 마감한다. 멱등키가 (RAW_SN, SNPSHT_HASH) 조합이라 포털 upsert 가 중복돼도 무해하다(재시도 안전).",
      "relationships": [
        {
