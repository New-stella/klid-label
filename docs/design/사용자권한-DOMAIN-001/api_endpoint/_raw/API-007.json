      "brownfield": {
        "status": "new",
        "decided_by": "ADR-012",
        "change_kind": [
          "redesign"
        ],
        "diff_summary": "2차 role+channel 클레임 분기 (관제/포털 단일 검증 로직) — 1차 GPKI 인증서 기반 로그인에는 없던 2차 전용 자가부여 온보딩 API"
      },
      "deprecated": false,
      "parameters": [],
      "description": "인증됐으나 role 클레임이 없는 사용자가 관리자 공유 패스워드와 함께 본인에게 WORKER 또는 REVIEWER 역할을 자가 부여하고 새 access token 을 즉시 발급받는 온보딩 API다. '관제/포털 채널 분기'가 아니라 단일 전제(actor.channel==INTERNAL && actor.role==null) 충족 여부로 승인·거절을 가른다 — 요청 role 이 PORTAL_USER 면 400, 그 전제를 벗어나면(PORTAL 채널 사용자 포함, 또는 이미 role 을 보유한 사용자) 409 로 거절한다. 관리자 패스워드는 BCrypt 상수시간 비교로 검증하고, 시도 횟수는 계정 축 + 엔드포인트 전역 축으로 제한한다(429). security 표에 나열된 REVIEWER/WORKER/PORTAL_USER 는 성공 조건이 아니라 정반대다 — 이 중 하나라도 이미 보유한 인증 사용자는 모두 409 로 거절된다. 이 API 를 성공적으로 호출할 수 있는 유일한 대상은 아직 아무 역할도 보유하지 않은(내부 채널, role 미배정) 사용자뿐이다.",
      "request_body": {
        "schema": {
          "type": "object",
          "required": [
            "role",
            "adminPassword"
          ],
          "properties": {
            "role": {
              "enum": [
                "REVIEWER",
                "WORKER",
                "PORTAL_USER"
              ],
              "type": "string",
              "description": "자가부여할 역할. PORTAL_USER 는 형식상 허용되나 항상 400 으로 거절된다(화이트리스트는 WORKER/REVIEWER 뿐)."
            },
            "userId": {
              "type": "string",
              "nullable": true,
              "description": "표시용 사용자 ID — 상위 시스템(관제서버)이 세션 인계 시 localStorage 로 전달한 값(있는 경우만). 사용자 마스터 자동등록에 쓰인다(ADR-043)."
            },
            "userNm": {
              "type": "string",
              "nullable": true,
              "description": "표시용 사용자 이름 — userId 와 동일 출처·용도"
            },
            "adminPassword": {
              "type": "string",
              "description": "관리자 공유 패스워드(BCrypt 상수시간 비교로 검증)"
            }
          }
        },
        "example": {
          "role": "REVIEWER",
          "userId": "1001",
          "userNm": "김검수",
          "adminPassword": "********"
        },
        "required": true,
        "content_type": "application/json"
      },
