      "responses": {
        "200": {
          "schema": {
            "type": "object",
            "properties": {
              "data": {
                "type": "object",
                "properties": {
                  "url": {
                    "type": "string",
                    "description": "서명 포함 상대 URL (/api/v1/videos/{rawSn}/stream?exp=...&sig=...)"
                  },
                  "expiresAt": {
                    "type": "integer",
                    "format": "int64",
                    "description": "만료 epoch-second"
                  },
                  "ttlSeconds": {
                    "type": "integer",
                    "format": "int64",
                    "description": "발급 TTL(초) — FE가 만료 직전 재발급 판단에 사용"
                  }
                }
              },
              "message": {
                "type": "string",
                "nullable": true
              },
              "success": {
                "type": "boolean"
              },
              "errorCode": {
                "type": "string",
                "nullable": true
              }
            }
          },
          "example": {
            "data": {
              "url": "/api/v1/videos/279/stream?exp=1783400000&sig=ab12cd34",
              "expiresAt": 1783400000,
              "ttlSeconds": 120
            },
            "message": null,
            "success": true,
            "errorCode": null
          },
          "description": "성공 — 서명 URL + 만료시각. ApiResponse 래퍼. 이때 서명 URL 과 함께 nonce 쿠키 klid_stream_nonce 를 Set-Cookie 로 발급한다. 이 쿠키는 서명 검증의 필수 입력이며 브라우저가 스트림 요청에 자동으로 실어 보낸다. 값은 발급 대상 사용자에 바인딩되어 봉인된 형태이고, 서명 입력에 쓰이는 원본 nonce 는 URL 에도 응답 본문에도 실리지 않는다. 속성은 HttpOnly, SameSite=Lax, Max-Age 3600초이며 Path 는 스트림 경로로 한정한다. Secure 는 배포 설정으로 결정하며 기본은 부여하지 않는다. 요청에 이미 유효한 nonce 쿠키가 있으면 그대로 재사용하고, 없거나 봉인 검증에 실패하면 새로 발급한다.",
          "content_type": "application/json"
        },
        "401": {
