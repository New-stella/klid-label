      "deprecated": false,
      "parameters": [
        {
          "in": "path",
          "name": "rawSn",
          "schema": {
            "type": "integer"
          },
          "required": true,
          "description": "영상 식별자 RAW_SN"
        }
      ],
      "description": "영상에 이벤트 시점 마킹을 생성한다. 자동 모드는 프레임 간격으로 마킹 지점을 산출하고, 수동 모드는 요청에 담긴 마킹 지점 배열을 그대로 저장한다.\n\n[사전 조건] 대상 영상의 배치 단계가 마킹 대기이고 비식별이 완료돼 있어야 한다. 작업자는 본인에게 배정된 영상만, 검수자는 전체 영상에 접근한다. 같은 영상에 활성 마킹이 이미 있으면 거부한다.\n\n[응답의 배치 트리거 결과] 마킹 저장이 성공하면 마킹 완료 이벤트가 트랜잭션 커밋 이후 잔여 배치(시계열 위탁 → 프레임 추출 → 오토라벨링 → 트랙 보간)를 비동기로 시작한다. 응답의 batchTriggered 는 그 시작이 실제로 개시됐는지를, batchSkipReason 은 개시되지 않았을 때의 사유를 알린다 — 영상을 찾지 못함 · 이미 처리 중이거나 처리가 끝난 영상 · 비식별이 완료되지 않은 영상 · 이미 다른 경로로 큐잉된 영상이 그에 해당한다. 배치가 개시되지 않으면 그 마킹은 종결 처리되며, 배치 개시 여부는 마킹 저장의 성공 여부를 바꾸지 않는다. 두 필드는 선택값이라 판정이 이뤄지지 않은 경로에서는 비어 있다(기존 소비자 하위호환).",
      "request_body": {
        "schema": {
          "type": "object",
          "required": [
            "mode"
          ],
          "properties": {
            "mode": {
              "enum": [
                "AUTO",
                "MANUAL"
              ],
              "type": "string",
              "description": "마킹 모드. AUTO=자동(프레임 간격 기반), MANUAL=수동(마킹 지점 배열). 허용값은 AUTO/MANUAL 뿐이며 그 외 값은 400."
            },
            "marks": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "frameIndex"
                ],
                "properties": {
                  "timestamp": {
                    "type": "string",
                    "pattern": "^\\d{1,4}:[0-5]\\d(:\\d{1,3})?$",
                    "nullable": true,
                    "description": "표시용 타임스탬프(mm:ss 또는 mm:ss:ff). 선택값."
                  },
                  "frameIndex": {
                    "type": "integer",
                    "minimum": 0,
                    "description": "마킹 프레임 인덱스(0-base, 필수)"
                  }
                }
              },
              "maxItems": 20000,
              "nullable": true,
              "description": "수동 마킹 지점 배열. mode=MANUAL 일 때 비어있지 않아야 한다(미충족 시 400). 원소 상한은 과대 요청 방어용 20000건."
            },
            "intervalFrames": {
              "type": "integer",
              "nullable": true,
              "description": "자동 마킹의 프레임 간격. mode=AUTO 일 때 1 이상 필수(미충족 시 400), mode=MANUAL 일 때는 사용되지 않는다."
            }
          }
        },
        "example": {
          "mode": "MANUAL",
          "marks": [
            {
              "timestamp": "00:12",
              "frameIndex": 300
            }
          ],
          "intervalFrames": null
        },
        "required": true,
        "content_type": "application/json"
      },
