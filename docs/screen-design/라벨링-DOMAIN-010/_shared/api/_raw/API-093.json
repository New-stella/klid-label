      "parameters": [
        {
          "in": "path",
          "name": "srcSn",
          "schema": {
            "type": "integer",
            "format": "int64"
          },
          "required": true,
          "description": "대상 프레임 PK (SRC_SN). 요청 body의 srcSn과 일치해야 함"
        }
      ],
      "description": "사용자가 캔버스에서 클릭(포인트) 또는 드래그(박스)로 객체를 지목하면 추론 서버의 분할 경로로 프록시해 폴리곤과 신뢰도를 받는다.\n\npoints 와 box 는 정확히 하나만 제공해야 하며 둘 다 보내거나 둘 다 없으면 400 이다.\n\n분할은 정책상 원본 프레임 이미지에만 실행하고 비식별본은 좌표를 공유한다. 응답 폴리곤은 이미지 실측 해상도 상한까지 좌표를 검증한 뒤(CWE-20) 단순화한다. 목업 응답은 화면이 자동 적용하지 않는다.\n\n서버는 상태 없는 프록시라 DB 에 저장하지 않는다 — 저장은 라벨 임시저장 흐름이 담당한다. 보안: 작업자는 본인 배정 프레임만(CWE-639), 경로순회 차단(CWE-22), 이미지 크기 상한 20MB(초과 시 413).\n\n화면에서는 AI 분할 도구(단축키 G)로 쓴다.",
      "request_body": {
        "schema": {
          "type": "object",
          "required": [
            "srcSn"
          ],
          "properties": {
            "box": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "maxItems": 4,
              "minItems": 4,
              "description": "박스 좌표 [x1,y1,x2,y2]. 박스 프롬프트일 때만 사용. points와 배타 — 정확히 하나만 제공"
            },
            "srcSn": {
              "type": "integer",
              "format": "int64",
              "description": "대상 프레임 PK. path 변수와 일치해야 함"
            },
            "points": {
              "type": "array",
              "items": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "maxItems": 2,
                "minItems": 2
              },
              "maxItems": 100,
              "description": "클릭 좌표 [[x,y], ...]. 클릭 프롬프트일 때만 사용 (최대 100개). box와 배타 — 정확히 하나만 제공"
            }
          }
        },
        "required": true,
        "content_type": "application/json"
      },
