                          "nullable": true,
                          "description": "같은 객체를 프레임 사이에서 잇는 추적 식별자"
                        },
                        "lblTypeCd": {
                          "enum": [
                            "BBOX",
                            "POLYGON"
                          ],
                          "type": "string",
                          "description": "도형 종류"
