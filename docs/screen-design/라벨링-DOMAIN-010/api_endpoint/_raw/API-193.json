                            "type": "integer",
                            "format": "int32",
                            "description": "고정분(초)"
                          },
                          "perFrameSec": {
                            "type": "integer",
                            "format": "int32",
                            "description": "프레임당 가산분(초)"
                          }
                        },
                        "description": "AI 탐지(오토라벨). 프레임 한 장을 다루므로 프레임당 가산분이 0이다."
                      },
                      "segment": {
                        "type": "object",
                        "properties": {
                          "baseSec": {
                            "type": "integer",
                            "format": "int32",
                            "description": "고정분(초)"
                          },
                          "perFrameSec": {
                            "type": "integer",
                            "format": "int32",
                            "description": "프레임당 가산분(초)"
                          }
                        },
                        "description": "AI 분할. 프레임 한 장을 다루므로 프레임당 가산분이 0이다."
                      },
                      "autoTrack": {
                        "type": "object",
                        "properties": {
                          "baseSec": {
                            "type": "integer",
                            "format": "int32",
                            "description": "고정분(초)"
                          },
                          "perFrameSec": {
                            "type": "integer",
                            "format": "int32",
                            "description": "프레임당 가산분(초)"
                          }
                        },
                        "description": "AI 자동 추적. 시작 객체를 고르지 않고 현재 프레임부터 뒤따르는 프레임까지 한 번에 검출·추적하며, 추적과 마찬가지로 프레임마다 추론을 되풀이한다."
                      },
                      "ceilingSec": {
                        "type": "integer",
                        "format": "int32",
                        "description": "계산값의 절대 상한(초). 어떤 종류든 이 값을 넘겨 기다리지 않는다. 넘길 만큼 프레임이 많으면 화면이 한 요청에 싣는 프레임 수를 줄여 나눠 보낸다 — 한 번의 대기가 길어질수록 경로 중간의 더 짧은 상한이 먼저 끊고 그때는 결과가 통째로 버려지기 때문이다."
                      }
                    },
                    "description": "작업 종류별 최대 대기 상한(초). 화면은 «고정분 + 프레임당 가산분 x 그 요청이 싣는 프레임 수»로 그 실행의 대기 상한을 구하고, 그 값에서 요청 제한시간과 편집 잠금 자동 해제 시점을 함께 파생한다. 종류별 저장값이 없으면 그 종류를 생략하며 화면이 자체 기본값으로 대체한다."
                  },
                  "confThreshold": {
                    "type": "integer",
                    "format": "int32",
                    "nullable": true,
                    "description": "인식 민감도 초기값. 값이 클수록 확신도가 높은 객체만 인식한다. 저장값이 없으면 생략된다."
                  },
                  "simplifyTolerance": {
                    "type": "number",
                    "format": "double",
                    "nullable": true,
                    "description": "경계 세밀함 초기값. 값이 작을수록 폴리곤 경계가 원본에 가깝게 세밀해진다. 저장값이 없으면 생략된다."
                  }
                },
                "description": "AI 정밀도 기본값"
              },
              "message": {
                "type": "string",
                "nullable": true,
                "description": "응답 메시지 (성공 시 null)"
