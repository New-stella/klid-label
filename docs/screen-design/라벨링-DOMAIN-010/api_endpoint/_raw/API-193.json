      "responses": {
        "200": {
          "schema": {
            "type": "object",
            "properties": {
              "data": {
                "type": "object",
                "properties": {
                  "maxWait": {
                    "type": "object",
                    "nullable": true,
                    "properties": {
                      "track": {
                        "type": "object",
                        "properties": {
                          "baseSec": {
                            "type": "integer",
                            "format": "int32",
                            "description": "고정분(초) — 시작 프레임 준비·권한 확인·응답 조립처럼 프레임 수와 무관한 몫"
                          },
                          "perFrameSec": {
                            "type": "integer",
                            "format": "int32",
                            "description": "프레임당 가산분(초) — 프레임 한 장을 추론하는 데 서버가 정당하게 쓸 수 있는 최악 소요 이상이어야 한다"
                          }
                        },
                        "description": "AI 추적. 한 요청 안에서 뒤따르는 프레임마다 추론을 되풀이하므로 대기가 프레임 수에 비례한다."
                      },
                      "detect": {
                        "type": "object",
                        "properties": {
