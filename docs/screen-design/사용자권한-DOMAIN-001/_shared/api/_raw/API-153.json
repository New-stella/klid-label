    "sub_id": null,
    "status": "draft",
    "data": {
      "path": "/v1/dev/tokens",
      "tags": [
        "dev",
        "auth"
      ],
      "method": "POST",
      "summary": "테스트 JWT 토큰 발급 (개발/검수 전용)",
      "security": [],
      "triggers": [],
      "responses": {
        "201": {
          "schema": {
            "type": "object",
            "properties": {
              "data": {
                "type": "object",
                "properties": {
                  "token": {
                    "type": "string",
                    "description": "발급된 JWT 토큰(HS256 서명)"
                  },
                  "claims": {
                    "type": "object",
                    "description": "디코드된 페이로드 클레임(디버깅 용도, 서명 정보 미포함)"
                  },
                  "expiresAt": {
                    "type": "integer",
                    "format": "int64",
                    "description": "만료 시각(epoch millis)"
                  },
                  "tokenType": {
                    "type": "string",
                    "description": "토큰 타입(Bearer)"
                  },
                  "authorizationHeader": {
                    "type": "string",
                    "description": "Authorization 헤더 값(복사·붙여넣기 편의용, 'Bearer {token}')"
                  }
                }
              },
              "message": {
                "type": "string",
                "nullable": true,
                "description": "응답 메시지 (성공 시 null)"
              },
              "success": {
                "type": "boolean",
                "description": "성공 여부"
              },
              "errorCode": {
                "type": "string",
                "nullable": true,
                "description": "에러 코드 (성공 시 null)"
              }
            }
          },
          "example": {
            "data": {
              "token": "eyJhbGciOiJIUzI1NiJ9...",
              "claims": {
                "sub": "1001",
                "role": "REVIEWER",
                "channel": "INTERNAL"
              },
              "expiresAt": 1747000000000,
              "tokenType": "Bearer",
              "authorizationHeader": "Bearer eyJhbGciOiJIUzI1NiJ9..."
            },
            "message": null,
            "success": true,
            "errorCode": null
          },
          "description": "토큰 발급 성공(201).",
          "content_type": "application/json"
        },
        "400": {
          "schema": {
            "type": "object",
            "properties": {
              "data": {
                "type": "object",
                "nullable": true,
                "description": "에러 시 null"
              },
              "message": {
                "type": "string",
                "description": "사용자 메시지"
              },
              "success": {
                "type": "boolean",
                "description": "성공 여부 (에러 시 false)"
              },
              "errorCode": {
                "type": "string",
                "description": "ErrorCode enum name"
              }
            }
          },
          "example": {
            "data": null,
            "message": "role-channel 조합이 올바르지 않습니다.",
            "success": false,
            "errorCode": "INVALID_INPUT"
          },
          "description": "role-channel 불일치 / expSeconds 범위 초과(60~86400). ErrorCode=INVALID_INPUT",
          "content_type": "application/json"
        }
      },
      "brownfield": {
        "status": "new",
        "decided_by": "ADR-039",
        "change_kind": [
          "capability-add"
        ],
        "diff_summary": "dev 전용 테스트 JWT 발급 — 2차 신설. authoring.dev.login.enabled 토글 기본 true(local/dev/stg)"
      },
      "deprecated": false,
      "parameters": [],
      "description": "authoring.dev.login.enabled=true(환경변수 DEV_LOGIN_ENABLED) 일 때만 엔드포인트가 노출된다. 미설정이거나 false 면 프로파일과 무관하게 존재하지 않아 404 가 된다(fail-closed). local/dev 프로파일은 기본값이 true 다. stg/prd(운영 계열)는 기본값이 false 이며, 그 값을 뒤집어 켠 채 기동을 시도하면 부팅 자체를 거부한다(fail-closed) — 인증 없이 임의 권한 토큰을 발급하는 경로라 운영에서 켜지면 인증 체계 전체가 우회되기 때문이다.\n\nHS256 서명된 테스트 용 토큰을 즉시 발급한다(인증 불필요 — 토큰을 얻는 진입점이라 같은 설정 조건 아래에서만 열린다). 역할과 채널 조합은 검수자·작업자는 내부 채널, 포털 회원은 포털 채널만 허용한다. 응답에 서명 비밀값은 포함되지 않는다.",
      "request_body": {
        "schema": {
          "type": "object",
          "required": [
            "role",
            "channel"
          ],
          "properties": {
            "name": {
              "type": "string",
              "nullable": true,
              "description": "이름(name 클레임). null 이면 역할별 기본값"
            },
            "role": {
              "enum": [
                "ADMIN",
                "REVIEWER",
                "WORKER",
                "PORTAL_USER"
              ],
              "type": "string",
              "description": "발급할 역할"
            },
            "userNo": {
              "type": "string",
              "nullable": true,
              "description": "사용자 번호(sub 클레임). null 이면 역할별 기본값(ADMIN=9001, REVIEWER=1001, WORKER=2001, PORTAL_USER=3001)"
            },
            "channel": {
              "enum": [
                "INTERNAL",
                "PORTAL"
              ],
              "type": "string",
              "description": "채널 — ADMIN/REVIEWER/WORKER 는 INTERNAL, PORTAL_USER 는 PORTAL 만 허용(불일치 시 400)"
            },
            "expSeconds": {
              "type": "integer",
              "maximum": 86400,
              "minimum": 60,
              "nullable": true,
              "description": "만료 시간(초). 60~86400(24h). null 이면 3600(1h)"
            }
          }
        },
        "example": {
          "name": "검수자",
          "role": "REVIEWER",
          "userNo": "1001",
          "channel": "INTERNAL",
          "expSeconds": 3600
        },
        "required": true,
        "content_type": "application/json"
      },
