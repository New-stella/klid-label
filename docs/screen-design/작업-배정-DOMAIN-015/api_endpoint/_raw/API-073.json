              "ASSIGNED",
              "PENDING",
              "IN_REVIEW",
              "APPROVED",
              "REJECTED"
            ],
            "type": "string",
            "default": "COMPLETED"
          },
          "example": "COMPLETED",
          "required": false,
          "description": "배치 상태 축 필터. 기본 COMPLETED. UNASSIGNED 지정 시 배치 상태 무관 · LABELER 배정이 없는 영상만 반환(가상 status)."
        },
        {
          "in": "query",
          "name": "workStatus",
          "schema": {
            "enum": [
              "UNASSIGNED",
              "PENDING",
              "REVIEW_PENDING",
              "REJECTED",
              "COMPLETED"
