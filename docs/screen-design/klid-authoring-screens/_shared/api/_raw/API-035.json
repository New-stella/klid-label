      "triggers": [],
      "responses": {
        "200": {
          "schema": {
            "type": "object",
            "properties": {
              "data": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "type": {
                      "enum": [
                        "ADDED",
                        "MODIFIED",
                        "REMOVED"
                      ],
                      "type": "string",
                      "description": "변경 종류. ADDED=to에만 존재, REMOVED=from에만 존재, MODIFIED=양쪽 id 존재+shape/label 차이"
                    },
                    "after": {
                      "type": "object",
                      "nullable": true,
                      "description": "변경 후 shape (ADDED/MODIFIED 시 존재). ShapeDto — before 와 동일 구조"
                    },
                    "before": {
                      "type": "object",
                      "nullable": true,
                      "properties": {
                        "top": {
                          "type": "number",
                          "format": "double",
                          "nullable": true,
                          "description": "BBOX 상단 (POLYGON이면 null)"
                        },
                        "left": {
                          "type": "number",
                          "format": "double",
                          "nullable": true,
                          "description": "BBOX 좌측 (POLYGON이면 null)"
                        },
                        "type": {
                          "enum": [
                            "BBOX",
                            "POLYGON"
                          ],
                          "type": "string",
                          "description": "shape 타입. 2점=BBOX, 3점 이상=POLYGON"
                        },
                        "right": {
                          "type": "number",
                          "format": "double",
                          "nullable": true,
                          "description": "BBOX 우측 (POLYGON이면 null)"
                        },
                        "bottom": {
                          "type": "number",
                          "format": "double",
                          "nullable": true,
                          "description": "BBOX 하단 (POLYGON이면 null)"
                        },
                        "points": {
                          "type": "array",
                          "items": {
                            "type": "number",
                            "format": "double"
                          },
                          "nullable": true,
                          "description": "POLYGON 평탄 좌표 배열 [x1,y1,x2,y2,...] (BBOX이면 null)"
                        }
                      },
                      "description": "변경 전 shape (REMOVED/MODIFIED 시 존재). ShapeDto"
                    },
                    "frameId": {
                      "type": "integer",
                      "nullable": true,
                      "description": "프레임 식별자 (NON_NULL 직렬화 — null이면 생략)"
                    },
                    "objectId": {
                      "type": "string",
                      "nullable": true,
                      "description": "라벨 PK(LS_DATA_LBL.LBL_SN)의 문자열 표현"
                    }
                  }
                },
                "description": "두 버전(from=compareWith / to=path version) 간 라벨 단위 diff 목록 (DiffResponseDto.labels)"
              },
              "message": {
                "type": "string",
                "nullable": true,
                "description": "응답 메시지 (성공 시 null)"
              },
              "success": {
                "type": "boolean",
                "description": "성공 여부"
              },
              "errorCode": {
                "type": "string",
                "nullable": true,
                "description": "에러 코드 (성공 시 null)"
              }
            }
          },
          "example": {
            "data": [
              {
                "type": "ADDED",
                "after": {
                  "top": 80,
                  "left": 120,
                  "type": "BBOX",
                  "right": 260,
                  "bottom": 400
                },
                "frameId": 1,
                "objectId": "502"
              },
              {
