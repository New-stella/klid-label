      "path": "/v1/stats/worker",
      "tags": [
        "stats"
      ],
      "method": "GET",
      "summary": "작업자별 통계",
      "security": [
        {
          "jwt": [
            "REVIEWER",
            "WORKER"
          ]
        }
      ],
      "triggers": [],
      "responses": {
        "200": {
          "schema": {
            "type": "object",
            "properties": {
              "data": {
                "type": "object",
                "properties": {
                  "monthly": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "month": {
                          "type": "string",
                          "description": "월 (yyyy-MM)"
                        },
                        "rejected": {
                          "type": "integer",
                          "format": "int64",
                          "description": "월 반려 수"
                        },
                        "completed": {
                          "type": "integer",
                          "format": "int64",
                          "description": "월 완료 수"
                        },
                        "labelCount": {
                          "type": "integer",
                          "format": "int64",
                          "description": "월 라벨 수"
                        }
                      }
                    },
                    "description": "최근 12개월 월별 집계"
                  },
                  "rejected": {
                    "type": "integer",
                    "format": "int64",
                    "description": "REJECTED 상태 수"
                  },
                  "workerId": {
                    "type": "string",
                    "nullable": true,
                    "description": "대상 작업자 USER_NO (문자열)"
                  },
                  "completed": {
                    "type": "integer",
                    "format": "int64",
                    "description": "APPROVED 상태 영상 수"
                  },
                  "inProgress": {
                    "type": "integer",
                    "format": "int64",
                    "description": "배정됐고 아직 완료되지 않은 건수 — 완료 상태(APPROVED)가 아닌 배정 전부. 진행 상태를 열거하지 않는다(상태값이 늘어도 완료에도 진행에도 잡히지 않아 사라지는 일이 없게 한다)."
                  },
                  "labelCount": {
                    "type": "integer",
                    "format": "int64",
                    "description": "배정된 raw 의 라벨 총 수 — 검수 여부를 가리지 않은 전체 분량이다. 검수완료분만 세는 approvedLabelCount 와 짝을 이루며 화면은 이 값을 보조로 병기한다."
                  },
                  "rejectRate": {
                    "type": "number",
                    "format": "double",
                    "description": "REJECTED/(APPROVED+REJECTED) (0.0~1.0 비율). 전체 구축 현황 API(API-057) 의 동일 성격 지표는 0~100 백분율이며 단위가 다르다."
                  },
                  "workerName": {
                    "type": "string",
                    "nullable": true,
                    "description": "대상 작업자 이름 (미존재 시 null)"
                  },
                  "assignedTotal": {
                    "type": "integer",
                    "format": "int64",
                    "description": "그 작업자에게 배정된 전체 영상 수 — 완료·진행중·반려를 모두 포함한다. completed 와 inProgress 의 합과 같지만 화면이 더해 쓰지 않도록 서버가 직접 내려준다(소비자가 합을 재유도하면 두 값의 정의가 바뀔 때 조용히 어긋난다)."
                  },
                  "autoLabelRate": {
                    "type": "number",
                    "format": "double",
                    "description": "자동 라벨 비율 (0.0~1.0, 분모 0→ 0.0)"
                  },
                  "completionRate": {
                    "type": "number",
                    "format": "double",
                    "description": "completed/assignedTotal (0.0~1.0 비율, 분모 0 → 0.0). 전체 구축 현황 API(API-057) 의 동일 성격 지표는 0~100 백분율이며 단위가 다르다."
                  },
                  "dailyCompletion": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "date": {
                          "type": "string",
                          "description": "일자 (yyyy-MM-dd)"
                        },
                        "count": {
                          "type": "integer",
                          "format": "int64",
                          "description": "해당일 완료 수"
                        }
                      }
                    },
                    "description": "최근 30일 일별 완료 카운트"
                  },
                  "approvedLabelCount": {
                    "type": "integer",
                    "format": "int64",
                    "description": "검수완료(APPROVED) 영상에 달린 라벨 수 — 학습데이터로 확정된 분량이다. 전체 배정분을 세는 labelCount 와 짝을 이루며 화면은 이 값을 주 수치로 보여준다."
                  }
                },
                "description": "작업자 통계 요약"
              },
              "message": {
                "type": "string",
                "nullable": true,
                "description": "응답 메시지 (성공 시 null)"
              },
              "success": {
                "type": "boolean",
                "description": "성공 여부 (성공 시 true)"
              },
              "errorCode": {
                "type": "string",
                "nullable": true,
                "description": "에러 코드 (성공 시 null)"
              }
            }
          },
          "example": {
            "data": {
              "monthly": [
                {
                  "month": "2026-06",
