      "brownfield": {
        "status": "new",
        "decided_by": "ADR-031",
        "change_kind": [
          "capability-add"
        ],
        "diff_summary": "생성형 AI 증강 결과 수신 webhook 신설 — 구 /v1/aug/callback(HMAC) 폐기 대체, 무서명 3계층 방어(IP allowlist / rate limit+size cap / request_id 발급 게이트)로 재설계(ADR-031)"
      },
      "deprecated": false,
      "parameters": [],
      "description": "외부 생성형 AI(증강) 벤더가 증강 작업의 상태 전이(RUNNING→SUCCEEDED|FAILED, CANCELED 는 발사되지 않는다)마다 콜백한다. 외부 연동명세서 정합.\n\n[서명이 없는 콜백이라 3계층으로 방어한다] 서명 필수였던 구 경로는 외부 실물 규격과 맞지 않아 폐기됐고, 지금은 시계열 콜백과 동일한 방식을 쓴다. ①호출 IP 허용목록(webhook.genai.allowed-ip-cidrs — 시계열 콜백과 달리 미설정이면 전면 차단하는 fail-closed) ②분당 횟수 제한(초과 시 429 backoff)과 본문 크기 상한(1MB — Content-Length 없음·chunked 는 411, 초과는 413) ③요청 식별자 발급 게이트(위탁 시 저작도구가 발급한 키만 처리하며 미발급 키는 401).\n\n[경로 인코딩 우회도 막는다] 컨트롤러 진입 직전에 '앞의 방어를 실제로 통과했다는 증거'를 재확인하므로, 경로 표기를 변형해 앞단을 비켜간 요청도 거부된다.\n\n[중복 도착이 정상이다] 전송 실패 시 벤더가 재시도하므로 같은 페이로드가 여러 번 올 수 있으며 수신부는 멱등하다.\n\n[applied 는 '이번 호출로 실제 전이가 일어났는가'만 뜻한다] 이미 종결된 행의 재전송이거나, 비종결 작업이 남아 롤업을 보류한 경우는 false 로 회신한다. 이걸 무조건 true 로 회신하면 외부가 정상 인계로 오인한다.\n\n[정책 보류는 폐기됐다] 부모 영상이 비식별 신고 구간이라는 이유로 생성을 보류하지 않는다 — 파생영상은 비식별 신고 체계 밖이며 신고가 막는 것은 외부 위탁뿐이다. 부모를 물리적으로 쓸 수 없는 경우(비식별 미완료·부모나 프레임 부재)만 실패로 확정한다.",
      "operation_id": "genAiCallback",
      "request_body": {
        "schema": {
          "type": "object",
          "required": [
            "request_id",
            "job_id",
            "status"
          ],
          "properties": {
            "job_id": {
              "type": "string",
              "example": "genai-0001",
              "pattern": "^[A-Za-z0-9_.:-]+$",
              "maxLength": 200,
              "description": "외부가 202 응답으로 발급한 job 식별자"
            },
            "status": {
              "enum": [
                "RUNNING",
                "SUCCEEDED",
                "FAILED"
              ],
              "type": "string",
              "description": "job 상태. CANCELED는 벤더 규격상 발사되지 않는다"
            },
            "results": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "generated_data_id",
                  "media_type",
                  "output_file_path"
                ],
                "properties": {
                  "checksum": {
                    "type": "string",
                    "nullable": true,
                    "maxLength": 128,
                    "description": "산출물 체크섬(선택)"
                  },
                  "media_type": {
                    "enum": [
                      "IMAGE",
                      "VIDEO"
                    ],
                    "type": "string",
                    "description": "생성물 매체 종류"
                  },
                  "output_file_path": {
                    "type": "string",
                    "example": "/nas-storage/genai/genai-0001/001_x_gen.jpg",
                    "maxLength": 500,
                    "description": "산출물 경로(외부 제공). 형식 검증 후 허용 루트 하위 여부를 정규화·재검증한다(CWE-22)"
                  },
                  "generated_data_id": {
                    "type": "string",
                    "maxLength": 128,
                    "description": "생성물 식별자"
                  }
                }
              },
              "maxItems": 100,
              "nullable": true,
              "description": "SUCCEEDED 에만 실림. job 1건 입력 상한이 100장이라 결과도 100건을 넘지 않는다"
            },
            "progress": {
              "type": "integer",
              "maximum": 100,
              "minimum": 0,
              "nullable": true,
              "description": "진행률(%). RUNNING 단계에서 10/50/90 등으로 발사"
            },
            "error_code": {
              "type": "string",
              "nullable": true,
              "maxLength": 50,
              "description": "FAILED 에만 실림 — 벤더측 오류 코드"
            },
            "request_id": {
              "type": "string",
              "example": "AUG-xxxx-1",
              "pattern": "^[A-Za-z0-9_-]+$",
              "maxLength": 128,
              "description": "우리가 발급한 job 단위 멱등키(= LS_DATA_AUG_JOB.IDMP_KEY)의 echo. 영숫자/대시/언더스코어만 허용"
            },
            "updated_at": {
              "type": "string",
              "example": "2026-07-27T10:00:00Z",
              "nullable": true,
              "maxLength": 64,
              "description": "상태 갱신 시각 문자열(ISO-8601 자유형식)"
            },
            "current_step": {
              "type": "string",
              "nullable": true,
              "maxLength": 20,
              "description": "현재 처리 단계 코드(예: COMPLETED)"
            },
            "error_message": {
              "type": "string",
              "nullable": true,
              "maxLength": 1000,
              "description": "FAILED 에만 실림 — 벤더측 오류 메시지"
            }
          }
        },
        "required": true,
        "content_type": "application/json"
      },
