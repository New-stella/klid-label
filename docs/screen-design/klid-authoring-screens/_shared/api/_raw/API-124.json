      "deprecated": false,
      "parameters": [
        {
          "in": "path",
          "name": "srcSn",
          "schema": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "example": 1,
          "required": true,
          "description": "대상 프레임(원천) PK — SRC_SN"
        }
      ],
      "description": "프레임 원본 이미지를 ai-server YOLO 로 추론하여 BBOX 자동 라벨을 LS_DATA_LBL 에 저장한다(출처 MANUAL_TRIGGER). 재실행 시 기존 자동 라벨만 교체하고 수동 라벨은 보존한다. 선택적 body {classes:[...]} 로 검출 대상 클래스(COCO 영문명)를 제한할 수 있으며, 미지정 시 전체 검출(하위호환). ai-server 내부 mock(모델 미로드) 응답이면 저장하지 않고 savedCount=0 + 안내 message 로 반환한다. 권한 REVIEWER/WORKER, 본인 배정 프레임 IDOR 검증. 포털 채널은 역할+채널 격리로 물리 차단(ADR-013).",
      "operation_id": "autolabelFrame",
      "request_body": {
        "schema": {
          "type": "object",
          "properties": {
            "shape": {
              "enum": [
                "BBOX",
                "POLYGON"
              ],
              "type": "string",
              "default": "BBOX",
              "nullable": true,
              "description": "검출 도형. BBOX(기본)/POLYGON. 미지정 시 BBOX."
            },
            "classes": {
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 50
              },
              "maxItems": 100,
              "nullable": true,
              "description": "검출 대상 클래스(COCO 영문명) 화이트리스트. null/빈 배열이면 전체(미필터). 리스트 최대 100개, 각 원소 최대 50자(CWE-770/20)."
            },
            "confThreshold": {
              "type": "number",
              "format": "double",
              "maximum": 0.8,
              "minimum": 0.25,
              "nullable": true,
              "description": "YOLO 신뢰도 임계값(0.25~0.80). 미지정 시 서버 기본값. 정밀도 조절 knob(FEAT-007)."
            },
            "simplifyTolerance": {
              "type": "number",
              "format": "double",
              "maximum": 50,
              "minimum": 0,
              "nullable": true,
              "description": "POLYGON 단순화 허용오차(0.0~50.0). shape=POLYGON 일 때 정점 수 감소. iou 는 요청 override 대상 아님."
            }
          },
          "description": "AutolabelRequest — 선택적 클래스 필터. body 전체 생략 시 전체 검출(하위호환)."
        },
        "example": {
          "classes": [
            "person",
            "car"
          ]
        },
        "required": false,
        "content_type": "application/json"
      },
