            "vd_description": {
              "type": "string",
              "nullable": true,
              "maxLength": 4000,
              "description": "영상 서술(vd_description, ADR-020 신규 키). VLM 생성"
            }
          },
          "description": "EventAnnotationPayload — 이벤트 어노테이션 전체 본문(upsert). event_class 필수."
        },
        "example": {
