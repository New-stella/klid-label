              "maxItems": 4,
              "minItems": 4,
              "description": "박스 좌표 [x1,y1,x2,y2]. 박스 프롬프트일 때만 사용. points와 배타 — 정확히 하나만 제공"
            },
            "srcSn": {
              "type": "integer",
              "format": "int64",
              "description": "대상 프레임 PK. path 변수와 일치해야 함"
            },
            "points": {
              "type": "array",
              "items": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "maxItems": 2,
                "minItems": 2
              },
              "maxItems": 100,
              "description": "클릭 좌표 [[x,y], ...]. 클릭 프롬프트일 때만 사용 (최대 100개). box와 배타 — 정확히 하나만 제공"
            }
          }
        },
        "required": true,
        "content_type": "application/json"
      },
