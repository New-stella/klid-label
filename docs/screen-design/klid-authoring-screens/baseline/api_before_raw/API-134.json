          "example": 1,
          "required": true,
          "description": "대상 영상 식별자 RAW_SN(작업 단위=영상 1건)"
        }
      ],
      "description": "영상 단위(RAW_SN) 이벤트 어노테이션을 upsert 한다(LS_EVNT_ANNO, RAW_SN UK 기준 1건). 라벨링 화면의 수동입력 경로로, caption 은 VLM 생성 결과를 작업자가 수정할 수 있다(caption 만 VLM+수동입력, 나머지 키는 VLM 생성). evidence 는 캔버스 선택 객체를 자동 연결하며 MAX_ID 힌트를 제공한다. 저장 시 검토 상태는 PENDING 으로 전이(AUTO_GENERATED 에서 수정 시). 권한 REVIEWER/WORKER, 본인 배정 영상 IDOR 검증, 포털 채널 격리. 검수 승인 후 수정 시 TASK_MODIFIED 통지 대상.",
      "operation_id": "upsertEventAnnotation",
      "request_body": {
        "schema": {
          "type": "object",
          "required": [
            "event_class"
          ],
          "properties": {
            "cot": {
              "type": "object",
              "nullable": true,
              "description": "Chain-of-Thought 추론(ADR-020: cot 배열→객체). VLM 생성"
            },
            "vqa": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "question",
                  "answer"
                ],
                "properties": {
                  "answer": {
                    "type": "string",
                    "description": "답변"
                  },
                  "question": {
                    "type": "string",
                    "description": "질문"
                  }
                }
              },
              "description": "VQA 목록. VLM 생성"
            },
            "caption": {
              "type": "string",
              "nullable": true,
              "maxLength": 4000,
              "description": "영상 캡션. VLM 생성 + 작업자 수동입력/수정(유일한 수동입력 대상)"
            },
            "evidence": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "lblSn": {
                    "type": "integer",
                    "format": "int64",
                    "nullable": true,
                    "description": "근거 라벨 PK(LS_DATA_LBL.LBL_SN)"
                  },
                  "trackId": {
                    "type": "string",
                    "nullable": true,
                    "description": "근거 트랙 ID(TRCK_ID)"
                  }
                }
              },
              "description": "근거 객체(캔버스 선택 라벨/트랙 자동연결 + MAX_ID 힌트)"
            },
            "event_class": {
              "type": "string",
              "maxLength": 64,
              "description": "이벤트 클래스(필수키). 관제 클립 이벤트 유형"
            },
            "vd_description": {
              "type": "string",
              "nullable": true,
              "maxLength": 4000,
              "description": "영상 서술(vd_description, ADR-020 신규 키). VLM 생성"
            }
          },
          "description": "EventAnnotationPayload — 이벤트 어노테이션 전체 본문(upsert). event_class 필수."
        },
        "example": {
          "cot": {
            "step1": "보행자 식별",
            "step2": "낙상 판정"
