      "parameters": [
        {
          "in": "path",
          "name": "srcSn",
          "schema": {
            "type": "integer",
            "format": "int64"
          },
          "required": true,
          "description": "대상 프레임 PK (SRC_SN). 요청 body의 srcSn과 일치해야 함"
        }
      ],
      "description": "사용자가 캔버스에서 클릭(포인트) 또는 드래그(박스)로 객체를 지목하면 BE(Sam2SegmentService)가 ai-server POST /infer/sam2/segment로 프록시하여 폴리곤+신뢰도를 받는다. points/box는 정확히 1개만 제공(@AssertTrue 배타 검증, 둘 다/둘 다 없음 400). SAM2는 정책상 원본 프레임 이미지(SRC_FILE_PATH_NM)에만 실행하고 비식별본은 좌표 공유. 응답 폴리곤은 이미지 실측 해상도 상한까지 좌표 검증(CWE-20) 후 Douglas-Peucker(POLYGON_SIMPLIFY_TOLERANCE) 단순화. mock 응답은 FE에서 자동 적용 차단. BE는 stateless 프록시로 DB 저장 안 함(저장은 라벨 임시저장 흐름). 보안: IDOR(LabelAccessGuard.verifyAccess 본인 배정 프레임만), 경로순회(CWE-22), 이미지 크기 상한 20MB(초과 413). FE는 SAM_SEGMENT 캔버스 도구(단축키 G). REQ-007(RQ-SFR-08-02)·UC-005 연결.",
      "request_body": {
        "schema": {
          "type": "object",
          "required": [
            "srcSn"
          ],
          "properties": {
            "box": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "maxItems": 4,
              "minItems": 4,
              "description": "박스 좌표 [x1,y1,x2,y2]. 박스 프롬프트일 때만 사용. points와 배타 — 정확히 하나만 제공"
            },
            "srcSn": {
              "type": "integer",
              "format": "int64",
              "description": "대상 프레임 PK. path 변수와 일치해야 함"
            },
            "points": {
              "type": "array",
              "items": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "maxItems": 2,
                "minItems": 2
              },
              "maxItems": 100,
              "description": "클릭 좌표 [[x,y], ...]. 클릭 프롬프트일 때만 사용 (최대 100개). box와 배타 — 정확히 하나만 제공"
            }
          }
        },
        "required": true,
        "content_type": "application/json"
      },
