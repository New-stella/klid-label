              "auditScannedFrames": 1200,
              "viewExcludedRawSns": [],
              "unresolvedPresetRawSns": []
            },
            "message": null,
            "success": true,
            "errorCode": null
          },
          "description": "실행 결과(대상/이관/스킵/실패/미매칭 등)",
