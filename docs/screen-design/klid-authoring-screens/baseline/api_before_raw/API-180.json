      ],
      "method": "POST",
      "summary": "해상도 파생 산출물 비식별 저장소 이관 백필 (REVIEWER)",
      "security": [
        {
          "jwt": [
            "REVIEWER"
          ]
        }
      ],
      "triggers": [],
      "responses": {
        "200": {
          "schema": {
            "type": "object",
            "properties": {
              "data": {
                "type": "object",
                "properties": {
                  "failures": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "rawSn": {
                          "type": "integer",
                          "format": "int64",
                          "description": "실패한 파생 RAW_SN"
                        },
                        "reasonCode": {
                          "type": "string",
                          "description": "실패 사유 코드(예외 클래스명 등 추상 코드만, CWE-209)"
                        }
                      }
                    },
                    "description": "이관 실패 항목 — 해당 RAW_SN은 기존 경로를 유지(재실행 가능)"
                  },
                  "targetCount": {
                    "type": "integer",
                    "description": "대상(확정 ACCEPTED 해상도 파생) 영상 수"
                  },
                  "skippedRawSns": {
                    "type": "array",
                    "items": {
                      "type": "integer",
                      "format": "int64"
                    },
                    "description": "이미 이관 완료라 건너뛴 파생 RAW_SN(멱등 재실행)"
                  },
                  "auditTruncated": {
                    "type": "boolean",
                    "description": "감사가 1회 실행 상한(자원 고갈 방지)에 걸려 부분 스캔으로 끝났는가. true면 auditViolations가 비어 있어도 '영향 없음'의 근거로 쓸 수 없음"
                  },
                  "migratedRawSns": {
                    "type": "array",
                    "items": {
                      "type": "integer",
                      "format": "int64"
                    },
                    "description": "이번 실행에서 실제 이관된 파생 RAW_SN 목록"
                  },
                  "auditViolations": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "rawSn": {
                          "type": "integer",
                          "format": "int64",
                          "description": "영상 PK"
                        },
                        "verdict": {
                          "type": "string",
                          "description": "판정 코드(StorageSubtreePolicy.Verdict) — 경로 원문 미노출"
                        },
                        "frameCount": {
                          "type": "integer",
                          "format": "int64",
                          "description": "해당 사유로 비식별 산출물 판정에 실패한 프레임 수"
                        }
                      }
                    },
                    "description": "감사 위반 집계 — 서빙(FrameSource)과 동일한 판정기로 판정"
                  },
                  "unmatchedRawSns": {
                    "type": "array",
                    "items": {
                      "type": "integer",
                      "format": "int64"
                    },
                    "description": "감사에서 비식별 산출물로 인정되지 않은 프레임을 가졌으나 대상 조인에 잡히지 않은 RAW_SN(수동 확인 대상)"
                  },
                  "staleDeletedCount": {
                    "type": "integer",
                    "description": "이번 실행에서 유예가 지나 실제 삭제된 구 산출물 수"
                  },
                  "stalePendingCount": {
                    "type": "integer",
                    "description": "유예 대기 중인 구 산출물 수(2노드 stale 캐시 보호를 위해 아직 지우지 않은 파일 수, 0 아니어도 정상)"
                  },
                  "auditScannedFrames": {
                    "type": "integer",
                    "format": "int64",
                    "description": "감사에서 실제 판정한 프레임 행 수"
                  },
                  "viewExcludedRawSns": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "rawSn": {
                          "type": "integer",
                          "format": "int64",
                          "description": "영상 PK"
                        },
                        "frameCount": {
                          "type": "integer",
                          "format": "int64",
                          "description": "결함 프레임 수(원본 경로와 비식별 경로가 동일)"
                        }
                      }
                    },
                    "description": "V_COMPLETED_FRAME 게이트로 뷰에서 제외되는 영상 목록(G-2)"
                  },
                  "unresolvedPresetRawSns": {
                    "type": "array",
                    "items": {
                      "type": "integer",
                      "format": "int64"
                    },
                    "description": "파생으로 발견됐으나 대응 LS_DATA_AUG(RESL_*, ACCEPTED) 행이 없어 프리셋을 확정하지 못한 파생 RAW_SN(수동 확인 대상, 프레임 이관은 수행되나 영상 파일 경로는 손대지 않음)"
                  }
                },
                "description": "해상도 파생 산출물 이관 백필 실행 결과"
              },
              "message": {
                "type": "string",
                "nullable": true
              },
              "success": {
                "type": "boolean"
              },
              "errorCode": {
                "type": "string",
                "nullable": true
              }
            }
          },
          "example": {
            "data": {
              "failures": [],
              "targetCount": 5,
              "skippedRawSns": [
                2003
