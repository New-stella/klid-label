      "method": "POST",
      "summary": "YOLO 객체 감지 추론 (ai-server)",
      "security": [],
      "triggers": [],
      "responses": {
        "200": {
          "schema": {
            "type": "object",
            "required": [
              "detections"
            ],
            "properties": {
              "mock": {
                "type": "boolean",
                "default": false,
                "description": "mock 응답이면 true"
              },
              "source": {
                "type": "string",
                "default": "model",
                "description": "mock | model"
              },
              "detections": {
                "type": "array",
