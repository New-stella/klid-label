                  "type": "object",
                  "required": [
                    "label",
                    "points",
                    "score"
                  ],
                  "properties": {
                    "label": {
                      "type": "string",
                      "description": "클래스 라벨"
                    },
                    "score": {
                      "type": "number",
                      "format": "float",
                      "maximum": 1,
                      "minimum": 0,
                      "description": "신뢰도"
                    },
                    "points": {
                      "type": "array",
                      "items": {
                        "type": "number",
                        "format": "float"
                      },
                      "maxItems": 4,
                      "minItems": 4,
                      "description": "[x1, y1, x2, y2]"
                    },
                    "track_id": {
                      "type": "integer",
                      "nullable": true,
                      "description": "트래커 부여 ID. /predict 응답에서는 항상 null"
                    }
                  }
                },
                "description": "감지 객체 목록"
              },
              "mock_reason": {
                "type": "string",
                "nullable": true,
                "description": "mock 사유: env_mock | weights_missing | load_failed"
              }
            }
          },
          "example": {
            "mock": false,
            "source": "model",
            "detections": [
              {
                "label": "person",
                "score": 0.88,
                "points": [
                  100,
                  80,
                  240,
                  400
                ],
                "track_id": null
