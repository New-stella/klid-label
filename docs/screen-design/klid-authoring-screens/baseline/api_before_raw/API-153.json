    "title": "POST /v1/dev/tokens",
    "slug": "post-v1devtokens",
    "sub_id": null,
    "status": "draft",
    "data": {
      "path": "/v1/dev/tokens",
      "tags": [
        "dev",
        "auth"
      ],
      "method": "POST",
      "summary": "테스트 JWT 토큰 발급 (개발/검수 전용)",
      "security": [],
      "triggers": [],
      "responses": {
        "201": {
          "schema": {
            "type": "object",
            "properties": {
              "data": {
                "type": "object",
                "properties": {
                  "token": {
                    "type": "string",
                    "description": "발급된 JWT 토큰(HS256 서명)"
                  },
                  "claims": {
                    "type": "object",
                    "description": "디코드된 페이로드 클레임(디버깅 용도, 서명 정보 미포함)"
                  },
                  "expiresAt": {
                    "type": "integer",
                    "format": "int64",
                    "description": "만료 시각(epoch millis)"
                  },
                  "tokenType": {
                    "type": "string",
                    "description": "토큰 타입(Bearer)"
                  },
                  "authorizationHeader": {
                    "type": "string",
                    "description": "Authorization 헤더 값(복사·붙여넣기 편의용, 'Bearer {token}')"
                  }
                }
              },
              "message": {
                "type": "string",
                "nullable": true,
                "description": "응답 메시지 (성공 시 null)"
              },
              "success": {
                "type": "boolean",
                "description": "성공 여부"
              },
              "errorCode": {
                "type": "string",
                "nullable": true,
                "description": "에러 코드 (성공 시 null)"
              }
            }
          },
          "example": {
            "data": {
              "token": "eyJhbGciOiJIUzI1NiJ9...",
              "claims": {
                "sub": "1001",
                "role": "REVIEWER",
                "channel": "INTERNAL"
              },
              "expiresAt": 1747000000000,
              "tokenType": "Bearer",
              "authorizationHeader": "Bearer eyJhbGciOiJIUzI1NiJ9..."
            },
            "message": null,
            "success": true,
            "errorCode": null
          },
          "description": "토큰 발급 성공(@ResponseStatus 201).",
          "content_type": "application/json"
        },
        "400": {
          "schema": {
            "type": "object",
            "properties": {
              "data": {
                "type": "object",
                "nullable": true,
                "description": "에러 시 null"
              },
              "message": {
                "type": "string",
                "description": "사용자 메시지"
              },
              "success": {
                "type": "boolean",
                "description": "성공 여부 (에러 시 false)"
              },
              "errorCode": {
                "type": "string",
                "description": "ErrorCode enum name"
              }
            }
          },
          "example": {
            "data": null,
            "message": "role-channel 조합이 올바르지 않습니다.",
            "success": false,
            "errorCode": "INVALID_INPUT"
          },
          "description": "role-channel 불일치 / expSeconds 범위 초과(60~86400). ErrorCode=INVALID_INPUT",
          "content_type": "application/json"
        }
      },
      "brownfield": {
        "status": "new",
        "decided_by": "ADR-039",
        "change_kind": [
          "capability-add"
        ],
        "diff_summary": "dev 전용 테스트 JWT 발급(DevTokenController) — 갭 대조로 신규 등록. authoring.dev.login.enabled 토글 기본 true(local/dev/stg)"
      },
      "deprecated": false,
      "parameters": [],
      "description": "authoring.dev.login.enabled=true(env DEV_LOGIN_ENABLED) 일 때만 빈이 등록되어 endpoint 가 노출된다. 미설정/false 면 prd·dev 무관하게 빈 부재(404, fail-closed, ADR-039). local/dev/stg 프로파일은 yml 기본값이 true 라 기존 동작 유지. HS256 서명된 테스트 JWT 를 즉시 발급한다(인증 불필요, SecurityConfig permitAll 매처도 같은 프로퍼티 조건부). role-channel 조합: REVIEWER/WORKER ↔ INTERNAL, PORTAL_USER ↔ PORTAL 만 허용. 응답에 secret 은 포함되지 않는다.",
      "request_body": {
        "schema": {
          "type": "object",
          "required": [
            "role",
            "channel"
          ],
          "properties": {
            "name": {
              "type": "string",
              "nullable": true,
              "description": "이름(name 클레임). null 이면 역할별 기본값"
            },
            "role": {
              "enum": [
                "REVIEWER",
                "WORKER",
                "PORTAL_USER"
              ],
              "type": "string",
              "description": "발급할 역할"
            },
            "userNo": {
              "type": "string",
              "nullable": true,
              "description": "사용자 번호(sub 클레임). null 이면 역할별 기본값(REVIEWER=1001, WORKER=2001, PORTAL_USER=3001)"
            },
            "channel": {
              "enum": [
                "INTERNAL",
                "PORTAL"
              ],
              "type": "string",
              "description": "채널 — REVIEWER/WORKER 는 INTERNAL, PORTAL_USER 는 PORTAL 만 허용(불일치 시 400)"
            },
            "expSeconds": {
              "type": "integer",
              "maximum": 86400,
              "minimum": 60,
              "nullable": true,
              "description": "만료 시간(초). 60~86400(24h). null 이면 3600(1h)"
            }
          }
        },
        "example": {
          "name": "검수자",
          "role": "REVIEWER",
          "userNo": "1001",
          "channel": "INTERNAL",
          "expSeconds": 3600
        },
        "required": true,
        "content_type": "application/json"
      },
