        ],
        "diff_summary": "PR #57 신설 — 검수목록 KPI 집계 서버 이관"
      },
      "deprecated": false,
      "parameters": [
        {
          "in": "query",
          "name": "status",
          "schema": {
            "enum": [
              "PENDING",
              "IN_REVIEW",
              "APPROVED",
