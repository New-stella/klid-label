      "brownfield": {
        "status": "new",
        "decided_by": "ADR-032",
        "change_kind": [
          "capability-add"
        ],
        "diff_summary": "프레임 개인정보 메타 저장(전체교체) 신설 — R1 요구 외 추가(ADR-032), path/body srcSn 정합 검증(CWE-345)"
      },
      "deprecated": false,
      "parameters": [
        {
          "in": "path",
          "name": "srcSn",
          "schema": {
            "type": "integer",
            "format": "int64"
          },
          "example": 1,
          "required": true,
          "description": "프레임 PK"
        }
      ],
      "description": "익명/가명/개인정보 포함여부(각 Y/N)를 저장/수정한다(FramePrivacyMetaService — Phase 3). 전체 교체 — 생략(null)한 필드는 수동값이 삭제되어 파생값으로 폴백한다. path srcSn과 body srcSn 불일치 시 400(CWE-345). 허용값(^[YN]$) 외 문자열은 400(CWE-20 화이트리스트). 검수 완료(APPROVED) 후 수정 시 TASK_MODIFIED 통지. anonymity는 export를 덮지 않음(표시·기록용). R1 요구사항 외 신규 추가 결정(ADR-032).",
      "operation_id": "updateFramePrivacyMeta",
      "request_body": {
        "schema": {
          "type": "object",
          "required": [
            "srcSn"
          ],
          "properties": {
            "srcSn": {
              "type": "integer",
              "format": "int64",
              "description": "프레임 PK — path의 srcSn과 일치해야 함(불일치 시 400)"
            },
            "anonymity": {
              "type": "string",
              "pattern": "^[YN]$",
              "nullable": true,
              "description": "익명여부(Y/N). null=미판정/수동값 삭제"
            },
            "pseudonymity": {
              "type": "string",
              "pattern": "^[YN]$",
              "nullable": true,
              "description": "가명여부(Y/N). null=미판정/수동값 삭제"
            },
            "privacyIncluded": {
              "type": "string",
              "pattern": "^[YN]$",
              "nullable": true,
              "description": "개인정보 포함여부(Y/N). null=미판정/수동값 삭제"
            }
          }
        },
        "required": true,
        "content_type": "application/json"
      },
