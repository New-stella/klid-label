            "properties": {
              "data": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "type": {
                      "enum": [
                        "ADDED",
                        "MODIFIED",
                        "REMOVED"
                      ],
                      "type": "string",
                      "description": "변경 종류. ADDED=작업본에만 존재, REMOVED=버전 스냅샷에만 존재, MODIFIED=양쪽 id 존재 + 비교축 차이"
                    },
                    "after": {
                      "type": "object",
                      "nullable": true,
                      "description": "변경 후 shape(현재 작업본 측). ShapeDto — API-035 와 동일 구조"
                    },
                    "before": {
                      "type": "object",
                      "nullable": true,
                      "description": "변경 전 shape(버전 스냅샷 측). ShapeDto — API-035 와 동일 구조"
                    },
                    "frameId": {
                      "type": "integer",
                      "nullable": true,
                      "description": "프레임 식별자"
                    },
