      "triggers": [],
      "responses": {
        "200": {
          "schema": {
            "type": "object",
            "properties": {
              "data": {
                "type": "object",
                "properties": {
                  "fps": {
                    "type": "number",
                    "format": "double",
                    "nullable": true,
                    "description": "영상 FPS — 영상 자산만, 이미지는 null"
                  },
                  "regDt": {
                    "type": "string",
                    "format": "date-time",
                    "description": "등록 일시"
                  },
                  "uldSn": {
                    "type": "integer",
                    "format": "int64",
                    "description": "업로드 자산 식별자"
                  },
                  "fileSz": {
                    "type": "integer",
                    "format": "int64",
                    "nullable": true,
                    "description": "파일 크기(byte)"
                  },
                  "frames": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "regDt": {
                          "type": "string",
                          "format": "date-time",
                          "description": "프레임 등록 일시"
                        },
                        "uldSn": {
                          "type": "integer",
                          "format": "int64",
                          "description": "소속 업로드 자산 식별자"
                        },
                        "frmeNo": {
                          "type": "integer",
                          "format": "int32",
                          "description": "프레임 순번(이미지는 0 고정, 영상은 추출 순서)"
                        },
                        "uldFrmeSn": {
                          "type": "integer",
                          "format": "int64",
                          "description": "프레임 식별자"
                        }
                      }
                    },
                    "description": "프레임 순번 오름차순 요약 목록"
                  },
                  "frmeCnt": {
                    "type": "integer",
                    "nullable": true,
                    "description": "추출된 프레임 수. 마킹을 거치기 전에는 프레임이 없다"
                  },
                  "mdfcnDt": {
                    "type": "string",
                    "format": "date-time",
                    "description": "최종 수정(상태 전이) 일시"
                  },
                  "expiresAt": {
                    "type": "string",
                    "format": "date-time",
                    "nullable": true,
                    "description": "보존기간 만료 예정 시각 = GREATEST(regDt, 그 자산 라벨의 MAX(regDt)) + portal.upload.retention-days(READY) 또는 mdfcnDt + portal.upload.failed-retention-days(FAILED). UPLOADED·PROCESSING 상태 자산은 삭제 대상이 아니므로 null. 조회 시점의 보존기간 설정값 기준 계산값이며 저장되지 않는다(파생 필드). 설정이 바뀌면 다음 조회부터 값이 달라진다 — 클라이언트는 캐시하지 말고 매 조회마다 갱신할 것."
                  },
                  "failRsnCn": {
                    "type": "string",
                    "nullable": true,
                    "description": "실패 사유(FAILED 상태에서만)"
                  },
                  "uldSttsCd": {
                    "enum": [
                      "UPLOADED",
                      "PROCESSING",
                      "READY",
                      "FAILED"
                    ],
                    "type": "string",
                    "description": "처리 상태. UPLOADED=마킹 대기(업로드가 확정되어 마킹을 기다리는 상태다 — 추출을 기다리는 상태가 아니다. 업로드 직후 프레임을 뽑지 않고 마킹 저장이 추출을 연다), PROCESSING=마킹 지점으로 프레임 추출 중, READY=추출 완료(라벨링·다운로드 가능), FAILED=처리 실패. 값 자체는 바뀌지 않았고 UPLOADED 가 가리키는 뜻이 바뀌었다"
                  },
                  "uldTypeCd": {
                    "enum": [
                      "IMAGE",
                      "VIDEO"
                    ],
                    "type": "string",
                    "description": "자산 유형"
                  },
                  "vdoLenSec": {
                    "type": "number",
                    "format": "double",
                    "nullable": true,
                    "description": "영상 길이(초) — 영상 자산만, 이미지는 null"
                  },
                  "mimeTypeNm": {
                    "type": "string",
                    "nullable": true,
                    "description": "확정 MIME 타입"
                  },
                  "orgnlFileNm": {
                    "type": "string",
                    "nullable": true,
                    "description": "원본 파일명(표시용)"
                  }
                }
              },
              "message": {
                "type": "string",
                "nullable": true,
                "description": "응답 메시지(성공 시 null)"
              },
              "success": {
                "type": "boolean",
                "description": "성공 여부"
              },
              "errorCode": {
                "type": "string",
                "nullable": true,
                "description": "에러 코드(성공 시 null)"
              }
            }
          },
