# ============================================================================
# klid-label 풀스택 배포 환경변수 예시 (docker-compose)
#   - 실제 .env 는 커밋 금지 (.gitignore 에 등록됨).
#   - 시크릿은 배포 서버에서 openssl 등으로 생성해 주입한다.
# ============================================================================

# ---- 프로파일 ----
# base compose 기본값은 dev(= cudo_246 배포 프로파일). 이 값을 설정하지 않으면 dev 로 뜬다.
#   - 로컬 자족 기동(-f docker-compose.local.yml)은 override 가 local 로 고정하므로 이 값과 무관하다.
#   - 롤백: 아래 주석을 풀어 local 로 되돌린다(compose 재기동만으로 원복).
# SPRING_PROFILES_ACTIVE=local
# 주의: ENV 환경변수는 local 스택에서 dev/stg/prd 로 설정하지 말 것 (LocalProfileGuard 부트 차단).

# ---- DB (번들 klid-postgres) ----
CONTROL_DB_NAME=klid_system
PORTAL_DB_NAME=portal
CONTROL_DB_USERNAME=klid_user
# openssl rand -hex 16
CONTROL_DB_PASSWORD=CHANGE_ME
# 포털 DB 자격 — 번들 postgres 는 klid_user 단일 계정이라 control 과 동일 값 사용.
#   방법 B(Native) 에서 필수: 미설정 시 application-local.yml fallback(klid_local_2024)으로
#   번들 docker postgres 인증 실패(portalEntityManagerFactory 부트 차단).
PORTAL_DB_USERNAME=klid_user
PORTAL_DB_PASSWORD=CHANGE_ME   # = CONTROL_DB_PASSWORD 와 동일 값

# ---- JWT (관제/포털 발급 토큰 검증) ----
# openssl rand -hex 48  (>= 256bit)
JWT_SECRET=CHANGE_ME
JWT_ISSUER=klid-auth
JWT_ALLOWED_ISSUERS=klid-auth,klid,klid-portal

# ---- 영상 스트림 서명 시크릿 (JWT_SECRET 과 분리, >= 32B) ----
# openssl rand -hex 32
STREAM_SIGN_SECRET=CHANGE_ME

# ---- 관리자 클레임 비밀번호 해시 (BCrypt cost>=12) ----
# local 프로파일에서만 기본 해시가 있다. **dev 로 뜨면 빈 값 = 관리자 클레임 불가** — 직접 주입할 것.
ADMIN_CLAIM_PASSWORD_HASH=

# ---- 배치 ----
# ⚠ local 프로파일은 yml 이 batch/training-scan 을 끄지만, **dev 는 기본 활성(true)** 이다.
#   아래를 false 로 남겨두면 dev 로 전환해도 파이프라인이 돌지 않는다(자동 적재·배치 미발화).
#   dev 배포: 주석 처리하거나 true 로 둘 것. 로컬 자족 검증: false 유지 가능.
# BATCH_ENABLED=true
# TRAINING_SCAN_ENABLED=true

# ---- 외부 벤더 연동 (mock-server 컨테이너로 실 HTTP) ----
# compose 가 아래 기본값을 이미 주입한다 — 여기서 값을 넣으면 그 값이 우선한다.
#   (자체 채움 비식별은 폐지됨 — 비식별은 항상 외부 위탁)
#   KPST_DEID_ENABLED=true            비식별 위탁 경로 활성
#   KPST_DEID_BASE_URL=http://klid-mock-server:9400
#   VLM_SERVICE_URL=http://klid-mock-server:9400   비우면 위탁이 실패한다(활성/비활성 토글은 폐지됨)
#   (구 VLM_ALLOW_INSECURE_URL 은 제거됐다 — 평문 http·내부 호스트가 전 환경에서 그대로 통과한다)
#   WEBHOOK_CALLBACK_BASE_URL=http://klid-backend:8080/api   (콜백 수신 주소)
# 벤더 실서버 전환 시에는 KPST_DEID_BASE_URL / VLM_SERVICE_URL 만 바꾼다(코드 변경 불요).
# ⚠ 위 키들을 이 파일에 **값으로 적지 말 것** — .env 값이 compose 주입을 이기므로
#   VLM_SERVICE_URL= 같은 잔여 빈 값 하나로 목 연동이 끊겨 위탁이 전건 실패한다.

# ---- 관제 완료/수정 통지 (D-48) ----
#   로컬은 통지를 켜고 목 서버(klid-mock-server:9400)로 **실제 HTTP 전송**한다 — 내부 목모드로
#   외부 호출을 우회하지 않는다. 목이 409(job_id 중복)/404(선행 완료 없음)를 관제 계약대로 돌려주므로
#   자기치유(409 completed→updated / 404 updated→completed)가 실동작으로 검증된다.
#   ⚠ 로컬 기동은 반드시 두 파일을 함께 지정한다:
#       docker compose -f docker-compose.yml -f docker-compose.local.yml up -d
#      (mock-server 서비스 정의는 base compose 에 있고, local override 가 named volume·local
#       프로파일과 CONTROL_NOTIFY_URL 을 주입한다)
#   목 서버 없이 띄우려면 CONTROL_NOTIFY_ENABLED=false 로 끈다. 운영(dev/stg/prd)은 관제 실주소를 주입.
CONTROL_NOTIFY_ENABLED=true
CONTROL_NOTIFY_URL=http://klid-mock-server:9400
# 관제 계정 창구 — 관제 채널 세션 연장·로그아웃 중계 주소 (2026-09-14 · CO-20260914-관제계정창구-주소분리).
#   ★ 통지 주소(CONTROL_NOTIFY_URL)와 별개이며 비어 있어도 그 주소로 대체하지 않는다 — 비우면 세션 연장이 동작하지 않는다.
#   관제는 계정 창구(/api/account/)와 데이터셋 창구(/api/data-set/)를 서로 다른 WAS 에 둔다.
#   로컬은 목 서버의 계정 창구로 보낸다. 목 서버가 새 토큰에 서명하려면 base docker-compose.yml(모든 도커
#   스택 공통)이 JWT_SECRET 을 MOCK_CONTROL_JWT_SECRET 으로 넘긴다 — JWT_SECRET 이 비면 목 갱신은 503 이고
#   로그아웃만 된다. ⚠ 이 키를 local override 에 넣지 말 것(목 서버 정의 단일화 가드 위반).
CONTROL_ACCOUNT_URL=http://klid-mock-server:9400
# webhook HMAC 시크릿 — **빈 값이면 애플리케이션 기동 실패**(fail-closed, E-ISSUE-04).
#   ★ 예시 파일에 사용 가능한 실값을 두지 않는다 — 커밋된 기본값은 공개된 키라 누구나 유효 서명을
#     위조할 수 있다(DEV_FIX H-1, CWE-1392/798). 아래를 실행해 생성한 난수를 .env 에 채운다.
#       openssl rand -hex 32
#   32B(256bit) 미만이거나 리포에 커밋된 placeholder 값이면 local 외 프로파일에서 기동이 차단된다.
# (UC018 — 비식별은 KPST 폴링으로 단일화되어 콜백 시크릿 미사용)
#WEBHOOK_HMAC_SECRET_DEIDENTIFY=
# (VLM describe 콜백은 벤더 v2.0.1 무서명 규격 — HMAC 미사용)
#WEBHOOK_HMAC_SECRET_VLM=
WEBHOOK_HMAC_SECRET_AUGMENT=

# webhook 신뢰 프록시 CIDR (CSV) — 이 대역에서 온 요청의 X-Forwarded-For 만 해석한다(CWE-348).
#   ★ 예시 파일은 비워 둔다 — 'none' 을 기본값으로 건네면 "프록시 뒤인데 미설정" 상태가 그대로
#     배포된다. 그 상태에서는 모든 콜백의 클라이언트 IP 가 LB IP 하나로 수렴해, 공격자의 인증 실패
#     5회가 정상 벤더 콜백 전건을 60초 차단한다(DEV_FIX N-3).
#   설정 방법:
#     - LB/Nginx 뒤        → 신뢰 대역 CIDR 을 나열 (예: 10.0.0.0/8,192.168.0.0/16)
#     - 프록시 없이 직접 노출 → none 을 명시
#   운영(prd)은 미설정 시 기동 차단(M-3), 형식 오류(오타·호스트명)도 기동 차단(N-4).
WEBHOOK_TRUSTED_PROXY_CIDRS=
# VLM 콜백 허용 출처 CIDR (CSV) — 무서명 콜백 3계층 방어의 첫 계층. 벤더 송신 대역을 지정한다.
#   미적용을 의도하면 'none' 을 명시(운영은 미설정 시 기동 차단).
WEBHOOK_VLM_ALLOWED_IP_CIDRS=
#  - WEBHOOK_GENAI_ALLOWED_IP_CIDRS: 생성형 AI 무서명 웹훅(/v1/genai/callback) IP allowlist.
#    VLM 과 달리 **미설정이면 전면 차단**(fail-closed). 외부 송신 대역 CIDR 을 CSV 로 지정한다.
#    ★ 빈 값 대입(`KEY=`)으로 두지 않는다 — `${VAR:default}` 는 set-but-empty 면 기본값이 아니라
#      <빈 값>을 쓰므로(위 CORS 항목과 동일 시맨틱) 프로파일 yml 기본값(local=0.0.0.0/0)이 무력화된다.
#      그 상태에서 증강 위탁 주소가 주입돼 있으면 GenAiIntegrationWiringGuard 가 <위탁을> 거부한다
#      — 기동은 통과하고 ERROR 로그만 남으며, 거부는 <위탁 시점>에 일어난다(조회·취소는 막지 않는다).
#      ★ 구 서술 「기동을 차단한다(정상 형상 부팅 불가)」는 폐기다(2026-09-03 · ADR-062).
#      docker compose 가 이 키를 주입하므로(base=none, local override=0.0.0.0/0) 보통 비워 둔 채
#      주석으로 남기고, 실제 벤더 송신 대역을 쓸 때만 아래 줄의 주석을 풀어 값을 채운다.
#WEBHOOK_GENAI_ALLOWED_IP_CIDRS=

# ---- 저장소 경로 가드 (co-locate 산출 allowlist) ----
# dirname(RAW_FILE_PATH_NM) 이 이 목록(콤마 구분) 하위일 때만 산출물(비식별 영상·프레임·JSON)을 쓴다.
#   docker-compose 는 아래 값을 기본으로 주입하므로 보통 건드릴 필요가 없다.
#   ⚠ '/' 등 파일시스템 루트를 넣으면 가드가 무력화되므로 **기동이 차단**된다.
#   ⚠ mock-server 의 MOCK_OUTPUT_BASE 와 같은 값이어야 로컬 비식별 목업이 산출된다.
#STORAGE_RAW_MOUNT_ROOTS=/app/storage/raw,/app/storage/deidentified

# 외부 벤더(생성형 AI) 산출물 <읽기> 전용 허용 루트 — 쓰기 allowlist 와 별개 축.
#   목(mock-server)의 MOCK_GENAI_OUTPUT_BASE 트리를 BE 가 읽을 수 있어야 증강 콜백이 통과한다.
#   docker-compose 가 /app/genai-out 을 기본 주입하므로 보통 건드릴 필요가 없다.
#STORAGE_EXTERNAL_READ_ROOTS=/app/genai-out

# ---- CORS ----
# 방법 B(Native): FE dev 서버(vite :5174)가 Origin 헤더를 보내므로 dev origin 을 반드시 허용해야 한다.
#   비워두면 application-local.yml 기본 허용목록까지 '빈 값'으로 덮어써(${VAR:default} 는 set-but-empty 면 빈 값 사용)
#   모든 브라우저 요청이 CORS 403 으로 거부된다.
# 방법 A(Docker): nginx same-origin 프록시라 CORS 미발생 — 아래 localhost origin 은 미사용(무해)이며 비워도 된다.
# 운영(dev/stg/prd): 실제 FE 도메인만 명시.
CORS_ALLOWED_ORIGINS=http://localhost:5174,http://localhost:5173,http://localhost:3000,http://127.0.0.1:5174,http://127.0.0.1:5173,http://127.0.0.1:3000

# ---- ai-server ----
# 기본: mock=false(실추론), cuda. 로컬 외부0개 CPU 실추론은 docker-compose.local.yml override 사용
#   (AI_DEVICE=cpu, ...) — docs/v2-wiki/00-local-setup.md 참조.
# ★ AI_MOCK_MODE 기본값은 false 다(구 기본값 true 폐기 — 2026-08).
#   true 는 "모델을 안 띄운다" 가 아니라 **합성 라벨(person, score=0.9)을 정상 응답처럼 반환**하는
#   모드이고, 가중치 유무보다 우선 적용돼 mock 사유가 무조건 env_mock 으로 보고된다. 예시에서
#   파생한 .env 로 stg/prd 를 띄우면 가짜 라벨이 학습데이터로 저장되므로 기본값을 뒤집었다.
#   배포 환경(ENV=stg|prd)에서 true 를 켜면 ai-server 가 기동을 거부한다(app/startup_guard.py).
#   모델 없이 화면만 돌려볼 때만 개발 머신에서 명시적으로 true 로 바꾼다.
AI_MOCK_MODE=false
AI_DEVICE=cuda
# ★ AI_GPU 는 AI_DEVICE 와 <b>짝이다</b> — 둘 다 켜야 GPU 로 돈다.
#   AI_DEVICE 는 "무엇으로 돌릴지"(런타임 설정), AI_GPU 는 "GPU 판으로 빌드할지"(이미지 조달)다.
#   AI_DEVICE=cuda 인데 AI_GPU=false 로 빌드된 이미지면 컨테이너에 CUDA provider 가 없어
#   <b>예외 없이 조용히 CPU 로 떨어진다</b> — 로그도 안 남아 알아채기 어렵다(2026-09-05 실측).
#   ⚠ 기본값 false 는 의도다: 온프렘 반입이 CPU 전용으로 확정돼 있어
#     (deploy/onprem/docs/11-gpu-migration.md) 그 조달물이 달라지면 안 된다.
#   GPU 장비(예: dev 246)에서는 이 값을 true 로 두고 `docker compose build klid-ai-server` 한다.
#   확인: docker exec klid-ai-server python -c "import torch;print(torch.cuda.is_available())"
AI_GPU=false
# 탐지/트래킹 백엔드: yolo | rtdetr
DETECTOR_BACKEND=yolo

# ---- frontend (빌드 타임 주입 — 개발/컨테이너용 폴백) ----
#  ★ 온프렘 배포에서는 이 값들이 <런타임>에 주입된다. 정본은 대상 서버의
#    /etc/klid/frontend.env 이고, 설치·반영 스크립트가 그것을 읽어 문서 루트에
#    klid-config.js 를 생성한다(deploy/onprem/docs/04-configuration.md C-1 절).
#    앱의 해석 순서는 런타임 → 빌드 → 없음이므로, 여기 값은 런타임 설정이 없는
#    경로(npm run dev · 컨테이너 이미지)에서만 쓰인다.
VITE_API_BASE_URL=/api/v1
# 토큰 인계 채널: 'url' | 'cookie' | 'localStorage' | 'both' | 'all'
#  - 기본값 localStorage — 관제/포털은 동일 origin 브라우저 저장소로 JWT 를 인계한다(ADR-012).
#  - 'url'/'both'/'all' 은 JWT 를 URL 쿼리에 싣는 채널을 연다(접근 로그·리퍼러·히스토리 잔존,
#    CWE-598). 레거시 호환이 꼭 필요할 때만 명시 설정할 것.
VITE_TOKEN_INGRESS=localStorage

# ---- 외부 증강 (생성형 AI, Phase 7-A1) ----
# 「생성형 AI API 연동명세서 v1.1」 정합 위탁(POST /api/genai/jobs). 인증 없음(명세서 확정).
#  - AUGMENT_API_BASE_URL : 벤더/목 서버 base. http|https 만 허용 — 그 외 스키마는 <위탁 시점에 거부>된다.
#    ★ 구 서술 「그 외 스키마는 기동 차단」은 폐기다(2026-09-03 · ADR-062). 비허용 스킴·파싱 불가·
#      예시 호스트·예약 대역 <네 축 모두> 기동을 막지 않고 위탁 시점에 실패한다(기동 시 ERROR 로그).
#    ★ 이 주소가 곧 <연동 여부>다 — 비어 있으면 미연동이고, 그때 기동은 정상이며 위탁 시도 시점에
#      실패한다(요청 접수는 503 으로 즉시 거부). 구 미연동 모드 토글 AUGMENT_EXTERNAL_MODE 는
#      2026-09-03 확정으로 <폐기>됐다 — 되살리지 말 것(읽는 코드가 없어 넣어도 아무 일도 없다).
#    ⚠ 주소를 주입하면 WEBHOOK_GENAI_ALLOWED_IP_CIDRS 도 함께 명시해야 한다 — 짝이 안 맞으면
#      기동은 통과하되 <위탁이 거부>된다(기동 시 ERROR 로그). 구 서술 「기동 차단」은 폐기(ADR-062).
#  docker compose local 은 override 파일이 klid-mock-server:9400 을 주입한다.
#AUGMENT_API_BASE_URL=http://localhost:9400
