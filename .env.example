# ============================================================================
# klid-label 풀스택 배포 환경변수 예시 (docker-compose)
#   - 실제 .env 는 커밋 금지 (.gitignore 에 등록됨).
#   - 시크릿은 배포 서버에서 openssl 등으로 생성해 주입한다.
# ============================================================================

# ---- 프로파일 ----
# base compose 기본값은 dev(= cudo_246 배포 프로파일). 이 값을 설정하지 않으면 dev 로 뜬다.
#   - 로컬 자족 기동(-f docker-compose.local.yml)은 override 가 local 로 고정하므로 이 값과 무관하다.
#   - 롤백: 아래 주석을 풀어 local 로 되돌린다(compose 재기동만으로 원복).
# SPRING_PROFILES_ACTIVE=local
# 주의: ENV 환경변수는 local 스택에서 dev/stg/prd 로 설정하지 말 것 (LocalProfileGuard 부트 차단).

# ---- DB (번들 klid-postgres) ----
CONTROL_DB_NAME=klid_system
PORTAL_DB_NAME=portal
CONTROL_DB_USERNAME=klid_user
# openssl rand -hex 16
CONTROL_DB_PASSWORD=CHANGE_ME
# 포털 DB 자격 — 번들 postgres 는 klid_user 단일 계정이라 control 과 동일 값 사용.
#   방법 B(Native) 에서 필수: 미설정 시 application-local.yml fallback(klid_local_2024)으로
#   번들 docker postgres 인증 실패(portalEntityManagerFactory 부트 차단).
PORTAL_DB_USERNAME=klid_user
PORTAL_DB_PASSWORD=CHANGE_ME   # = CONTROL_DB_PASSWORD 와 동일 값

# ---- JWT (관제/포털 발급 토큰 검증) ----
# openssl rand -hex 48  (>= 256bit)
JWT_SECRET=CHANGE_ME
JWT_ISSUER=klid-auth
JWT_ALLOWED_ISSUERS=klid-auth,klid,klid-portal

# ---- 영상 스트림 서명 시크릿 (JWT_SECRET 과 분리, >= 32B) ----
# openssl rand -hex 32
STREAM_SIGN_SECRET=CHANGE_ME

# ---- 관리자 클레임 비밀번호 해시 (BCrypt cost>=12) ----
# local 프로파일에서만 기본 해시가 있다. **dev 로 뜨면 빈 값 = 관리자 클레임 불가** — 직접 주입할 것.
ADMIN_CLAIM_PASSWORD_HASH=

# ---- 배치 ----
# ⚠ local 프로파일은 yml 이 batch/training-scan 을 끄지만, **dev 는 기본 활성(true)** 이다.
#   아래를 false 로 남겨두면 dev 로 전환해도 파이프라인이 돌지 않는다(자동 적재·배치 미발화).
#   dev 배포: 주석 처리하거나 true 로 둘 것. 로컬 자족 검증: false 유지 가능.
# BATCH_ENABLED=true
# TRAINING_SCAN_ENABLED=true

# ---- 외부 벤더 연동 (mock-server 컨테이너로 실 HTTP) ----
# compose 가 아래 기본값을 이미 주입한다 — 여기서 값을 넣으면 그 값이 우선한다.
#   DEIDENTIFY_MOCK_MODE=false        내부 self-fill(외부 무접촉 원본복사) 금지
#   KPST_DEID_ENABLED=true            비식별 위탁 경로 활성
#   KPST_DEID_BASE_URL=http://klid-mock-server:9400
#   VLM_CLIENT_ENABLED=true           false 면 VLM 단계가 통째로 SKIPPED(결과 0건)
#   VLM_SERVICE_URL=http://klid-mock-server:9400
#   WEBHOOK_CALLBACK_BASE_URL=http://klid-backend:8080/api   (콜백 수신 주소)
# 벤더 실서버 전환 시에는 KPST_DEID_BASE_URL / VLM_SERVICE_URL 만 바꾼다(코드 변경 불요).
CONTROL_NOTIFY_ENABLED=false
# webhook HMAC 시크릿 — 미설정 시 fail-closed (검증 무방)
WEBHOOK_HMAC_SECRET_DEIDENTIFY=
WEBHOOK_HMAC_SECRET_VLM=
WEBHOOK_HMAC_SECRET_AUGMENT=

# ---- CORS ----
# 방법 B(Native): FE dev 서버(vite :5174)가 Origin 헤더를 보내므로 dev origin 을 반드시 허용해야 한다.
#   비워두면 application-local.yml 기본 허용목록까지 '빈 값'으로 덮어써(${VAR:default} 는 set-but-empty 면 빈 값 사용)
#   모든 브라우저 요청이 CORS 403 으로 거부된다.
# 방법 A(Docker): nginx same-origin 프록시라 CORS 미발생 — 아래 localhost origin 은 미사용(무해)이며 비워도 된다.
# 운영(dev/stg/prd): 실제 FE 도메인만 명시.
CORS_ALLOWED_ORIGINS=http://localhost:5174,http://localhost:5173,http://localhost:3000,http://127.0.0.1:5174,http://127.0.0.1:5173,http://127.0.0.1:3000

# ---- ai-server ----
# 기본(서버 GPU): mock=true, cuda. 로컬 외부0개 CPU 실추론은 docker-compose.local.yml override 사용
#   (AI_MOCK_MODE=false, AI_DEVICE=cpu, DETECTOR_BACKEND=rtdetr) — docs/v2-wiki/00-local-setup.md 참조.
AI_MOCK_MODE=true
AI_DEVICE=cuda
# 탐지/트래킹 백엔드: yolo | rtdetr
DETECTOR_BACKEND=yolo

# ---- frontend (빌드 타임 주입) ----
VITE_API_BASE_URL=/api/v1
VITE_TOKEN_INGRESS=all
