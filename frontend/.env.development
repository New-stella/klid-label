VITE_API_BASE_URL=/api/v1
# 개발 환경: 모든 인계 채널 활성 (url + localStorage + cookie).
# /dev/login 이 localStorage 에 klid-jwt-token 을 저장하므로 localStorage 채널 필수.
VITE_TOKEN_INGRESS=all
# 개발 환경에서는 redirect 비활성화 — 18080/18081 미가동 시 ERR_CONNECTION_REFUSED 폭탄 방지
# (운영 환경 .env 에서 실제 도메인으로 채움)
VITE_CONTROL_LOGIN_URL=
VITE_PORTAL_LOGIN_URL=
