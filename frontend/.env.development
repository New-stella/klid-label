VITE_API_BASE_URL=/api/v1
# 개발 환경도 운영과 같은 localStorage 인계 채널만 쓴다.
# /dev/login 이 localStorage 에 klid-jwt-token 을 저장한 뒤 /ingress 로 이동하므로 이 채널로 충분하다
# (dev 진입 동선에 ?token= 쿼리 생산자가 없다). URL 쿼리 채널은 JWT 를 접근 로그·리퍼러·
# 브라우저 히스토리에 남기므로 개발 환경에서도 기본으로 켜지 않는다.
VITE_TOKEN_INGRESS=localStorage
# 개발 환경에서는 redirect 비활성화 — 18080/18081 미가동 시 ERR_CONNECTION_REFUSED 폭탄 방지
# (운영 환경 .env 에서 실제 도메인으로 채움)
VITE_CONTROL_LOGIN_URL=
VITE_PORTAL_LOGIN_URL=
