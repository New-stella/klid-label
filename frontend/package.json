{
  "name": "klid-la-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:control": "tsc -b && VITE_BUILD_CHANNEL=control vite build",
    "build:portal": "tsc -b && VITE_BUILD_CHANNEL=portal vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write \"src/**/*.{ts,tsx,json,css}\"",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:install": "playwright install --with-deps chromium",
    "gen-api": "bash scripts/gen-api-types.sh"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-checkbox": "1.3.11",
    "@radix-ui/react-select": "2.3.7",
    "@tanstack/react-query": "^5.28.0",
    "@tanstack/react-table": "8.21.3",
    "axios": "^1.6.0",
    "clsx": "^2.1.0",
    "d2coding": "^1.3.2",
    "date-fns": "^4.1.0",
    "dayjs": "^1.11.20",
    "konva": "^10.3.1",
    "lucide-react": "^1.34.0",
    "pretendard-gov": "^1.3.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.75.0",
    "react-konva": "^19.2.5",
    "react-router-dom": "^6.22.0",
    "recharts": "^3.8.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^3.22.0",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.4.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.5.0",
    "@types/node": "^20.11.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@typescript-eslint/eslint-plugin": "^7.2.0",
    "@typescript-eslint/parser": "^7.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "axe-core": "^4.13.0",
    "axios-mock-adapter": "^1.22.0",
    "eslint": "^8.57.0",
    "eslint-import-resolver-typescript": "^3.6.3",
    "eslint-plugin-import": "^2.29.0",
    "eslint-plugin-jsx-a11y": "^6.8.0",
    "eslint-plugin-react": "^7.34.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "jsdom": "^24.0.0",
    "openapi-typescript": "^6.7.0",
    "postcss": "^8.4.0",
    "prettier": "^3.2.0",
    "tailwindcss": "^4.3.3",
    "tailwindcss-v3-compat": "npm:tailwindcss@^3.4.19",
    "typescript": "^5.4.0",
    "vite": "^5.2.0",
    "vitest": "^1.4.0",
    "vitest-axe": "^0.1.0"
  }
}
