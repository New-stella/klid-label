# 증적 촬영 설정 — `capture.env` 로 복사해 값을 채운다.
#
# ★ ID 는 서버마다 다르다. 남의 서버 값을 그대로 쓰면 <없는 영상·없는 프레임>을 열고도
#   그럴듯한 화면이 찍힌다. 반드시 그 서버에서 실제 값을 확인해 넣는다.

# 증적은 1920×1080 화면 한 장이다. 스크롤 분할·fullPage 는 쓰지 않는다(2026-09-09 확정).
# 검증 대상이 첫 화면 아래면 부분 캡처로 그 자리만 찍는다. 이 값을 올리면 폐기된 분할이 돌아온다.
CAPTURE_MAX_PAGES=1

# 앱 주소 (배포 베이스 경로까지 포함한다)
CAPTURE_APP=http://192.168.102.246:8088/label-studio

# 촬영 결과를 쌓을 폴더 (원장은 이 폴더의 부모에 생긴다)
CAPTURE_OUT=/Users/ck/Desktop/CBD-캡처루트-20260906/captures

# 마킹 대상 영상 번호 (LS_DATA_RAW.RAW_SN)
CAPTURE_RAW_SN=26

# 검수 대상 <검수 번호> — 영상 번호가 아니다
CAPTURE_REVIEW_ID=1

# 프레임 번호 (LS_DATA_SRC.SRC_SN) — 용도별로 다른 프레임을 쓴다.
# ⚠ 작업자에게 <배정된 영상>의 프레임이어야 한다. 아니면 화면이 403 으로 막히는데,
#   그것은 결함이 아니라 정상 인가 동작이다. 아래 질의로 고른다:
#     SELECT s.src_sn, s.raw_sn FROM klid_at.ls_data_src s
#       JOIN klid_at.ls_task_altmnt a ON a.raw_data_id = s.raw_sn AND a.task_type_cd='LABELER'
#      WHERE a.user_no = '<작업자 번호>' ORDER BY s.src_sn;
CAPTURE_FRAME_MAIN=1
CAPTURE_FRAME_AI=5
CAPTURE_FRAME_META=13

# 적재 케이스(018-01)가 기다리는 클립 이름
CAPTURE_INGEST_CLIP=CCTV-019

# 수동 마킹을 찍을 시점(초) — 대상이 또렷한 구간을 <영상을 실제로 보고> 고른다.
# 임의로 고르면 빈 캔버스가 라벨링 증적으로 남는다.
CAPTURE_MARK_SECONDS=96,100,104,108,112,116

# 추적·보간 촬영용 프레임 — 라벨이 <드문> 프레임이어야 한다.
# 촘촘한 프레임을 쓰면 새 검출이 기존 라벨과 겹쳐 반영되지 않아 아무 일도 안 일어난 것처럼 보인다.
CAPTURE_FRAME_TRACK=40
CAPTURE_FRAME_TRACK_NEXT=41

# ── 포털 채널 (포털 케이스 024·027 에만 쓴다) ──────────────────────────────
# ⚠ 포털 화면은 포털 채널 산출물에만 있다. 관제 채널 배포본에는 그 라우트가 번들에 아예 없어
#   404 다(런타임 잠금이 아니다). 그래서 포털 채널로 띄운 앱을 따로 가리켜야 한다.
#
#   ① Origin 을 떼는 로컬 중계를 띄운다 — 브라우저 Origin 이 서버 CORS 허용목록에 없어 403 이 난다
#        set -a; . ./capture.env; set +a
#        node capture-origin-proxy.mjs &                 # :15174 → CAPTURE_APP 이 가리키는 서버
#      (실측: 같은 요청을 직접 보내면 403, 중계를 거치면 401 — Origin 없는 요청과 같아진다)
#   ② 포털 채널 FE 를 띄운다
#        BACKEND_ORIGIN=http://localhost:15174 VITE_BUILD_CHANNEL=portal npx vite --port 15173
#   ③ 그 주소를 여기 넣는다
CAPTURE_PORTAL_APP=http://localhost:15173
