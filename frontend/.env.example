VITE_API_BASE_URL=/api/v1
# 토큰 인계 채널 전략: 'url' | 'cookie' | 'localStorage' | 'both' | 'all'
# - 미설정 시 기본값은 'localStorage' (관제서버 표준 키 klid-jwt-token)
# - 전 환경 'localStorage' 권고 — /dev/login 헬퍼도 이 채널로 인계한다
# - 'url'/'both'/'all' 은 JWT 를 URL 쿼리에 싣는 채널을 연다(접근 로그·리퍼러·히스토리 잔존).
#   레거시 호환이 꼭 필요할 때만 명시 설정할 것.
VITE_TOKEN_INGRESS=localStorage
VITE_CONTROL_LOGIN_URL=https://control.example.local/login
VITE_PORTAL_LOGIN_URL=https://portal.example.local/login

# 빌드 채널: 'control' | 'portal' (미설정 시 'control' — 지금 동작 유지)
# - control: 관제 채널. 자체 셸(헤더 등) 포함 독립 앱으로 빌드 (기본값)
# - portal: 포털 Host 셸(Module Federation Remote)에 임베드될 산출물 — PortalLayout 의
#   자체 헤더를 렌더하지 않는다(Host 가 이미 자기 헤더를 갖는다).
#   npm run build:control / npm run build:portal 로 채널별 빌드.
# VITE_BUILD_CHANNEL=control

# --- Vite dev 서버 배포 (컨테이너/네트워크) 전용 ---
# 미설정 시 로컬 개발 기본값(http://localhost:8080, HMR 기본 동작) 보존.
# 프록시 대상 BE 오리진 (컨테이너: http://klid-backend:8080)
# BACKEND_ORIGIN=http://localhost:8080
# HMR 클라이언트 접속 외부 매핑 포트 (컨테이너 13000:5174 매핑 시 13000)
# HMR_CLIENT_PORT=13000
