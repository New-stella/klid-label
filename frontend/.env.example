VITE_API_BASE_URL=/api/v1
# 토큰 인계 채널 전략: 'url' | 'cookie' | 'localStorage' | 'both' | 'all'
# - 운영(stg/prd): 단일 채널 명시 권고 (예: localStorage — 관제서버 표준 키 klid-jwt-token)
# - 개발(local/dev): 'all' 권고 — /dev/login 헬퍼와 운영 시나리오 동시 지원
VITE_TOKEN_INGRESS=localStorage
VITE_CONTROL_LOGIN_URL=https://control.example.local/login
VITE_PORTAL_LOGIN_URL=https://portal.example.local/login

# --- Vite dev 서버 배포 (컨테이너/네트워크) 전용 ---
# 미설정 시 로컬 개발 기본값(http://localhost:8080, HMR 기본 동작) 보존.
# 프록시 대상 BE 오리진 (컨테이너: http://klid-backend:8080)
# BACKEND_ORIGIN=http://localhost:8080
# HMR 클라이언트 접속 외부 매핑 포트 (컨테이너 13000:5174 매핑 시 13000)
# HMR_CLIENT_PORT=13000
