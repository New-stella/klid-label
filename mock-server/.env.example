# mock-server 환경변수 예시 (접두사 MOCK_)
# 외부 벤더(KPST 비식별 / IntelliVIX VLM / 증강 AI) API를 흉내내는 로컬/테스트 전용 목 서버.
# ⚠ 인증 없음 + VLM 콜백 SSRF 표면 — 운영/외부망 노출 금지. 신뢰된 네트워크에서만 기동할 것.

# 서버 바인딩
MOCK_HOST=0.0.0.0
MOCK_PORT=9400                     # ai-server(9300)와 충돌 회피

# 시뮬레이션 파라미터
MOCK_SIM_SPEED_FACTOR=1.0          # KPST 진행률 배속. 클수록 progressRate가 빨리 100에 도달
MOCK_CALLBACK_DELAY_SECONDS=2.0    # VLM 콜백 전송 지연(초). 0 이면 즉시 발사(테스트용)

# KPST 더미 비식별 출력 파일 생성
#   파일명 규칙(실서버 실측 계약): {원본stem}-mask{확장자}  (예: 001.mp4 → 001-mask.mp4)
#   retrieve_progress 의 fileName 은 <원본 입력파일 경로>이고, 산출물명은 위 마스킹명이다(서로 다름).
#   기존 파일은 덮어쓰지 않는다(no-overwrite). 실제 생성은 아래 두 값이 모두 참일 때만.
MOCK_WRITE_OUTPUT_FILES=true       # POST /project 시 {export_path}/{마스킹명} 더미 파일 생성(기본 on)
# ⚠ 필수: 미설정('')이면 fail-closed — 어떤 파일도 생성하지 않는다(임의 절대경로 쓰기 차단).
#   e2e 시 Spring Boot 의 STORAGE_RAW_MOUNT_ROOTS 와 **동일 값**(콤마 구분 다중 허용)을 지정해야 한다 —
#   co-locate(Phase 5A) 이후 BE 가 넘기는 export_path 는 {dirname(원본)}/{rawSn}/deid/ 라
#   비식별 저장소가 아니라 <원본이 놓인 마운트 루트> 하위다.
MOCK_OUTPUT_BASE=                  # 쓰기 허용 루트(콤마 구분). export_path 가 resolve 후 이 중 하나의 하위일 때만 생성
# 복사 원본(input_path) 읽기 허용 루트(콤마 구분). 목은 인증이 없어 input_path 를 임의 지정할 수 있으므로
#   허용 루트 밖의 파일은 복사하지 않고 placeholder 로 대체한다(임의 파일 노출·디스크 고갈 차단).
#   미설정이면 MOCK_OUTPUT_BASE 각 항목의 상위(= 공용 storage 루트)를 자동 사용한다.
MOCK_INPUT_BASE=                   # 예: /app/storage (raw/ 와 deidentified/ 의 공통 루트)

# VLM 콜백 outbound 허용 호스트(SSRF 방어, CWE-918) — 콤마 구분.
#   목록 밖 호스트가 callback_url 로 오면 400 으로 거부하고 outbound 를 발사하지 않는다.
MOCK_CALLBACK_ALLOWED_HOSTS=klid-backend,localhost,127.0.0.1

# ── 생성형 AI(증강) 목 — 「생성형 AI API 연동명세서 v1.1」 (/api/genai/*) ──
# 상태머신: RECEIVED → RUNNING(전처리→추론→후처리) → SUCCEEDED | FAILED | CANCELED
#   단계마다 요청 바디의 callback_url 로 ② Webhook 을 POST 한다.
#   FAILED 트리거(목): request_id 가 "fail"(대소문자 무시)로 시작하면 MODEL_EXECUTION_FAILED.
MOCK_GENAI_STEP_DELAY_SEC=2.0      # 단계 간 지연(초). 0 이면 즉시 진행(테스트용)

# ⚠ 필수: 미설정('')이면 fail-closed — 결과 파일을 만들지 않고 FAILED(RESULT_SAVE_FAILED).
#   결과는 {base}/genai/{job_id}/ 하위에만 생성된다(임의 절대경로 쓰기 차단, CWE-22).
MOCK_GENAI_OUTPUT_BASE=            # 결과 파일 쓰기 허용 루트 (예: /nas-storage)
# ⚠ INPUT_BASE 도 fail-closed — 이것과 OUTPUT_BASE 가 모두 비면 input_files 는 전부 400 이다.
#   두 base 를 같은 디렉터리로 두면 "목 산출물 쓰기 권한 = 입력 읽기 권한"이 되므로 분리 권장.
MOCK_GENAI_INPUT_BASE=             # input_files[].file_path 허용 루트. 미설정 시 OUTPUT_BASE 사용

# SSRF(CWE-918) — callback_url / status-sync 대상 allowlist(콤마 구분).
#   항목은 host:port 또는 host 형태. 포트를 적으면 그 포트만, 생략하면 모든 포트를 허용(하위호환).
#   IPv6 는 [::1]:8080 처럼 대괄호로 감싼다. 스킴은 http|https 만 허용.
#   목 서버 자신(루프백/바인드 호스트 + MOCK_PORT)은 allowlist 에 있어도 거부한다(자기 SSRF 차단).
#   목록 밖은 접수 시 400 INVALID_PARAMETER. 빈값이면 fail-closed(모두 차단).
#   '*' 를 넣으면 호스트/포트 검사 생략 — 로컬 실험 외 사용 금지.
MOCK_GENAI_CALLBACK_ALLOW_HOSTS=localhost:8080,127.0.0.1:8080,[::1]:8080,host.docker.internal:8080,klid-backend:8080,backend:8080

# (선택) 콜백 대상 경로 접두사 allowlist(콤마 구분). 빈값이면 경로 제한 없음.
#   예: /api/genai/ 로 두면 내부망 다른 API 로의 POST 릴레이를 막는다(SSRF 심층 방어).
MOCK_GENAI_CALLBACK_PATH_PREFIXES=
# (선택) 목 서버 자신을 가리키는 추가 호스트 별칭(콤마 구분). 컨테이너/서비스명 등.
MOCK_GENAI_SELF_HOST_ALIASES=

# ③ 상태 동기화(§4.3) — 목 전용 수동 트리거 대상 **base URL**.
#   목은 여기에 /api/genai/jobs/{job_id}/status-sync 를 붙여 POST 한다.
#   미설정이면 비활성(목이 수신측 주소를 유추하지 않음). 자동 발신은 ② Webhook 만.
MOCK_GENAI_STATUS_SYNC_URL=

MOCK_GENAI_EVENT_TYPES=            # 허용 evnt_type(콤마 구분). 빈값=검증 안 함(모두 허용)
MOCK_GENAI_MAX_INPUT_BYTES=5368709120   # 입력 파일 1건 크기 상한. 접수 시 + 처리 시 재검증(413 GA-MEDIA-001)
MOCK_GENAI_WEBHOOK_MAX_ATTEMPTS=2       # webhook 전송 시도 횟수 상한(무한 재시도 금지)
MOCK_GENAI_WEBHOOK_RETRY_DELAY_SEC=0.5  # webhook 재시도 간 지연(초). 0 이면 즉시(테스트용)

# 자원 고갈 방어(CWE-770/400)
MOCK_GENAI_MAX_BODY_BYTES=1048576       # 요청 본문 크기 상한(1MiB). 초과 시 413 GA-MEDIA-001
MOCK_GENAI_MAX_PROMPT_BYTES=65536       # prompt 직렬화 크기 상한(64KiB). 초과 시 400 INVALID_METADATA
MOCK_GENAI_MAX_JOBS=1000                # 인메모리 잡 보관 상한. 초과 시 오래된 작업부터 만료(FIFO)

# CORS — 콤마 구분 오리진 목록. 로컬은 * 허용, prd(노출 금지)에서는 Spring Boot 도메인만.
MOCK_CORS_ORIGINS=*
