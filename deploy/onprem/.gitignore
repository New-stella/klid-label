# ============================================================================
# 온프렘 패키지 대용량 산출물 무시 — package.sh 가 빌드머신에서 채운다.
#   스크립트/문서/설정 템플릿/디렉토리 골격(.gitkeep)만 git 에 보관한다.
# ============================================================================

# 빌드 아티팩트
#   *.war = 반입 정본(api.war — 외부 WAS 반입, @design DEPLOY-001)
#   *.jar = 개발 환경 전용(klid-backend.jar — 반입 대상 아님. 설치가 배치하지 않고,
#           수집도 WITH_BACKEND_JAR=1 일 때만 한다 — 2026-08-30 매체에서 제외)
artifacts/backend/*.jar
artifacts/backend/*.war
artifacts/frontend/dist/
artifacts/ai-server/app/
artifacts/ai-server/tests/
artifacts/ai-server/requirements.txt
artifacts/ai-server/requirements.in

# 런타임 바이너리
#   ⚠ runtimes/jdk 는 <더 이상 채워지지 않지만> 골격을 남긴다 — 자바 런타임 미반입
#     (2026-08-30 — 대상 WAS 가 Tomcat 10.1.x + Java 17 로 이미 구동). 수집 단계
#     (40-collect-runtimes.sh)가 이전 판의 JRE tarball 잔재를 여기서 검사하므로 자리가 필요하다.
#   ⚠ runtimes/caddy 는 <삭제했다>(2026-08-30). 웹 서버가 배포판 httpd RPM 으로 전환되며
#     Caddy 가 폐기됐고(2026-08-19), 그 뒤 이 디렉터리를 채우거나 검사하는 스크립트가 0건이라
#     빈 골격이 반입 매체에 남아 있을 근거가 없었다. 구 사유 "베어메탈 복귀 시 수집 스크립트가
#     쓰는 자리"는 caddy 에 대해서는 사실이 아니었다(그 수집 코드 자체가 없다).
runtimes/jdk/*
runtimes/python/*

# pip wheel / sam2 소스
vendor/wheels/*
vendor/sam2/sam2-src/

# 모델/가중치/HF 캐시
models/weights/*
models/hf-cache/*

# 시스템 패키지 (RHEL 8.9 / el8: 전부 RPM — ffmpeg 포함).
#   ⚠ 구 서술 폐기(2026-08-28): "Rocky 9: RPM + 정적 ffmpeg".
#   repodata/ 는 createrepo_c 가 만드는 로컬 저장소 메타데이터, gpg/ 는 반입 GPG 공개키다.
syspkgs/rpm/*.rpm
syspkgs/rpm/repodata/
syspkgs/rpm/SHA256SUMS
syspkgs/rpm/README-collect-on-el8.txt
syspkgs/rpm/README-collect-on-rocky9.txt
syspkgs/ffmpeg/*
syspkgs/gpg/
# GPL 대응 소스(SRPM) — 설치 대상이 아니라 라이선스 의무 충족용 동봉물이다(약 11MB).
#   50-collect-syspkgs.sh 가 채운다. git 에는 넣지 않는다.
syspkgs/ffmpeg-src/*

# PostgreSQL 16 RPM (PGDG, 번들 PG 옵션) — 대용량이라 git 제외. 55-collect-postgresql.sh 가 채운다.
syspkgs/postgresql/*.rpm
syspkgs/postgresql/repodata/
syspkgs/postgresql/SHA256SUMS
syspkgs/postgresql/README-collect-on-el8.txt
syspkgs/postgresql/README-collect-on-rocky9.txt

# 오프라인 빌드 키트(소스 재빌드용) — 대용량이라 git 제외.
#   ⚠ 2026-08-30 부터 <기본 수집 대상이 아니다>(현장 재빌드 요구 없음). 60-collect-buildtools.sh 는
#     WITH_BUILDTOOLS=1 일 때만 실행되며, 그때만 아래 경로가 채워진다.
buildtools/jdk/*
buildtools/node/*
buildtools/gradle/*
buildtools/gradle-home/*
buildtools/frontend-node_modules.tar.gz
# 빌드용 소스 사본(src/) — repo 본체와 중복이라 git 제외(.gitkeep 만 보존).
src/*

# 체크섬·메타
**/SHA256SUMS
VERSION.built

# .gitkeep 은 보존
!**/.gitkeep

# ---- 라이선스 고지 (2026-08-30 신설) ----------------------------------------
#   ★ 수집·빌드 시점에 <실제 반입물에서 긁어> 만드는 것은 git 에 두지 않는다. 손으로 적은
#     목록이 낡는 것을 막으려고 자동화한 것이므로, 사본을 git 에 두면 그 사본이 낡는다.
#   ★ 반대로 <사람이 채우는 것>은 반드시 git 에 둔다 — 자동 수집으로 복원할 수 없다.
#     licenses/README.md · NOTICE.header.txt · manual/** 가 그것이다(아래 예외 규칙).
licenses/backend/
licenses/frontend/
licenses/python-packages/
licenses/python-runtime/
# (L)GPL 대응 소스 — 65-collect-copyleft-sources.sh 가 받는다(약 67MB). 목록은 manual/ 에 있다.
licenses/copyleft-sources/
# 70-generate-notices.sh 산출물
licenses/NOTICE
licenses/ALL.tsv
licenses/INVENTORY.md
licenses/UNRESOLVED.md

# 사람이 채우는 것은 지키다(위 무시 규칙보다 뒤에 와야 한다).
!licenses/README.md
!licenses/NOTICE.header.txt
!licenses/manual/
!licenses/manual/**
