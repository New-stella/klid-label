# ============================================================================
# 온프렘 패키지 대용량 산출물 무시 — package.sh 가 빌드머신에서 채운다.
#   스크립트/문서/설정 템플릿/디렉토리 골격(.gitkeep)만 git 에 보관한다.
# ============================================================================

# 빌드 아티팩트
artifacts/backend/*.jar
artifacts/frontend/dist/
artifacts/ai-server/app/
artifacts/ai-server/tests/
artifacts/ai-server/requirements.txt
artifacts/ai-server/requirements.in

# 런타임 바이너리
runtimes/jdk/*
runtimes/python/*
runtimes/caddy/*

# pip wheel / sam2 소스
vendor/wheels/*
vendor/sam2/sam2-src/

# 모델/가중치/HF 캐시
models/weights/*
models/hf-cache/*

# 시스템 패키지 (Rocky 9: RPM + 정적 ffmpeg).
syspkgs/rpm/*.rpm
syspkgs/rpm/README-collect-on-rocky9.txt
syspkgs/ffmpeg/*

# 오프라인 빌드 키트(소스 재빌드용) — 대용량이라 git 제외. 60-collect-buildtools.sh 가 채운다.
buildtools/jdk/*
buildtools/node/*
buildtools/gradle/*
buildtools/gradle-home/*
buildtools/frontend-node_modules.tar.gz
# 빌드용 소스 사본(src/) — repo 본체와 중복이라 git 제외(.gitkeep 만 보존).
src/*

# 체크섬·메타
**/SHA256SUMS
VERSION.built

# .gitkeep 은 보존
!**/.gitkeep
