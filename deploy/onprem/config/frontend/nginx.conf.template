# ============================================================================
# nginx.conf — (대안) 기존 nginx 보유 서버용 사이트 설정
#   USE_NGINX=1 로 설치 시 /opt/klid/web/nginx.conf 로 배치된다(서비스 자동 등록 X).
#
#   원본 frontend/nginx.conf 와의 차이:
#     - root: 컨테이너 경로(/usr/share/nginx/html) → 베어메탈 설치 경로
#     - proxy_pass: http://klid-backend:8080 → http://127.0.0.1:8080
#
#   적용: 이 server 블록을 기존 nginx 의 sites-available/ 또는 conf.d/ 에 반영 후
#         nginx -t && systemctl reload nginx
# ============================================================================
server {
    listen       80;
    server_name  _;
    root         /opt/klid/web/dist;
    index        index.html;

    # 보안 헤더
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    # 앞단에서 TLS 종단(HTTPS)을 둘 경우에만 아래 HSTS 를 주석 해제한다(평문 :80 에서는 금지).
    # add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    # 대용량 업로드 허용 — backend 한도(spring.servlet.multipart.max-request-size)와 정렬.
    #   ★ 앞단이 서버보다 좁으면 그 사이 크기의 요청은 **서버에 닿기도 전에** 프록시가 거부해,
    #     앱이 만든 413(ApiResponse + errorCode)이 아니라 프록시 기본 오류 페이지가 나가고 서버
    #     로그에는 아무 흔적도 남지 않는다. 판정은 언제나 서버가 하게 둔다.
    #   ★ 왜 512m 가 아니라 1200m 인가 — 512MB 를 **정당하게** 넘는 요청이 실재한다.
    #     포털 이미지 다중 업로드(POST /v1/portal/uploads/images)는 확정 계약상 개당 20MB × 요청당
    #     50장이라 한 요청이 최대 1,000MB 다. 운영(prd)의 서버 한도 1100MB 가 정확히 그 계약에서
    #     나온 값이다(50×21MB + 헤드룸). 재개 업로드(TUS)는 청크가 16MB 라 이 축과 무관하다.
    #     따라서 좁힐 쪽은 서버가 아니라 넓힐 쪽이 앞단이며, 값은 **서버 한도 중 최댓값**(공통 1200MB)에
    #     맞춘다 — 운영에서는 서버가 1100MB 에서 자기 형식의 413 을 낸다.
    #   ⚠ Caddyfile.template 과 **같은 값**을 유지할 것(두 배포 형상). 회귀 고정:
    #     backend EdgeRequestSizeAlignmentGuardTest.
    client_max_body_size 1200m;

    # API 프록시 — backend context-path 가 /api 이므로 경로 그대로 전달.
    #   FE 는 VITE_API_BASE_URL=/api/v1 로 호출 → /api/v1/... → backend /api + /v1/...
    location /api/ {
        proxy_pass         http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        # 영상 스트림(Range) / 대용량 응답
        proxy_buffering    off;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    # SPA fallback
    location / {
        try_files $uri $uri/ /index.html;
    }
}
