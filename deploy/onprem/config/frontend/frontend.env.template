# ============================================================================
# klid-label 프론트엔드 런타임 설정 — <이 파일이 정본이다>
#   설치 위치: /etc/klid/frontend.env
#
#   백엔드가 DB 접속정보를 산출물이 아니라 /etc/klid 에서 읽는 것과 같은 관례다. 프론트엔드도
#   환경마다 다른 값을 여기서 읽는다 — 값을 바꾸는 데 <재빌드도 재설치도 필요 없다>.
#
#   반영 절차(한 줄):
#       sudo /opt/klid/bin/klid-frontend-config
#     이 명령이 이 파일을 읽어 웹 문서 루트에 klid-config.js 를 생성한다. 브라우저는 그 파일을
#     번들보다 먼저 읽어 아래 값을 쓴다. 웹 서버 재기동도 필요 없다(캐시 금지 헤더가 걸려 있다).
#
#   ★★ 여기 적는 값은 <브라우저로 그대로 내려간다>. 비밀값을 넣지 마라.
#      DB 비밀번호·JWT 시크릿·웹훅 서명값은 application.properties / backend.env 에 둔다.
#      생성기는 아래에 열거된 키만 내보내지만(allowlist), 그것이 "여기에 비밀값을 둬도 된다"는
#      뜻은 아니다 — 목록에 새 키를 추가하는 순간 그 값도 공개된다.
#
#   ⚠ 값 뒤에 같은 줄 주석(`KEY=값 # 설명`)을 붙이지 마라 — 그 뒤까지 <값의 일부>로 읽힌다.
#     설명은 값 줄 <위>에 따로 적는다. (URL 조각 `#fragment` 을 값에 쓸 수 있게 남긴 여지다.)
#   ⚠ 값을 지우면 그 항목은 <빌드 시점 기본값>으로 떨어진다. 아래 두 로그인 주소만은 예외로
#     비어 있으면 생성 자체가 실패한다(설정 누락을 배포 후가 아니라 지금 드러내기 위함).
# ============================================================================

# ---- 필수: 배포 향 선언 -------------------------------------------------------
#   같은 산출물이 <관제 연동>과 <포털 연동> 두 벌로 배포되고, 두 배포는 서로 다른 인프라에
#   놓인다(웹·WAS·DB 가 전부 다르다). 아래 두 로그인 주소 중 <무엇이 필수인지>를 이 값이 정한다.
#     control : 관제 연동 배포 — 들어오는 사용자가 내부 사용자뿐이라 포털 주소를 쓰지 않는다
#     portal  : 포털 연동 배포 — 그 반대다
#   ⚠ 이 값은 <브라우저로 내려가지 않는다>. 설치·생성 시점 판정에만 쓰인다.
#   ⚠ 비워 두면 종전대로 <둘 다> 요구한다(모르는 형상을 느슨하게 통과시키지 않는다).
#     control·portal 외의 값을 적으면 생성기가 즉시 실패한다.
KLID_DEPLOY_FLAVOR=@DEPLOY_FLAVOR@

# ---- 필수: 상위 시스템 로그인 주소 --------------------------------------------
#   저작도구는 자체 로그인 UI 가 없다. 세션 만료·401 이면 이 주소로 이동한다.
#   반드시 http:// 또는 https:// 로 시작해야 한다(스킴이 없으면 브라우저가 상대경로로
#   해석해 저작도구 자기 자신으로 되돌아온다).
#   ★ 위 배포 향에 <해당하는 것만> 채우면 된다. 해당하지 않는 쪽은 요구하지 않으며,
#     그 배포에서는 실제로 한 번도 쓰이지 않으므로 억지로 채우지 않는 편이 낫다.
VITE_CONTROL_LOGIN_URL=@CONTROL_LOGIN_URL@
VITE_PORTAL_LOGIN_URL=@PORTAL_LOGIN_URL@

# ---- API base ----------------------------------------------------------------
#   웹 서버(httpd)가 /api 를 백엔드로 프록시하므로 동일 origin 상대경로가 기본이다.
#   백엔드를 다른 호스트에 두는 구성에서만 절대 주소로 바꾼다(그 경우 CORS 도 함께 열어야 한다).
VITE_API_BASE_URL=/api/v1

# ---- 토큰 인계 채널 ------------------------------------------------------------
#   'localStorage' | 'cookie' | 'both' | 'all' | 'url'
#   기본값 localStorage — 관제/포털은 동일 origin 브라우저 저장소로 JWT 를 인계한다(ADR-012).
#   ⚠ 'url'/'both'/'all' 은 JWT 를 URL 쿼리에 싣는 채널을 연다. 그 토큰은 웹서버 접근 로그·
#     리퍼러 헤더·브라우저 히스토리에 남아 사후 회수가 불가능하다(CWE-598). 레거시 호환이
#     꼭 필요한 현장에서만 바꾼다.
VITE_TOKEN_INGRESS=localStorage

# ---- 개발/검수용 화면 노출 -------------------------------------------------------
#   /dev/login   : 관제서버가 아직 붙지 않은 브링업 구간에서 토큰을 직접 발급받는 화면.
#                  ★ 브링업이 끝나면 false 로 바꾸고 위 반영 명령을 다시 실행할 것.
#                    (백엔드도 authoring.dev.login.enabled 로 따로 막혀 있어 운영에서는 404 다.
#                     화면만 남아 있으면 운영자가 "왜 안 되나"를 묻게 된다.)
#   /admin/uploads: 영상 업로드 화면. 상시 기능이라 보통 true 로 둔다.
#                  ★ 백엔드 DEV_UPLOAD_ENABLED 와 <함께> 꺼야 한다. 한쪽만 끄면 화면과 API 중
#                    하나만 사라져 원인을 찾기 어렵다.
VITE_DEV_LOGIN_ENABLED=true
VITE_DEV_UPLOAD_ENABLED=true
