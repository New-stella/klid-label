# klid-ai-server — FastAPI AI 추론 서버 (Python 3.11, CPU)
#   설치 시 @KLID_*@ 플레이스홀더가 치환된다(install/13-install-ai-server.sh).
[Unit]
Description=klid-label ai-server (FastAPI / uvicorn)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@KLID_USER@
Group=@KLID_GROUP@
WorkingDirectory=@KLID_PREFIX@/ai
EnvironmentFile=@KLID_ETC@/ai-server.env
# venv 의 uvicorn 으로 app.main:app 기동 (포트 9300 고정)
#   ai-server 는 인증 없는 추론 서버 — 동일 호스트 backend(127.0.0.1)만 호출하면 충분하므로
#   loopback 에만 바인드해 공격면을 최소화한다.
#   backend 와 ai-server 가 다른 호스트로 분리되는 경우에만 바인드 주소(0.0.0.0 등)와
#   방화벽 규칙을 함께 조정한다.
ExecStart=@KLID_PREFIX@/ai/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 9300
Restart=on-failure
RestartSec=10
# 모델 로드(onnxruntime/torch) 초기화 여유
TimeoutStartSec=180
TimeoutStopSec=30
StandardOutput=journal
StandardError=journal
SyslogIdentifier=klid-ai-server

# ---- 하드닝 ----
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true
ReadWritePaths=@KLID_PREFIX@/ai/.hf-cache

[Install]
WantedBy=multi-user.target
