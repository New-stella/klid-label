# klid-backend — Spring Boot 메인 애플리케이션 (Java 17)
#
# ★★ 이 유닛은 <베어메탈 형상(java -jar)> 전용이며 <WAR 반입 형상에서는 쓰이지 않는다>.
#   확정 배포 형상은 <외부 WAS 에 api.war 반입>이고(@design DEPLOY-001 · RUNBOOK-001,
#   2026-08-30 사용자 확정), 그 형상에서 백엔드 프로세스의 수명주기는 WAS 가 소유한다.
#   그래서 install/12-install-backend.sh 는 이 유닛을 <기본적으로 설치하지 않는다>
#   (INSTALL_BACKEND_SYSTEMD_UNIT=1 로 명시할 때만 설치).
#
#   ★★ 되살려 쓰기 전에 <실행 jar 부터 마련해야 한다> — 2026-08-30 부터 klid-backend.jar 는
#     반입 대상이 아니라서 <기본 매체에 없다>(수집 단계가 만들지도 담지도 않는다).
#     → 빌드머신에서  WITH_BACKEND_JAR=1 ./scripts/package.sh  로 재수집한 매체가 있어야 한다.
#       없이 INSTALL_BACKEND_SYSTEMD_UNIT=1 로 설치하면 12-install-backend.sh 가 <사유와 함께
#       실패>한다(설치만 끝나고 기동이 안 되는 상태를 만들지 않기 위함).
#     ⚠ 아래 자바 부재와 <별개 조건>이다. 둘 다 채워야 이 유닛이 뜬다.
#
#   ★★ 되살려 쓰기 전에 <자바부터 마련해야 한다> — 지금 이 유닛은 그대로는 뜨지 않는다.
#     패키지는 2026-08-30 부터 JRE 를 반입하지 않으므로 아래 ExecStart 의
#     @KLID_PREFIX@/runtime/jre 는 <설치되지 않는 경로>다.
#     → 그래서 INSTALL_BACKEND_SYSTEMD_UNIT=1 로 설치하면 <설치는 성공하고 기동만 실패>한다.
#       아래 ExecStartPre 가 그 부재를 기동 전에 먼저 알린다(사유 없는 종료를 막기 위함).
#
#     복구 방법은 둘 중 하나다 — 어느 쪽이든 이 유닛을 고치기 <전에> 끝내야 한다:
#       (A) JRE 반입을 되살린다 — package/40-collect-runtimes.sh 의 JDK 수집과
#           install/11-install-runtimes.sh 의 압축해제 배선을 함께 복원해
#           @KLID_PREFIX@/runtime/jre/bin/java 가 생기게 한다(install.sh 의 무결성 검증
#           목록에도 runtimes/jdk 를 다시 넣는다).
#       (B) 장비에 이미 있는 자바를 쓴다 — 예를 들어 WAS 의 JAVA_HOME 을 가리키도록
#           아래 ExecStart 와 ExecStartPre 의 경로를 <둘 다> 같은 값으로 바꾼다.
#           (Java 17 이어야 한다. 한쪽만 바꾸면 가드가 엉뚱한 경로를 검사한다.)
#     운영 절차는 docs/09-operations-runbook.md §0-3 참조.
#   ⚠ 파일을 지우지는 않는다 — 베어메탈 형상으로 되돌릴 때의 기준값이 여기 말고는 없다.
#   ⚠ ai-server(klid-ai-server.service)와 httpd 유닛은 이 형상에서도 그대로 필요하다.
#
#   설치 시 @KLID_*@ 플레이스홀더가 치환된다(install/12-install-backend.sh).
[Unit]
Description=klid-label backend (Spring Boot)
Documentation=file:@KLID_PREFIX@/../deploy/onprem/docs/05-run-verify.md
# DB·ai-server 준비 후 기동되도록 정렬(동일 호스트 PostgreSQL/ai-server 가정).
#   외부 DB 면 network-online 만으로 충분 — postgresql.service 가 없으면 무시된다.
After=network-online.target postgresql.service klid-ai-server.service
Wants=network-online.target
Requires=klid-ai-server.service

[Service]
Type=simple
User=@KLID_USER@
Group=@KLID_GROUP@
WorkingDirectory=@KLID_PREFIX@/app
EnvironmentFile=@KLID_ETC@/backend.env
# ffmpeg 는 시스템 RPM 으로 /usr/bin 에 설치되므로 표준 PATH 로 충분하다
#   (net.bramp ffmpeg 래퍼가 bare 이름으로 찾을 때 대비).
#   backend.env 의 FFMPEG_BIN/FFPROBE_BIN 절대경로가 우선이다.
# ⚠ 구 설정 폐기(2026-08-28) — PATH 앞에 @KLID_PREFIX@/runtime/ffmpeg/bin 을 붙이던 것.
#   정적 바이너리 번들 폐지로 그 디렉토리가 더 이상 생성되지 않는다.
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# ★ 기동 전 사전 점검 — 반입되지 않는 자바/jar 을 <사유와 함께> 먼저 알린다.
#   이것이 없으면 systemd 가 "203/EXEC" 만 남기고 끝나 — 운영자가 원인을 못 찾는다.
#   ExecStartPre 가 실패하면 유닛은 기동하지 않고 아래 메시지가 로그에 남는다.
ExecStartPre=/bin/sh -c '[ -x @KLID_PREFIX@/runtime/jre/bin/java ] || { echo "[klid-backend] 자바 런타임이 없습니다: @KLID_PREFIX@/runtime/jre/bin/java — 패키지는 JRE 를 반입하지 않습니다(확정 형상은 외부 WAS 에 api.war 반입). 이 유닛으로 운영하려면 JRE 반입을 되살리거나 ExecStart/ExecStartPre 의 자바 경로를 장비의 Java 17 로 바꾸십시오. 유닛 헤더 주석 / docs/09-operations-runbook.md §0-3" >&2; exit 1; }'
ExecStartPre=/bin/sh -c '[ -f @KLID_PREFIX@/app/klid-backend.jar ] || { echo "[klid-backend] 실행 jar 이 없습니다: @KLID_PREFIX@/app/klid-backend.jar — 원인은 둘 중 하나입니다. (1) WAR 반입 형상으로 설치되어 jar 을 배치하지 않았다 → sudo INSTALL_BACKEND_SYSTEMD_UNIT=1 ./scripts/install.sh 로 재설치. (2) 매체에 jar 자체가 없다(2026-08-30 부터 반입 대상이 아니라 기본 수집에서 빠진다) → 빌드머신에서 WITH_BACKEND_JAR=1 ./scripts/package.sh 로 재수집 후 매체를 다시 전송. (2) 이면 (1) 을 해도 설치가 사유와 함께 실패합니다." >&2; exit 1; }'
# JAVA_OPTS 는 backend.env 에서 주입(없으면 빈 값).
ExecStart=@KLID_PREFIX@/runtime/jre/bin/java $JAVA_OPTS -jar @KLID_PREFIX@/app/klid-backend.jar
SuccessExitStatus=143
Restart=on-failure
RestartSec=10
# 기동 여유(대용량 컨텍스트 로딩 · 이중화 첫 기동의 QRTZ_LOCKS 락 조율)
#  ⚠ 구 서술 폐기(2026-08-30) — "첫 노드가 Flyway 마이그레이션 중 강제 종료되면 …
#    이중화 첫 기동(73개 마이그레이션 + QRTZ_LOCKS 락 조율) 여유를 위해". 두 겹으로 틀렸다:
#      ① 온프렘은 Flyway 를 쓰지 않는다 — 스키마는 설치 시 db/schema.sql 을 1회 로드해
#         이미 만들어져 있고, 앱은 spring.flyway.enabled=false 다. 기동 경로에 마이그레이션이
#         <없다>. (ddl-auto=validate 도 선언만 있고 이 앱의 EMF 구성에 도달하지 않는다.)
#      ② "73개 마이그레이션" 은 마이그레이션 수가 아니다 — 실제 마이그레이션은 21개이고,
#         73 은 schema.sql 의 CREATE TABLE 수(LS_* 62 + QRTZ_* 11)와 우연히 같은 값이다.
#  ★ 값 600s 는 그대로 둔다. 근거만 낡았고 여유 자체는 여전히 필요하다 — 스프링 컨텍스트
#    로딩 + 이중화 2노드 동시 기동 시 QRTZ_LOCKS 락 조율 시간이 든다.
TimeoutStartSec=600
# 종료 유예 예산 — 애플리케이션의 graceful shutdown 총합보다 커야 한다.
#  - server.shutdown=graceful + spring.lifecycle.timeout-per-shutdown-phase=30s (진행 중 요청 대기)
#  - MvcAsyncExecutorConfig 의 awaitTerminationSeconds=60s (진행 중 스트리밍 응답 대기 상한)
#  합 90s + JVM 종료 여유 30s = 120s.
#  ★ 이 값이 그 합보다 작으면 systemd 가 SIGKILL 로 먼저 끊어 유예 설정이 통째로 무의미해진다
#    (구 형상 30s 가 정확히 그 상태였다). 앱 쪽 유예를 늘릴 때는 이 값을 함께 올릴 것.
TimeoutStopSec=120
# 로그 — journald + 식별 태그
StandardOutput=journal
StandardError=journal
SyslogIdentifier=klid-backend

# ---- 하드닝 ----
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true
# 데이터/로그 쓰기 허용 경로 + 영상·프레임 NAS 저장소(STORAGE_RAW_PATH/DEIDENTIFIED).
# ProtectSystem=full 하에서 이 목록에 없는 경로는 쓰기 불가 — NAS 저장소가 빠지면 프레임 저장 실패.
ReadWritePaths=@KLID_LOG@ @KLID_DATA@ @STORAGE_RAW_PATH@ @STORAGE_DEIDENTIFIED_PATH@

[Install]
WantedBy=multi-user.target
