# ============================================================================
# klid-backend 환경설정 (EnvironmentFile=/etc/klid/backend.env)
#
#   ★ 이 파일은 systemd 의 EnvironmentFile 로 로드된다.
#     - 형식: KEY=VALUE (한 줄 1개, 따옴표 불필요, 셸 확장 없음)
#     - 권한: chmod 640, owner root:klid (비밀번호 포함 → 외부 노출 금지)
#
#   필수(★) / 선택(·) 표기. 자세한 설명은 docs/04-configuration.md 참고.
# ============================================================================

# ---- 프로파일 -------------------------------------------------------------
# ★ 운영은 prd 권장(application-prd.yml: DataSource 2종 + Swagger/actuator 차단).
#    prd 는 webhook HMAC 시크릿(VLM/AUGMENT)이 필수다(미설정 시 부팅 차단).
#    ★ 비식별(KPST)은 폐쇄망 동거 연동이 확정 정책이다 — prd 에서 끄거나 mock 우회 불가.
#    그 외 외부(관제통지/VLM/증강)는 토글로 on/off. 04-configuration.md B 절 참고.
SPRING_PROFILES_ACTIVE=prd

# ★ 배포 환경 표식 — 프로파일과 <독립된 축>이다. stg 서버면 stg, 운영 서버면 prd.
#   왜 필요한가: 위 SPRING_PROFILES_ACTIVE 는 서버의 잔존 .env·셸 환경에 덮여 dev 로 뜨는 사고가
#   실제로 있었다. 그러면 프로파일 축만 보는 가드는 전부 통과해 ①dev 편의 엔드포인트가 열리거나
#   (DevProfileGuard) ②Quartz 클러스터링이 꺼진 채 2노드가 배치 트리거를 중복 발화한다
#   (QuartzClusteringGuard, B-ISSUE-81). ENV 가 배포 표식이면 <배포 쪽이 이겨> 기동을 거부한다.
#   ⚠ 배포 서버(stg/prd)에서는 절대 비우지 말 것 — 비면 이 방어축이 통째로 무력해진다.
#   (local/dev 단일 노드 개발 서버에서는 비워 둔다.)
ENV=prd

# ★ Flyway 부팅 마이그레이션 비활성 — 온프렘은 Flyway 를 쓰지 않는다(확정, 경로는 하나뿐).
#   설치 시 db/schema.sql(전체 통합 DDL)을 1회 로드한다(앱은 스키마를 스스로 만들지 않는다).
#   전체 스키마 SQL 을 따로 만들어 둔 이유가 그것이며, 이중화(2노드) 동시 기동 시의 Flyway
#   락 경합·최초 부팅 지연도 함께 사라진다.
#   ⚠ 앱 코드 자체의 기본값은 true(켬)다 — 아래 한 줄이 그것을 끄는 유일한 장치이므로
#     <지우지 말 것>. 지우면 앱 기본값이 되살아나, DBA 가 선적용한 스키마 위에서 마이그레이션이
#     그대로 돈다. (형상별 키 표기 규칙은 docs/04-configuration.md 「키 이름 변환 규칙」)
SPRING_FLYWAY_ENABLED=false

# ---- DB: control(klid_system) + portal -----------------------------------
# prd 프로파일은 HOST/PORT/NAME 분리 변수를 사용해 jdbc-url 을 조립한다.
#
# ★ DB 스키마는 설치 단계(16-load-schema.sh)가 db/schema.sql 을 빈 control DB 에 1회
#   로드해 준비한다 — LS_* 62개 · QRTZ_* 11개 · 뷰 4개 + 시드 66행이다(MNG_* 는 들어 있지 않다).
#   앱은 SPRING_FLYWAY_ENABLED=false 로 돌며 스키마를 스스로 만들지 않는다.
#   따라서 DB 사전요건은 "빈 DB 2개 + 사용자"뿐.
#   ⚠ 그 로드는 자동이 아니다 — 16 단계는 SCHEMA_LOAD_RUN=1 이고 psql 이 있을 때만 실제로 넣고,
#     평시엔 수동 절차만 출력한다. 아무도 넣지 않으면 <Flyway 가 없으므로 대신 만들어 주는 것도
#     없다>. ⚠ 그런데도 앱은 <기동에 성공한다> — ddl-auto=validate 는 선언만 있고 이 앱의
#     EMF 구성에 도달하지 않는다. 설치 로그에도 기동 로그에도 신호가 없고, 화면·배치가 처음
#     DB 를 건드릴 때 비로소 터진다. 반드시 테이블 개수를 세어 확인할 것(정상값 73).
#   ⚠ 대상 스키마에 테이블이 이미 있으면 16 은 멱등 가드로 로드를 생략한다 —
#     DBA 가 선적용한 DB 에 다시 돌려도 덮어쓰지 않는다.
#
# ※ [설치 토글] USE_BUNDLED_POSTGRES — 이 파일(런타임 env)이 아니라 install.sh 인자다.
#     USE_BUNDLED_POSTGRES=1 (기본): 번들 PG16 을 오프라인 설치(10-install-postgresql.sh).
#     USE_BUNDLED_POSTGRES=0       : 외부(기존) PG 사용 — 번들 PG 설치 생략. 이때 아래
#       CONTROL_DB_* 가 외부 PG 주소/자격을 가리키게 둔다.
#   예: sudo USE_BUNDLED_POSTGRES=0 ./scripts/install.sh  (04-configuration.md D 절 참고)
# ★ DB 스키마 이름 — 앱·Flyway·Quartz·네이티브 쿼리가 모두 이 한 값을 읽는다.
#   기본값 klid_at 이며, 바꾸면 db/schema.sql 을 로드하는 설치 16 단계도 같은 값을 써야 한다
#   (갈리면 앱이 만들어 둔 테이블을 못 본다 — 오류가 아니라 <조용한 분기>가 된다).
#   ⚠ 기본값 그대로 쓸 것을 권장한다. 바꿀 이유가 없으면 이 줄을 건드리지 말 것.
DB_SCHEMA=klid_at
# ★ control DB
CONTROL_DB_HOST=127.0.0.1
CONTROL_DB_PORT=5432
CONTROL_DB_NAME=klid_system
CONTROL_DB_USERNAME=klid_user
CONTROL_DB_PASSWORD=
# ※ 포털 DB 접속 정보는 <더 이상 없다> — 저작도구 → 포털 DB 메타 단방향 복제가 폐기됐다
#   (2026-08-31). 관제 연동 배포와 포털 연동 배포는 서로 다른 인프라에 있고 <서로의 DB 에
#   접근하지 않는다>. 포털향 배포본은 관제가 중계한 자산으로 자기 DB 를 채운다.
#   ⚠ 옛 반입물의 PORTAL_DB_* / META_REPLICATION_ENABLED 를 되살리지 말 것 — 읽는 코드가 없다.

# ---- 보안 시크릿 ----------------------------------------------------------
# ★ JWT 검증 시크릿(HS256, 32바이트 이상). 관제/포털 발급 토큰을 검증한다.
#    생성 예: openssl rand -base64 48
JWT_SECRET=
# · JWT issuer(기본 klid-auth) / 허용 issuer 목록
JWT_ISSUER=klid-auth
JWT_ALLOWED_ISSUERS=klid-auth,klid,klid-portal
# ★ 영상 스트림 단기 서명 URL 시크릿(JWT_SECRET 과 다른 값, 32바이트 이상).
#    미설정 시 서명 URL 발급/검증이 fail-closed(스트리밍 불가).
STREAM_SIGN_SECRET=
# · 서명 URL 유효시간(초, 5~600 클램프)
STREAM_URL_TTL_SECONDS=60
# ★ nonce 쿠키(klid_stream_nonce)의 Secure 속성 — 이 쿠키는 서명 검증의 필수 입력이다.
#    기본 false(부여 안 함). 이 배포는 프런트가 평문 HTTP(:80)로 서비스되므로 false 가 맞다 —
#    true 면 브라우저가 쿠키를 저장하지 않아 스트림 요청이 전건 401 이 되고 영상이 재생되지 않는다.
#    앞단에 사내 TLS 종단을 두어 HTTPS 로 서비스한다면 true 로 바꾼다.
#    ⚠ 빈 값으로 두지 말 것 — 위 STREAM_SIGN_SECRET 관례를 따라 비우면 기동이 실패한다
#      (Invalid boolean value []). true|false 만 쓴다.
# ★ 현장은 HTTPS 다 — https://www.aicctv.go.kr/label-studio/ (2026-09-04 확인).
#   HTTP 로 들어와도 엣지가 301 로 HTTPS 에 넘긴다(실측). 그래서 true 가 안전하다.
#   ⚠ HTTP 로도 그대로 서빙되는 경로가 생기면 그쪽 영상 스트림이 401 이 된다.
STREAM_COOKIE_SECURE=true
# ★ 관리자 공유 패스워드 BCrypt 해시(cost ≥ 12). 평문 금지 — 해시만.
#    생성 예: htpasswd -bnBC 12 "" '평문' | tr -d ':\n' | sed 's/^\$2y/\$2y/'
ADMIN_CLAIM_PASSWORD_HASH=$2b$12$iN2qH.urDFs.hh28.bskS.QjnQDVBqZYCq7gSEmzDg54EuOeXRu4W

# ---- webhook 콜백 보안 (prd 필수) ----------------------------------------
# ★ prd 프로파일은 WEBHOOK_HMAC_SECRET_AUGMENT 가 비면 부팅이 차단된다(fail-closed).
#    외부 증강 콜백을 안 받더라도 임의의 강한 시크릿을 채워 부팅을 통과시킨다.
#    생성 예: openssl rand -hex 32
#    ※ 예시/문서에 적힌 값을 그대로 쓰지 말 것 — 공개된 키는 서명 위조가 가능하다(DEV_FIX H-1).
#      리포에 커밋된 placeholder 값은 local 외 프로파일에서 기동이 차단된다.
# (VLM describe 콜백은 벤더 v2.0.1 무서명 규격 — WEBHOOK_HMAC_SECRET_VLM 은 현재 코드에
#  소비처가 없어 설정해도 무시된다. 부팅 필수 아님.)
WEBHOOK_HMAC_SECRET_AUGMENT=
# · replay 방지 윈도우(초)
WEBHOOK_HMAC_TIMESTAMP_WINDOW=300
# ★ 신뢰 프록시 CIDR (CSV) — 이 대역에서 온 요청의 X-Forwarded-For 만 해석한다(CWE-348 위조 차단).
#    미설정이면 LB/Nginx 뒤에서 모든 콜백의 클라이언트 IP 가 LB IP 하나로 수렴해,
#    임의의 인증 실패 5회가 정상 벤더 콜백 전건을 60초 차단한다(2노드 전체 전파).
#    프록시 뒤: 10.0.0.0/8 처럼 대역 지정 / 프록시 없이 직접 노출: none 명시
#    prd·stg 는 **미설정 시 부팅 차단** (DEV_FIX M-3 / REDESIGN R-3 — stg 도 LB 뒤라 동일 정책).
#    여기에 'none' 을 기본값으로 미리 채워 두지 말 것 —
#    "안전하지 않은 답"이 기본값이 되면 프록시 뒤 형상에서 그대로 배포된다(DEV_FIX N-3).
#    형식 오류(오타 203.0.113.0/33, 구분자 오타, 호스트명)도 **부팅 차단**된다(DEV_FIX N-4).
WEBHOOK_TRUSTED_PROXY_CIDRS=
# ★ VLM 콜백 허용 출처 CIDR (CSV) — VLM describe 콜백은 벤더 규격상 무서명이라
#    IP allowlist 가 3계층 방어(allowlist / rate limit·size cap / request_id 발급 게이트)의 첫 계층이다.
#    벤더 송신 대역을 지정 / 미적용을 의도하면 none 명시. prd·stg 는 **미설정 시 부팅 차단**.
WEBHOOK_VLM_ALLOWED_IP_CIDRS=

# ---- 저장소 경로 ----------------------------------------------------------
# ★ 원본/비식별 영상·프레임 저장 베이스. NAS 마운트 루트와 반드시 일치시킬 것.
#   v2 는 DB에 저장된 파일 절대경로를 이 베이스 기준 startsWith 가드(CWE-22)로 검증해 서빙한다.
#   관제 적재(MNG_CLIP_MASTER.FILE_PATH=/nas-storage/...)·v1→v2 이관본(/nas-storage/...)이
#   모두 이 베이스로 시작해야 영상/프레임이 정상 서빙된다. (불일치 시 NOT_FOUND/FORBIDDEN)
#   → 실제 NAS 마운트 루트로 설정. v1 트리(data/clip/gov·label-studio/{src,bkup})를 모두 덮는 공통 루트.
STORAGE_RAW_PATH=/nas-storage
STORAGE_DEIDENTIFIED_PATH=/nas-storage
# ★ co-locate 산출(Phase 5A) 경로 가드용 고정 allowlist — 콤마 구분 마운트 루트 목록.
#   검수 승인 산출물/비식별 영상은 dirname(RAW_FILE_PATH_NM)/{RAW_SN}/ 아래에 생성된다. 그 base 가
#   이 목록 하위일 때만 쓰기가 허용되고, 벗어나면 기본 루트로 폴백하지 않고 실패한다(CWE-22 fail-closed).
#   ⚠ 미설정 시 코드가 [STORAGE_RAW_PATH, STORAGE_DEIDENTIFIED_PATH] 로 폴백하지만, 그 암묵 동작에
#     기대지 말고 여기서 명시한다(배포 형상마다 폴백 결과가 달라 조용히 전 영상 export 가 실패할 수 있다).
#   ⚠ '/' 등 파일시스템 루트를 지정하면 가드가 무력화되므로 애플리케이션 기동이 차단된다.
#   → 아래 기본값은 NAS 루트 전체라 입도가 없다. 관제 적재 경로(MNG_CLIP_MASTER.FILE_PATH)와
#     v1 이관본이 실제로 놓이는 **서브트리를 확인한 뒤 최대한 좁게** 조정할 것.
#     예) STORAGE_RAW_MOUNT_ROOTS=/nas-storage/data/clip/gov,/nas-storage/label-studio/src,/nas-storage/label-studio/bkup
#     (좁힌 뒤에는 반드시 실제 영상 1건으로 비식별·검수 승인 산출을 검증할 것 — 누락 시 그 트리의 영상이 전부 실패)
STORAGE_RAW_MOUNT_ROOTS=/nas-storage
# ★ 외부 벤더(생성형 AI) 산출물 <읽기> 전용 허용 루트 — 콤마 구분. 위 쓰기 allowlist 와 별개 축이다.
#   벤더는 증강 결과 이미지를 <자기 트리>에 쓰고 그 절대경로를 콜백(POST /v1/genai/callback)으로 준다.
#   저작도구는 그 파일을 읽어 파생 프레임으로 복사만 하므로, 그 트리를 쓰기 allowlist 에 넣지 않고
#   여기(읽기 축)에만 추가한다. 미설정(기본)이면 읽기 허용 범위 = 쓰기 allowlist 와 동일하며,
#   벤더 트리 경로는 400 으로 거부된다(fail-closed — 증강이 PENDING 에 머문다).
#   → 외부 증강 실연동 시 벤더 공유 마운트 경로를 지정하고, 그 마운트는 읽기 전용(ro)으로 잡을 것.
#   ⚠ '/' 등 파일시스템 루트를 지정하면 기동이 차단된다(쓰기 축과 동일).
STORAGE_EXTERNAL_READ_ROOTS=

# ---- ai-server 연동 (서버 B 주소) -----------------------------------------
# ★★ 이 값은 <다른 장비>를 가리킬 수 있다. 대상 장비는 2대이고 ai-server 는 서버 B 에 있다.
#   - 단일 서버 설치(install.sh 를 --role 없이 실행) → 아래 기본값 그대로 맞다.
#   - 2대 분리 설치(--role=app / --role=ai)        → ★ 반드시 서버 B 주소로 바꾼다.
#         예) AI_SERVER_URL=http://10.0.0.12:9300
# ⚠ 틀려도 <아무 신호가 없다>. 백엔드는 정상 기동하고 헬스체크도 통과하며, 오토라벨링
#   (YOLO 탐지·SAM2 분할/추적)만 호출 시점에 실패한다. 값이 잘못됐다는 사실이 기동 로그에
#   남지 않으므로, 설치 직후 서버 A 에서 아래가 200 인지 <직접> 확인한다:
#         curl -fsS http://<서버 B 주소>:9300/health
# ⚠ 서버 B 쪽도 함께 열어야 한다 — ai-server 는 기본이 loopback 바인드라 원격에서 닿지 않는다.
#   서버 B 의 /etc/klid/ai-server.env 에서 AI_BIND_HOST 를 바꾸고 방화벽 9300 을 연다
#   (config/ai-server/env.template 의 AI_BIND_HOST 주석 참고).
AI_SERVER_URL=http://127.0.0.1:9300

# ---- AI 장비 상태점검 임계 (추론 축) ---------------------------------------
# 장비를 여러 대 등록하면 주기 점검이 죽은 장비를 목록에서 빼고 살아나면 되돌린다.
# 아래는 <연속 몇 번>을 보고 그 판정을 내릴지다. 한 번 흔들렸다고 내리지 않는 이유가 이것이다.
# ⚠ 0 이나 음수를 넣어도 1 로 흡수된다 — 「0회 실패로 즉시 배제」 같은 형상은 만들 수 없다.
# ⚠ 값을 키우면 죽은 장비가 목록에 남는 시간이 길어지고, 줄이면 잠깐 느려진 장비가 배제된다.
# ★ 시계열 축(VLM_HEALTH_*)과 <자리가 갈려 있다> — 여기를 바꿔도 시계열은 움직이지 않는다.
#   외부 벤더는 우리가 배포한 것이 아니라 응답 특성이 달라 같은 값을 강요하지 않는다.
AI_SERVER_FAIL_THRESHOLD=3
AI_SERVER_RECOVER_THRESHOLD=3
# 점검 주기(초). ★ 시계열 축(VLM_HEALTH_POLL_INTERVAL_SECONDS)과 <자리가 갈려 있어> 서로를
# 물려받지 않는다 — 여기를 바꿔도 시계열 주기는 그대로다.
# ⚠ 줄일 때는 <한 번의 점검 상한 x 장비 수>가 주기를 넘지 않는지 먼저 따진다. 넘으면 틱이 밀린다.
AI_SERVER_POLL_INTERVAL_SECONDS=5

# ---- CORS -----------------------------------------------------------------
# · 동일 출처(프론트가 같은 도메인에서 /api 프록시)면 비워도 된다.
#   다른 도메인에서 호출 시 콤마 구분 allowlist(예: https://fe.example.com)
CORS_ALLOWED_ORIGINS=

# ---- FFmpeg (런타임 의존: 시스템 RPM 설치본) ------------------------------
# · ffmpeg 는 base/AppStream 에 없어 EPEL + RPM Fusion + PowerTools(CRB) 에서 받아
#   오프라인 번들(syspkgs/ffmpeg/*.rpm)로 설치한다 → /usr/bin/{ffmpeg,ffprobe}.
# ⚠ 구 서술 폐기(2026-08-28) — "Rocky 9 … 정적 바이너리를 번들한다 /
#   /opt/klid/runtime/ffmpeg/bin/{ffmpeg,ffprobe} 로 배치된다".
#   타깃이 RHEL 8.9(glibc 2.28)로 확정되어 정적 빌드(glibc 2.31 기반)가 동작하지 않는다.
FFMPEG_BIN=/usr/bin/ffmpeg
FFPROBE_BIN=/usr/bin/ffprobe
FFMPEG_THREADS=2

# ---- 배치 파이프라인 ------------------------------------------------------
# · 적재→비식별→마킹→VLM→프레임추출→오토라벨링 주기 배치
BATCH_ENABLED=true
BATCH_INTERVAL_SEC=60
# · ★ 인입 폴링(LS_DATA_INGEST 픽업 → LS_DATA_RAW 적재). 반드시 true 로 둘 것.
#   ⚠ 구 안내("관제 공유 DB 가 없으면 false 권장")는 <적재 주체 반전 이전>의 서술로 폐기됐다.
#     지금은 관제가 인입 테이블에 직접 INSERT 하고 이 잡이 그것을 픽업하며, <관리 화면 자체 업로드>
#     분도 같은 인입 행으로 합류한다 — 즉 이 잡이 적재의 <유일한 통로>다.
#   ⚠ false 로 두면 업로드는 200 을 받고 인입 행이 만들어지지만 <영원히 PENDING> 에 머문다
#     (영상이 목록에 나타나지 않는다). 기동 시 ERROR 로그가 남고 업로드 완료 응답 헤더가
#     X-Ingest-Status: PENDING_SCAN_DISABLED 로 표시된다.
TRAINING_SCAN_ENABLED=true
TRAINING_SCAN_INTERVAL_SEC=60

# ── 개발/브링업 토글 ──
# ⚠ dev 로그인은 인증 없이 임의 role 토큰을 발급한다. 운영 정상화 후 반드시 미설정(OFF)로 원복.
# DEV_LOGIN_ENABLED=true        # /v1/dev/tokens 로 테스트 토큰 발급 허용(기본 false — 운영은 OFF 가 정상)
#
# ── 수동 업로드 (운영 상시 기능 — 2026-08-24 CO-008) ──
# ★ DEV_UPLOAD_ENABLED 는 이제 **기본 true** 다(구 기재 "기본 false" 는 폐기).
#   /v1/dev/upload 로 운영자가 영상을 직접 올리는 상시 동선이며 인가는 REVIEWER 로 걸린다.
#   비노출로 되돌리려면 backend(아래 줄)와 frontend 를 <함께> 꺼야 한다. backend 만 끄면
#   화면은 보이는데 API 만 404 라 원인을 못 찾는다(04-configuration.md I 절).
#   ★ frontend 는 <재빌드하지 않는다>(구 기재 "재빌드해야 한다" 는 폐기 — 런타임 설정 주입
#     도입 전 서술이다). 설정 정본 /etc/klid/frontend.env 에서 VITE_DEV_UPLOAD_ENABLED=false
#     로 바꾼 뒤 반영 명령 한 줄이면 된다. 웹 서버 재기동도 필요 없다:
#         sudo /opt/klid/bin/klid-frontend-config
# DEV_UPLOAD_ENABLED=false      # 수동 업로드를 끈다(기본 true)
#
# SPRING_SERVLET_MULTIPART_ENABLED 는 지정하지 않는다 — 공통 설정이 이미 true 다
#   (구 기재 "dev 업로드 사용 시 필수" 는 사실과 달랐다).
# DEV_UPLOAD_EXTRACT_TECHNICAL_META=false # 즉시 실행 업로드의 영상 기술메타(video.*) 적재를 끈다(기본 true).
#                                         #   끄면 그 사실이 기동 로그(INFO)에 남는다. 업로드·비식별은 그대로 진행된다.

# ============================================================================
# 외부 시스템 연동 토글 (온프렘에 외부가 없으면 아래로 비활성화)
#   ── 04-configuration.md "외부 연동 경로 vs 자족 경로" 표 참고 ──
# ============================================================================

# ---- KPST 비식별 위탁(폴링) ── ★ 확정 정책: KPST 동거 연동 -----------------
# ⚡ 한 줄 요약: 아래 값은 현장 확정값(평문 http)으로 채워져 있어 그대로 부팅된다.
#     주소가 다르면 관리자 화면에서 재기동 없이 바꿀 수 있다.
#     ★ https 로 바꾸는 경우에만 KPST_DEID_CA_CERT_PATH 에 CA(ca.crt) 경로가 함께 필요하다
#       — 비우면 <부팅은 되고> 비식별 위탁·산출이 거부된다(의도된 fail-closed, CWE-295).
#         구 서술 「부팅이 막힌다」는 폐기다(2026-09-03) — 아래 그 키 설명 참조.
# ★ 운영 전제(확정): KPST 비식별 서버를 폐쇄망에 함께 설치하고 backend 가 폴링으로 연동한다.
#   KPST 서버 자체는 외부 시스템 — 본 설치 패키지에 포함되지 않으며 고객이 별도 설치한다.
#   본 패키지는 backend ↔ KPST 연동 설정·절차만 제공한다(04-configuration.md B 절).
# ★ 기본 true 유지. mock/disable 우회는 prd 에서 미지원 — 비식별을 끄면 개인정보(PII)가 노출되고
#   파이프라인(마킹/프레임추출)이 차단된다. false 이고 mock 도 아니면 DeidentifyStep 이 설정오류로 거부한다.
KPST_DEID_ENABLED=true
# ★ KPST 서버 주소. base-url 스키마로 전송 방식이 자동 분기된다.
#   - http://IP:PORT   → 격리망 평문. CA 불요(비워둠). ← 이 현장이 여기 해당한다
#   - https://IP:PORT  → 사설 CA 인증서 경로(KPST_DEID_CA_CERT_PATH)가 필수(아래 참고).
# ★ 아래 값은 확정 사실이다 — 비식별 서버는 GPU 장비 <첫 번째 대>에만 있고 평문 9989 로 받는다.
#   ⚠ 호스트 주소는 관제지원 측 장비 대장에서 가져온 값이라 현장에서 한 번 확인할 것.
#     틀려도 부팅은 되며, 관리자 화면에서 재기동 없이 바꿀 수 있다.
#   ⚠ backend 는 <앱 서버>에서 도는데 비식별 서버는 <GPU 장비>에 있다 — loopback(127.0.0.1)으로
#     되돌리면 영원히 닿지 않는다. 기동·상태점검은 정상인데 비식별만 조용히 실패한다.
KPST_DEID_BASE_URL=http://10.177.33.162:9989
# ★ https 일 때만 필수: KPST 사설 CA(ca.crt) 파일 경로.
#   https 인데 비었거나 못 읽으면 <기동은 통과>하고 비식별 위탁·산출이 거부된다
#   (검증할 수 없으면 보내지 않는다 — CWE-295). 조용히 넘어가지 않고 기동 시 ERROR 로그가 남는다.
#   ⚠ 구 서술 폐기(2026-09-03) — 「부팅 시점에 fail-closed 로 기동 실패」.
#     설정 한 줄로 앱 전체가 멈추지 않도록 <막는 자리를 기동 → 전송 시점>으로 옮겼다.
#     막는 규칙·강도 자체는 그대로다 — 검증 우회는 어느 경우에도 없다.
#     (KpstWebClientConfig.kpstDeidEndpointAddress · buildSslContext)
#   http base-url 이면 불필요하므로 비워둔다.
KPST_DEID_CA_CERT_PATH=
KPST_DEID_CREATOR_ID=authoring
KPST_DEID_REQ_USER_ID=authoring
# ⚠ 구 키 KPST_DEID_EXPORT_PATH_BASE 는 <제거>됐다(2026-09-09) — 읽는 코드가 0건이라 무엇을 넣든
#   아무 일도 일어나지 않았다. 옛 반입물에 남아 있어도 되살리지 말 것.
#   비식별 결과가 쓰이는 자리(KPST 에 넘기는 export_path)는 설정이 아니라 <원본 경로에서 도출>한다:
#     co-locate(기본) dirname(원본영상)/{rawSn}/deid/   ·  롤백 전략 {STORAGE_DEIDENTIFIED_PATH}/videos/{rawSn}/
#   그래서 그 자리를 가두는 것은 STORAGE_RAW_MOUNT_ROOTS(쓰기 허용 루트)다.
#   ★ 파일명은 우리가 정하지 않는다 — KPST 가 정한다(실측 {원본stem}-mask{확장자}).
#     조회할 때 조합·추측하지 말고 LS_DEIDENT_PROC_LOG.DE_IDNTF_FILE_PATH_NM 에 기록된 값을 읽을 것.
KPST_DEID_POLL_INTERVAL_SEC=30
KPST_DEID_POLL_MAX_ATTEMPTS=240
KPST_DEID_POLL_TIMEOUT_MINUTES=180

# ---- 관제서버 outbound 완료/수정 통지 ------------------------------------
# · 기본 false. 관제서버 inbound SPI 가 있으면 true + URL 주입.
CONTROL_NOTIFY_ENABLED=false
CONTROL_NOTIFY_URL=http://127.0.0.1:8090
CONTROL_NOTIFY_TIMEOUT_MS=10000
CONTROL_NOTIFY_DEBOUNCE_SEC=60

# ---- 외부 VLM 시계열 위탁 -------------------------------------------------
# · ★ 활성/비활성 토글은 폐지됐다 — 껐다 켜는 손잡이를 되살리지 말 것.
#   미연동 판정은 <주소 주입 여부>가 한다. 비워 두면 URL 검증을 생략해 기동은 정상이고,
#   위탁은 조용히 건너뛰지 않고 실패한다.
# · 벤더 연동이 확정되면 실제 주소를 채운다(운영은 https 필수 — 평문/내부 대역은 부팅 차단).
#   ⚠ 여기에 http://127.0.0.1 같은 값을 미리 채워 두지 말 것 — 미연동인데 "주소가 있다"로
#     판정돼 위탁이 아무도 없는 주소로 나가고 그 실패가 벤더 장애처럼 보인다.
#     ⚠ 구 서술 폐기(2026-09-01): "운영 정책(HTTPS 전용 + 사설망 차단)에 걸려 부팅이 막힌다" 는
#       더 이상 사실이 아니다. 주소 검증은 스킴(http/https)과 형식만 본다 — 평문 http 도 통과한다.
# · 주소를 채우기 전 구간에는 시계열 묶음을 사람이 스킵한다(사유가 처리 이력에 남는다).
#   ⚠ 스킵 없이 그대로 돌리면 마킹이 위탁 실패로 종결되어 이후 재수행해도 표시가 되돌아오지 않는다.
# · ★ 토큰을 쓰려면 VLM_SERVICE_URL 도 <반드시 함께> 채운다. 주소를 비워 둔 채 설정 화면
#   override 로만 바꾸면 배포 기본값(빈 값)과 호스트가 달라져 Authorization 헤더가
#   전송 직전에 제거되고(원 수신처에 발급된 값이라 무효라는 판정), 벤더가 인증을 요구하면
#   전건 401 이 된다. 그 401 은 비재시도라 조용히 확정 실패로 기록된다.
VLM_SERVICE_URL=
VLM_SERVICE_TOKEN=

# ---- AI 장비 상태점검 임계 (시계열 축) -------------------------------------
# 위 추론 축(AI_SERVER_*)과 <같은 뜻이고 자리만 다르다>. 한쪽을 바꿔도 다른 쪽은 움직이지 않는다.
# ⚠ 이 축의 오판은 대가가 크다 — 시계열은 고를 장비가 하나도 없으면 위탁이 <폴백 없이 거부>되므로
#   멀쩡한 벤더를 내리면 그 계통이 통째로 멈춘다. 그래서 판정도 추론보다 관대하다
#   (오류 응답이나 해석 못 하는 본문은 살아 있는 것으로 본다 — 벤더 정책은 우리가 고칠 수 없다).
# ⚠ 장비를 등록하지 않았으면 이 값은 아무것도 하지 않는다.
VLM_HEALTH_FAIL_THRESHOLD=3
VLM_HEALTH_RECOVER_THRESHOLD=3
# 점검 주기(초) — 추론 축보다 <길게> 잡는다. 우리 서버는 우리가 부담을 감당하지만
# 외부 벤더에게는 우리가 보내는 만큼이 그대로 비용이기 때문이다.
# ⚠ 대가 — 주기가 길수록 <죽은 벤더가 목록에 남는 시간>이 길어진다. 연속 실패 임계와 곱해지므로
#   배제까지 걸리는 시간이 그만큼 늘고, 그 구간의 위탁은 죽은 주소로 나갔다 실패한다.
# ⚠ 이 기본값은 <벤더 규격의 호출 빈도 제한을 확인하지 못한 상태>에서 정한 값이다.
#   제한이 확인되면 그 값에 맞춰야 한다.
VLM_HEALTH_POLL_INTERVAL_SECONDS=10

# ---- 배치 스케줄러 동시 처리 여력 ------------------------------------------
# 주기 작업들이 나눠 쓰는 <공유 자원>이다. 지금 등록되는 반복 작업은 여덟이다 —
# 상태점검(추론)·상태점검(시계열)·비식별 폴링·배치 파이프라인·관제 인입 스캔·
# 배치 재시도·산출 미결 스윕·산출 실패 회수.
# ⚠ 60초의 배수마다 다섯이 동시에 발화하고, 더 긴 주기가 겹치는 시점에는 여덟까지 간다.
#   모자라면 밀린 틱은 <몰아서 발화하지 않고 건너뛴다> — 즉 죽은 장비 배제가 그만큼 늦어진다.
#   오류로 드러나지 않으므로 「배치가 밀린다」를 진단할 때 이 값을 먼저 본다.
# ★ 기본값 3 은 <반복 작업이 하나뿐이던 시절>에 정해져 그 뒤 갱신되지 않은 값이다.
#   올릴 때는 <DB 커넥션 여력과 함께> 판단한다 — 작업 하나가 도는 동안 커넥션을 하나 잡는다.
QUARTZ_THREAD_COUNT=3

# ---- 외부 생성형 AI 증강 위탁 주소 ----------------------------------------
# · 이 주소가 곧 <연동 여부>다 (2026-09-03 확정) — 외부 증강을 아직 붙이지 않으면 빈 값으로 둔다.
#   빈 값이어도 <기동은 정상>이고, 위탁을 시도하는 시점에 실패한다. 요청 접수는 즉시 503 으로
#   거부되므로 "되지도 않을 요청" 이 접수되지도 않는다.
# · 실벤더를 붙일 때는 주소만 채운다:
#         AUGMENT_API_BASE_URL=https://augment.example.internal
#   ⚠ 구 미연동 모드 토글 AUGMENT_EXTERNAL_MODE 는 <폐기>됐다 — 읽는 코드가 없으므로 넣어도 아무
#     일도 일어나지 않는다. 되살리지 말 것(그 우회 때문에 위탁이 한 번도 나간 적이 없었다).
#   ⚠ 주소를 채우면 콜백 IP allowlist(WEBHOOK_GENAI_ALLOWED_IP_CIDRS)도 <함께> 채워야 한다.
#     짝이 맞지 않으면 <기동은 통과하되 위탁이 거부>된다 — 그대로 두면 위탁은 나가는데 결과 콜백이
#     전건 403 이 되어 증강이 PENDING 으로 영구 고착되기 때문이다(기동 시 ERROR 로그).
#     ★ 구 서술 「기동이 차단된다」는 폐기다(2026-09-03 · ADR-062). 조회·취소는 막지 않는다.
#   ⚠ 구 서술 폐기(2026-09-01): "운영은 HTTPS + 공인망만 허용하며 평문 http·사설 IP 를 넣으면
#     기동이 차단된다" 는 더 이상 사실이 아니다. 주소 검증은 스킴(http/https)과 형식만 본다 —
#     평문 http 도 내부망 주소도 그대로 통과한다(외부 시계열 위탁과 같은 공용 URL 정책).
#     구 완화 플래그(AUGMENT_ALLOW_INSECURE_URL)는 켜든 끄든 결과가 같아져 제거됐다 — 되살리지 말 것.
#   ⚠ 계속 차단되는 것(=<위탁 시점> 거부): 비허용 스키마 · 파싱 불가 · placeholder 호스트 ·
#     클라우드 메타데이터/링크로컬 등 예약 대역.
#     ★ 구 서술 「기동 차단」·「빈 값만 기동에서 걸리지 않는다」는 폐기다(2026-09-03 · ADR-062) —
#       <빈 값을 포함한 다섯 축 모두> 기동을 막지 않고 위탁 시점에 실패한다(기동 시 ERROR 로그).
AUGMENT_API_BASE_URL=

# ---- DEIDENTIFY_API_URL (헬스 핑/레거시 WebClient base-url) ---------------
# · 비식별 단일 경로는 KPST 폴링이라 실 비식별 호출에는 쓰이지 않지만,
#   헬스 인디케이터가 이 주소를 핑한다(authoring.integration.deidentify.base-url).
#   KPST 가 헬스 엔드포인트를 제공하면 그 주소로, 아니면 무해한 기본값으로 둔다.
DEIDENTIFY_API_URL=http://127.0.0.1:9200

# ---- 증강 콜백 base URL ---------------------------------------------------
# · 외부 증강 결과 push 콜백 base. 동일 서버면 backend 자신.
WEBHOOK_CALLBACK_BASE_URL=http://127.0.0.1:8080/api

# ---- 이중화(HA) — Quartz 클러스터링 [stg/prd 필수] ------------------------
# · 배포 토폴로지는 주 서버 2노드 Active-Active 이므로 **항상 true** 로 둔다(양 노드 동일).
#   → 2노드가 QRTZ_LOCKS 행 락으로 조율되어 배치 트리거를 1회만 발화한다.
#   → 끄면 관제 학습용 스캔(60s)·KPST 폴링(30s)·export sweep(600s) 이 노드마다 중복 발화한다
#     (@DisallowConcurrentExecution 은 스케줄러 인스턴스 내부에서만 유효).
# ⚠ false 로 두면 stg/prd 는 **기동이 거부**된다(QuartzClusteringGuard, B-ISSUE-81).
#   1노드로만 운영해야 하는 예외 상황이라도 이 값을 끄지 말 것 — 단일 노드에서도 클러스터
#   모드는 정상 동작한다(락 경합 상대가 없을 뿐).
# ⚠ 클러스터 모드는 노드 간 시계 동기화(NTP/chrony) 필수 — 클럭 오차 시 misfire/중복 발화.
#   설치 전 체크리스트: 두 노드 모두 chronyd(또는 ntpd) 활성 + 동일 NTP 서버 + 오차 1초 이내.
#   확인: chronyc tracking (System time offset) / timedatectl (NTP service: active)
# ⚠ 첫 기동 전에 스키마가 로드돼 있어야 한다(db/schema.sql 1회 로드 — 위 DB 절 참고).
#   Flyway 를 쓰지 않으므로 노드 기동 순서를 가릴 필요는 없다. ⚠ 스키마가 없어도 두 노드
#   모두 <기동에는 성공>하므로, 기동 성공을 스키마 준비의 근거로 쓰지 말 것.
# · QUARTZ_CHECKIN_MS : 클러스터 체크인 주기(ms). 노드 장애 감지 지연과 직결되므로 20초 권장.
QUARTZ_CLUSTERED=true
QUARTZ_CHECKIN_MS=20000

# ---- JVM 옵션 --------------------------------------------------------------
# ★ WAR 반입 형상에서는 이 값을 <systemd 유닛이 아니라 WAS 가> 써야 한다.
#   backend 는 외부 WAS(JBoss EAP 8.1 + Java 17)의 JVM 안에서 돌므로, 아래 옵션을 반영하려면
#   WAS 의 JVM 기동 옵션(EAP: bin/standalone.conf 의 JAVA_OPTS)에 옮겨야 한다.
#   ⚠ 이 파일 자체도 마찬가지다 — /etc/klid/backend.env 는 베어메탈 유닛의 EnvironmentFile 이었다.
#     WAS 프로세스에 같은 환경변수가 전달되도록 WAS 쪽에서 배선하지 않으면 DB 접속·시크릿이 비어
#     기동이 실패한다(docs/06-troubleshooting.md 「backend 가 안 보인다 — WAR 반입 형상」).
#   ⚠ 구 서술 폐기(2026-08-30) — "JVM 옵션 (systemd 유닛에서 사용)".
# ---------------------------------------------------------------------------
# · -Djava.security.egd=file:/dev/./urandom : 폐쇄망/신규 VM 의 엔트로피 고갈로
#   SecureRandom 초기화가 수십초~수분 블로킹되는 기동 지연 방지(/./ 는 JDK 알려진
#   동작 회피용으로 의도된 표기). 추가로 OS 에 haveged/rng-tools 설치 권장.
JAVA_OPTS=-XX:MaxRAMPercentage=75.0 -XX:+UseG1GC -Duser.timezone=Asia/Seoul -Djava.security.egd=file:/dev/./urandom

# ============================================================================
# ★ 비식별 정책 (확정 — KPST 동거 연동):
#   - 폐쇄망에 KPST 비식별 서버를 함께 설치하고 위 KPST_DEID_* 로 연동한다.
#   - prd 에는 mock/disable 우회 경로가 없다. 'integration.deidentify.mock-mode=true'
#     자족 비식별은 application-local.yml 전용이고, local 프로파일은 LocalProfileGuard
#     가 운영 호스트에서 거부한다. 즉 prd 에서 비식별을 끄거나 mock 으로 우회할 수 없다.
#   - 비식별을 끄면 PII 노출 + 마킹/프레임추출 차단이므로 반드시 KPST 연동을 갖춘다.
#     상세·증상·진단은 04-configuration.md B 절 / 06-troubleshooting.md 참고.
# ============================================================================
