# ============================================================================
# klid-backend 환경설정 (EnvironmentFile=/etc/klid/backend.env)
#
#   ★ 이 파일은 systemd 의 EnvironmentFile 로 로드된다.
#     - 형식: KEY=VALUE (한 줄 1개, 따옴표 불필요, 셸 확장 없음)
#     - 권한: chmod 640, owner root:klid (비밀번호 포함 → 외부 노출 금지)
#
#   필수(★) / 선택(·) 표기. 자세한 설명은 docs/04-configuration.md 참고.
# ============================================================================

# ---- 프로파일 -------------------------------------------------------------
# ★ 운영은 prd 권장(application-prd.yml: DataSource 2종 + Swagger/actuator 차단).
#    prd 는 webhook HMAC 시크릿(VLM/AUGMENT)이 필수다(미설정 시 부팅 차단).
#    ★ 비식별(KPST)은 폐쇄망 동거 연동이 확정 정책이다 — prd 에서 끄거나 mock 우회 불가.
#    그 외 외부(관제통지/VLM/증강)는 토글로 on/off. 04-configuration.md B 절 참고.
SPRING_PROFILES_ACTIVE=prd

# ---- DB: control(klid_system) + portal -----------------------------------
# prd 프로파일은 HOST/PORT/NAME 분리 변수를 사용해 jdbc-url 을 조립한다.
#
# ★ DB 스키마는 backend Flyway 가 자동 부트스트랩한다 — 관제 스키마 사전 적재 불필요.
#   기동 시 V2 마이그레이션이 LS_*·MNG_*·QRTZ_* 를 CREATE TABLE IF NOT EXISTS 로 생성한다
#   (spring.flyway.enabled=true, ddl-auto=validate). 따라서 DB 사전요건은 "빈 DB 2개 + 사용자"뿐.
#   관제가 이미 채운 MNG_*/QRTZ_* 가 있으면 IF NOT EXISTS 로 그대로 공유한다.
#
# ※ [설치 토글] USE_BUNDLED_POSTGRES — 이 파일(런타임 env)이 아니라 install.sh 인자다.
#     USE_BUNDLED_POSTGRES=1 (기본): 번들 PG16 을 오프라인 설치(10-install-postgresql.sh).
#     USE_BUNDLED_POSTGRES=0       : 외부(기존) PG 사용 — 번들 PG 설치 생략. 이때 아래
#       CONTROL_DB_*/PORTAL_DB_* 가 외부 PG 주소/자격을 가리키게 둔다.
#   예: sudo USE_BUNDLED_POSTGRES=0 ./scripts/install.sh  (04-configuration.md D 절 참고)
# ★ control DB
CONTROL_DB_HOST=127.0.0.1
CONTROL_DB_PORT=5432
CONTROL_DB_NAME=klid_system
CONTROL_DB_USERNAME=klid_user
CONTROL_DB_PASSWORD=
# ★ portal DB
PORTAL_DB_HOST=127.0.0.1
PORTAL_DB_PORT=5432
PORTAL_DB_NAME=portal
PORTAL_DB_USERNAME=klid_user
PORTAL_DB_PASSWORD=

# ---- 보안 시크릿 ----------------------------------------------------------
# ★ JWT 검증 시크릿(HS256, 32바이트 이상). 관제/포털 발급 토큰을 검증한다.
#    생성 예: openssl rand -base64 48
JWT_SECRET=
# · JWT issuer(기본 klid-auth) / 허용 issuer 목록
JWT_ISSUER=klid-auth
JWT_ALLOWED_ISSUERS=klid-auth,klid,klid-portal
# ★ 영상 스트림 단기 서명 URL 시크릿(JWT_SECRET 과 다른 값, 32바이트 이상).
#    미설정 시 서명 URL 발급/검증이 fail-closed(스트리밍 불가).
STREAM_SIGN_SECRET=
# · 서명 URL 유효시간(초, 5~600 클램프)
STREAM_URL_TTL_SECONDS=60
# ★ 관리자 공유 패스워드 BCrypt 해시(cost ≥ 12). 평문 금지 — 해시만.
#    생성 예: htpasswd -bnBC 12 "" '평문' | tr -d ':\n' | sed 's/^\$2y/\$2y/'
ADMIN_CLAIM_PASSWORD_HASH=

# ---- webhook HMAC 시크릿 (prd 필수) --------------------------------------
# ★ prd 프로파일은 아래 둘이 비면 부팅이 차단된다(application-prd.yml).
#    외부 VLM/증강 콜백을 안 받더라도 임의의 강한 시크릿을 채워 부팅을 통과시킨다.
#    생성 예: openssl rand -hex 32
WEBHOOK_HMAC_SECRET_VLM=
WEBHOOK_HMAC_SECRET_AUGMENT=
# · replay 방지 윈도우(초)
WEBHOOK_HMAC_TIMESTAMP_WINDOW=300

# ---- 저장소 경로 ----------------------------------------------------------
# ★ 원본/비식별 영상·프레임 저장 베이스. NAS 마운트 루트와 반드시 일치시킬 것.
#   v2 는 DB에 저장된 파일 절대경로를 이 베이스 기준 startsWith 가드(CWE-22)로 검증해 서빙한다.
#   관제 적재(MNG_CLIP_MASTER.FILE_PATH=/nas-storage/...)·v1→v2 이관본(/nas-storage/...)이
#   모두 이 베이스로 시작해야 영상/프레임이 정상 서빙된다. (불일치 시 NOT_FOUND/FORBIDDEN)
#   → 실제 NAS 마운트 루트로 설정. v1 트리(data/clip/gov·label-studio/{src,bkup})를 모두 덮는 공통 루트.
STORAGE_RAW_PATH=/nas-storage
STORAGE_DEIDENTIFIED_PATH=/nas-storage

# ---- ai-server 연동 -------------------------------------------------------
# ★ 동일 서버 베어메탈 설치 기준 localhost:9300
AI_SERVER_URL=http://127.0.0.1:9300

# ---- CORS -----------------------------------------------------------------
# · 동일 출처(프론트가 같은 도메인에서 /api 프록시)면 비워도 된다.
#   다른 도메인에서 호출 시 콤마 구분 allowlist(예: https://fe.example.com)
CORS_ALLOWED_ORIGINS=

# ---- FFmpeg (런타임 의존: 번들 정적 바이너리) -----------------------------
# · Rocky 9 에는 ffmpeg RPM 이 base/AppStream 에 없어 정적 바이너리를 번들한다.
#   설치 시 /opt/klid/runtime/ffmpeg/bin/{ffmpeg,ffprobe} 로 배치된다(절대경로 기본값).
#   (systemd 유닛 PATH 에도 이 경로가 추가되므로 bare 이름으로도 잡히지만, 명확성을 위해 절대경로.)
FFMPEG_BIN=/opt/klid/runtime/ffmpeg/bin/ffmpeg
FFPROBE_BIN=/opt/klid/runtime/ffmpeg/bin/ffprobe
FFMPEG_THREADS=2

# ---- 배치 파이프라인 ------------------------------------------------------
# · 적재→비식별→마킹→VLM→프레임추출→오토라벨링 주기 배치
BATCH_ENABLED=true
BATCH_INTERVAL_SEC=60
# · 관제 학습용 영상 픽업 스캔(MNG_CLIP_MASTER READ). 관제 공유 DB 가 없으면 false 권장.
TRAINING_SCAN_ENABLED=true
TRAINING_SCAN_INTERVAL_SEC=60

# ── 개발/브링업 토글 (관제서버 미기동 시 임시 로그인·영상수신용) ──
# ⚠ 운영 정상화 후 반드시 모두 미설정(OFF)로 원복. dev 로그인은 인증 없이 임의 role 토큰을 발급한다.
# DEV_LOGIN_ENABLED=true        # /v1/dev/tokens 로 테스트 토큰 발급 허용(기본 false)
# DEV_UPLOAD_ENABLED=true       # /v1/dev/autolabel-test 영상 업로드 허용(기본 false)
# SPRING_SERVLET_MULTIPART_ENABLED=true   # ★ dev 업로드 사용 시 필수 — 안 켜면 업로드 415/파싱불가

# ============================================================================
# 외부 시스템 연동 토글 (온프렘에 외부가 없으면 아래로 비활성화)
#   ── 04-configuration.md "외부 연동 경로 vs 자족 경로" 표 참고 ──
# ============================================================================

# ---- KPST 비식별 위탁(폴링) ── ★ 확정 정책: KPST 동거 연동 -----------------
# ⚡ 한 줄 요약: 아래 기본값 그대로 두면 부팅 실패 →
#     ① https 유지 시 KPST_DEID_CA_CERT_PATH 에 CA(ca.crt) 경로 입력, 또는
#     ② 격리망 평문이면 KPST_DEID_BASE_URL 을 http://... 로 바꾸면 CA 불필요.
# ★ 운영 전제(확정): KPST 비식별 서버를 폐쇄망에 함께 설치하고 backend 가 폴링으로 연동한다.
#   KPST 서버 자체는 외부 시스템 — 본 설치 패키지에 포함되지 않으며 고객이 별도 설치한다.
#   본 패키지는 backend ↔ KPST 연동 설정·절차만 제공한다(04-configuration.md B 절).
# ★ 기본 true 유지. mock/disable 우회는 prd 에서 미지원 — 비식별을 끄면 개인정보(PII)가 노출되고
#   파이프라인(마킹/프레임추출)이 차단된다. false 이고 mock 도 아니면 DeidentifyStep 이 설정오류로 거부한다.
KPST_DEID_ENABLED=true
# ★ 동거 KPST 서버 주소로 반드시 교체. base-url 스키마로 전송 방식이 자동 분기된다.
#   - https://IP:PORT  → 사설 CA 인증서 경로(KPST_DEID_CA_CERT_PATH)가 필수(아래 참고).
#   - http://IP:PORT   → 격리망 평문. CA 불요(비워둠).
KPST_DEID_BASE_URL=https://127.0.0.1:9201
# ★ https 일 때만 필수: KPST 사설 CA(ca.crt) 파일 경로. https 인데 비었거나 못 읽으면
#   부팅 시점에 fail-closed 로 기동 실패(CWE-295, KpstWebClientConfig.buildSslContext).
#   http base-url 이면 불필요하므로 비워둔다.
KPST_DEID_CA_CERT_PATH=
KPST_DEID_CREATOR_ID=authoring
KPST_DEID_REQ_USER_ID=authoring
KPST_DEID_EXPORT_PATH_BASE=/share/Deid-data/export/
KPST_DEID_POLL_INTERVAL_SEC=30
KPST_DEID_POLL_MAX_ATTEMPTS=240
KPST_DEID_POLL_TIMEOUT_MINUTES=180

# ---- 관제서버 outbound 완료/수정 통지 ------------------------------------
# · 기본 false. 관제서버 inbound SPI 가 있으면 true + URL 주입.
CONTROL_NOTIFY_ENABLED=false
CONTROL_NOTIFY_URL=http://127.0.0.1:8090
CONTROL_NOTIFY_TIMEOUT_MS=10000
CONTROL_NOTIFY_DEBOUNCE_SEC=60

# ---- 외부 VLM 시계열 위탁 -------------------------------------------------
# · 기본 false. 외부 VLM 서비스가 있으면 true + URL/TOKEN 주입.
VLM_CLIENT_ENABLED=false
VLM_SERVICE_URL=http://127.0.0.1:9400
VLM_SERVICE_TOKEN=

# ---- DEIDENTIFY_API_URL (헬스 핑/레거시 WebClient base-url) ---------------
# · 비식별 단일 경로는 KPST 폴링이라 실 비식별 호출에는 쓰이지 않지만,
#   헬스 인디케이터가 이 주소를 핑한다(authoring.integration.deidentify.base-url).
#   KPST 가 헬스 엔드포인트를 제공하면 그 주소로, 아니면 무해한 기본값으로 둔다.
DEIDENTIFY_API_URL=http://127.0.0.1:9200

# ---- 증강 콜백 base URL ---------------------------------------------------
# · 외부 증강 결과 push 콜백 base. 동일 서버면 backend 자신.
WEBHOOK_CALLBACK_BASE_URL=http://127.0.0.1:8080/api

# ---- JVM 옵션 (systemd 유닛에서 사용) -------------------------------------
JAVA_OPTS=-XX:MaxRAMPercentage=75.0 -XX:+UseG1GC -Duser.timezone=Asia/Seoul

# ============================================================================
# ★ 비식별 정책 (확정 — KPST 동거 연동):
#   - 폐쇄망에 KPST 비식별 서버를 함께 설치하고 위 KPST_DEID_* 로 연동한다.
#   - prd 에는 mock/disable 우회 경로가 없다. 'integration.deidentify.mock-mode=true'
#     자족 비식별은 application-local.yml 전용이고, local 프로파일은 LocalProfileGuard
#     가 운영 호스트에서 거부한다. 즉 prd 에서 비식별을 끄거나 mock 으로 우회할 수 없다.
#   - 비식별을 끄면 PII 노출 + 마킹/프레임추출 차단이므로 반드시 KPST 연동을 갖춘다.
#     상세·증상·진단은 04-configuration.md B 절 / 06-troubleshooting.md 참고.
# ============================================================================
