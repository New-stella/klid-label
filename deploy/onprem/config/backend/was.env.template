# ============================================================================
# was.env — WAS "현장값" 기록 파일  (설치 위치: /etc/klid/was.env)
#
# ★★ 이 파일은 <애플리케이션 설정이 아니다>. 앱도 WAS 도 이 파일을 읽지 않는다.
#   운영 런북(docs/09-operations-runbook.md)의 백엔드 조작 명령이
#     source /etc/klid/was.env 2>/dev/null || WAS_UNIT='<WAS 유닛명>'
#   형태로 <셸에서> 읽는 값이다. 즉 "장비마다 다른 WAS 사실"을 한 곳에 적어 두고
#   런북 명령을 복붙만으로 동작시키기 위한 파일이다.
#
#   ⚠ 여기에 DB 접속정보·JWT_SECRET·HMAC 키 같은 <앱 설정이나 비밀값을 넣지 마라>.
#     그것들은 성격이 다른 파일에 들어간다:
#       · /etc/klid/application.properties  ← WAR 반입 형상에서 WAS 가 읽는 앱 설정(비밀값 포함)
#       · /etc/klid/backend.env             ← 베어메탈 형상(systemd EnvironmentFile)용
#     이 파일(was.env)은 <운영자가 읽고 고쳐야 하는 메모>라 권한을 조이지 않는다.
#     비밀값을 넣으면 그 전제가 깨진다.
#
#   ⚠ 설치 스크립트는 이 파일이 이미 있으면 <덮어쓰지 않는다>. 현장값이 날아가지 않게 하기
#     위해서다. 키를 추가해야 하면 이 템플릿을 보고 손으로 덧붙인다.
#
#   ★ 백엔드는 systemd 유닛이 아니다 — 외부 WAS 가 기동 주체다. 우리가 유닛으로 다루는 것은
#     klid-ai-server 와 httpd 둘뿐이다. 그래서 "백엔드를 재기동하라"는 지시가 장비마다
#     달라지고, 그 차이를 흡수하는 자리가 이 파일이다.
# ============================================================================

# WAS 를 기동·중지하는 systemd 유닛 이름.
#   예: tomcat · tomcat9 · was · jeus 등. 현장에서 `systemctl list-units | grep -i tomcat` 으로 확인.
#   런북 명령: sudo systemctl restart "${WAS_UNIT}"
WAS_UNIT=

# WAS 설치 루트(CATALINA_HOME 또는 그에 준하는 경로).
#   setenv.sh · server.xml · context.xml 이 이 아래에 있다(config/was/ 예시 참조).
WAS_HOME=

# WAS 배포 디렉터리 — 우리가 api.war 를 복사해 넣는 곳.
#   ★ install.sh 는 /opt/klid/app/api.war 에 <두기만> 하고 여기로 복사하지 않는다(사람 작업).
#   ★ 파일명을 바꾸지 말 것 — WAR 배포에서 웹 컨텍스트(/api)를 파일명이 정한다.
#   예: ${WAS_HOME}/webapps
WAS_DEPLOY_DIR=

# WAS 로그 디렉터리 — 백엔드 로그를 여기서 본다(우리 /var/log/klid 가 아니다).
#   런북 명령: sudo tail -f "${WAS_LOG_DIR}/catalina.out"
WAS_LOG_DIR=

# WAS 실행 계정 — 배포한 WAR 와 우리가 만든 저장소 경로에 접근할 수 있어야 한다.
#   ★ 이 계정이 NAS 저장소(STORAGE_RAW_PATH)에 읽기·쓰기 가능한지 반드시 확인할 것.
#     기동은 되는데 영상 저장만 실패하는 형태로 드러난다.
WAS_USER=

# 백엔드가 응답하는 주소(헬스체크·프록시 대상 확인용).
#   httpd 드롭인의 프록시 대상(BACKEND_ORIGIN)과 같아야 한다.
WAS_BACKEND_ORIGIN=http://127.0.0.1:8080
