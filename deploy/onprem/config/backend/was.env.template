# ============================================================================
# was.env — WAS "현장값" 기록 파일  (설치 위치: /etc/klid/was.env)
#
# ★★ 이 파일은 <애플리케이션 설정이 아니다>. 앱도 WAS 도 이 파일을 읽지 않는다.
#   운영 런북(docs/09-operations-runbook.md)의 백엔드 조작 명령이
#     source /etc/klid/was.env
#   한 줄로 <셸에서> 읽는 값이다. 즉 "장비마다 다른 WAS 사실"을 한 곳에 적어 두고
#   런북 명령을 복붙만으로 동작시키기 위한 파일이다.
#
#   ★ 값뿐 아니라 <함수>도 정의한다(맨 아래). 런북의 backend 조작은 전부
#     was_start / was_stop / was_restart / was_status 로 통일돼 있고, 그 함수가
#     기동 방식(systemd 인지 스크립트인지)의 차이를 흡수한다. 런북 본문에
#     systemctl 을 직접 쓰지 않는 이유가 이것이다.
#
#   ⚠ 여기에 DB 접속정보·JWT_SECRET·HMAC 키 같은 <앱 설정이나 비밀값을 넣지 마라>.
#     그것들은 성격이 다른 파일에 들어간다:
#       · /etc/klid/application.properties  ← WAR 반입 형상에서 WAS 가 읽는 앱 설정(비밀값 포함)
#       · /etc/klid/backend.env             ← 베어메탈 형상(systemd EnvironmentFile)용
#     이 파일(was.env)은 <운영자가 읽고 고쳐야 하는 메모>라 권한을 조이지 않는다.
#     비밀값을 넣으면 그 전제가 깨진다.
#
#   ⚠ 설치 스크립트는 이 파일이 이미 있으면 <덮어쓰지 않는다>. 현장값이 날아가지 않게 하기
#     위해서다. 키를 추가해야 하면 이 템플릿을 보고 손으로 덧붙인다.
#
#   ★ 백엔드는 systemd 유닛이 아니다 — 외부 WAS 가 기동 주체다. 우리가 유닛으로 다루는 것은
#     klid-ai-server 와 httpd 둘뿐이다. 그래서 "백엔드를 재기동하라"는 지시가 장비마다
#     달라지고, 그 차이를 흡수하는 자리가 이 파일이다.
# ============================================================================

# WAS 를 기동·중지하는 systemd 유닛 이름. <systemd 로 뜨는 형상에서만> 채운다.
#   찾기: systemctl list-units --type=service --all | grep -iE 'jboss|eap|wildfly'
#   ⚠ 유닛이 <있어도> 그것으로 안 뜰 수 있다 — 아래 WAS_CTL 의 판정을 먼저 할 것.
WAS_UNIT=

# WAS 설치 루트(JBOSS_HOME — 실측 예: /GCLOUD/JBOSS/jboss-eap-8.1).
#   bin/standalone.conf · standalone/configuration/standalone.xml · standalone/deployments/ 가
#   이 아래에 있다(config/was/ 예시 참조).
WAS_HOME=

# WAS 배포 디렉터리 — 우리가 api.war 를 복사해 넣는 곳.
#   ★ install.sh 는 /opt/klid/app/api.war 에 <두기만> 하고 여기로 복사하지 않는다(사람 작업).
#   ⚠ 구 규칙 폐기(2026-09-04): "파일명이 곧 컨텍스트이므로 rename 금지".
#     EAP 에서는 WAR 안 WEB-INF/jboss-web.xml 이 컨텍스트를 /api 로 고정하므로 파일명은
#     무엇이든 된다(현장은 klid-at-api.war). 상세: docs/10-was-settings.md §7.
#   예(EAP): ${WAS_HOME}/standalone/deployments      ← 톰캣의 webapps/ 가 아니다
WAS_DEPLOY_DIR=

# WAS 로그 디렉터리 — 백엔드 로그를 여기서 본다(우리 /var/log/klid 가 아니다).
#   런북 명령: sudo tail -f "${WAS_LOG_DIR}/server.log"   (EAP: <JBOSS_HOME>/standalone/log)
#   ★ 애플리케이션 로그도 <같은 파일에 합류>한다 — 앱은 파일 로깅을 쓰지 않고 표준출력으로만
#     내보내며, EAP 로깅 서브시스템이 그것을 server.log 에 받는다. /var/log/klid 는 비어 있다.
WAS_LOG_DIR=

# WAS 실행 계정 — 배포한 WAR 와 우리가 만든 저장소 경로에 접근할 수 있어야 한다.
#   ★ 이 계정이 NAS 저장소(STORAGE_RAW_PATH)에 읽기·쓰기 가능한지 반드시 확인할 것.
#     기동은 되는데 영상 저장만 실패하는 형태로 드러난다.
WAS_USER=

# 백엔드가 응답하는 주소(헬스체크·프록시 대상 확인용).
#   httpd 드롭인의 프록시 대상(BACKEND_ORIGIN)과 같아야 한다.
WAS_BACKEND_ORIGIN=http://127.0.0.1:8080

# ============================================================================
# ★★ 기동 방식 — 이걸 먼저 판정한다 (2026-09-09 현장 실측으로 추가)
#
#   WAS 가 systemd 로 뜨는 형상만 있는 게 아니다. 현장(klid-ai-gen-was-01~04)은
#   <systemd 가 아니라> kill + <JBOSS_HOME>/bin/start.sh 로 띄우고 있었다.
#   그 형상에서 systemctl restart 를 하면 아무 일도 안 일어나거나(유닛 없음),
#   유닛이 있는데 inactive 면 <두 번째 인스턴스>가 뜨려다 포트를 못 잡고 실패한다.
#   "배포 실패"로 오인하기 쉽다.
#
#   판정 (두 줄 다 본다 — 유닛의 <존재>가 아니라 <그것으로 떴는가>가 기준이다):
#       pgrep -af 'jboss-modules.jar'                  # 프로세스가 떠 있는가, 부모가 무엇인가
#       systemctl is-active <위에서 찾은 유닛명>        # active 인가
#     · 프로세스 있음 + 유닛 active        → WAS_CTL=systemd
#     · 프로세스 있음 + 유닛 없음/inactive → WAS_CTL=script   ← 현장이 이쪽이다
# ============================================================================
WAS_CTL=

# WAS_CTL=script 일 때만 채운다. 현장에서 실제로 쓰는 명령을 <그대로> 적는다.
#   ⚠ 계정 전환이 필요하면 그것까지 포함해 적는다.  예: sudo -u jboss ${WAS_HOME}/bin/start.sh
#   ⚠ 추측해서 적지 마라 — 기동 스크립트를 열어 확인한 명령만 적는다.
WAS_START_CMD=
WAS_STOP_CMD=

# ---------------------------------------------------------------------------
# 런북이 부르는 함수 4개. 이 아래는 현장에서 고칠 일이 없다(값만 위에서 채운다).
# ---------------------------------------------------------------------------
_was_need() {
  echo "was.env: $1 이(가) 비어 있습니다 — /etc/klid/was.env 를 채우세요" >&2
  echo "         (설명: docs/09-operations-runbook.md §0-1)" >&2
  return 1
}

was_status() {
  case "${WAS_CTL}" in
    systemd) [ -n "${WAS_UNIT}" ] || { _was_need WAS_UNIT; return 1; }
             systemctl status "${WAS_UNIT}" --no-pager ;;
    script)  pgrep -af 'jboss-modules.jar' || echo '(WAS 프로세스 없음)' ;;
    *)       _was_need WAS_CTL ;;
  esac
}

was_start() {
  case "${WAS_CTL}" in
    systemd) [ -n "${WAS_UNIT}" ] || { _was_need WAS_UNIT; return 1; }
             sudo systemctl start "${WAS_UNIT}" ;;
    script)  [ -n "${WAS_START_CMD}" ] || { _was_need WAS_START_CMD; return 1; }
             eval "${WAS_START_CMD}" ;;
    *)       _was_need WAS_CTL ;;
  esac
}

was_stop() {
  case "${WAS_CTL}" in
    systemd) [ -n "${WAS_UNIT}" ] || { _was_need WAS_UNIT; return 1; }
             sudo systemctl stop "${WAS_UNIT}" ;;
    script)  [ -n "${WAS_STOP_CMD}" ] || { _was_need WAS_STOP_CMD; return 1; }
             eval "${WAS_STOP_CMD}" ;;
    *)       _was_need WAS_CTL ;;
  esac
}

# ★ 재기동은 stop 성공만으로 끝내지 않는다. 프로세스가 실제로 사라지고 8080 이 풀린 뒤에
#   start 해야 한다 — 안 그러면 두 번째 인스턴스가 포트를 못 잡고 죽는다(위 판정 절의 그 실패).
was_restart() {
  if [ "${WAS_CTL}" = "systemd" ]; then
    [ -n "${WAS_UNIT}" ] || { _was_need WAS_UNIT; return 1; }
    sudo systemctl restart "${WAS_UNIT}"; return $?
  fi
  was_stop || return 1
  local i=0
  while pgrep -f 'jboss-modules.jar' >/dev/null 2>&1; do
    i=$((i+1)); [ "${i}" -ge 60 ] && { echo "was.env: 60초 안에 WAS 프로세스가 내려가지 않았습니다 — 직접 확인하세요" >&2; return 1; }
    sleep 1
  done
  was_start
}
