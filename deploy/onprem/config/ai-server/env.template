# ============================================================================
# klid-ai-server 환경설정 (EnvironmentFile=/etc/klid/ai-server.env)
#
#   pydantic-settings 기반(ai-server/app/config.py). 대소문자 무관, extra=ignore.
#   형식: KEY=VALUE (systemd EnvironmentFile — 따옴표/셸확장 없음)
# ============================================================================

# ---- 바인드 주소 (서버 2대 구성에서 반드시 확인) --------------------------
# ★ ai-server 가 어느 주소에서 접속을 받을지. systemd 유닛의 uvicorn --host 로 들어간다.
#   - 단일 서버 구성(backend 와 같은 장비) → 127.0.0.1 그대로 둔다. 외부에 열리지 않아 안전하다.
#   - 2대 분리 구성(서버 B 전용 장비)     → ★ 반드시 바꾼다. loopback 으로는 서버 A 의
#     backend 가 <원격에서 닿지 못한다>(연결 거부).
#       · 서버 B 의 내부망 IP 만 여는 것을 권장:  AI_BIND_HOST=10.0.0.12
#       · 전 인터페이스:                          AI_BIND_HOST=0.0.0.0
# ⚠ 주소를 여는 것만으로는 부족하다 — 방화벽에서 9300/tcp 을 <서버 A 에서만> 오도록 함께 연다.
#   ai-server 에는 인증이 없다. 넓게 열면 누구나 추론을 호출할 수 있다.
# ⚠ 서버 A 의 AI_SERVER_URL 도 이 장비를 가리키게 <함께> 바꿔야 한다. 한쪽만 바꾸면
#   오토라벨링만 조용히 실패한다(기동·헬스체크는 정상).
AI_BIND_HOST=127.0.0.1

# ---- 동작 모드 ------------------------------------------------------------
# · 실제 모델 추론(false) / 고정 mock 응답(true). 기본 false.
#   ★ 배포 환경(아래 ENV=stg|prd)에서 true 로 두면 기동이 실패한다(app/startup_guard.py).
#     mock 응답은 실제 객체와 무관한 합성 라벨(person, score=0.9)이라 학습데이터를 오염시킨다.
AI_MOCK_MODE=false

# ---- 배포 환경 표식 -------------------------------------------------------
# · backend/env.template 의 ENV 와 동일 신호(local|dev|stg|prd). 위험한 설정 조합을
#   기동 시점에 차단하는 fail-closed 가드의 판정 축이다. 운영 설치는 prd.
ENV=prd
# ★ 이번 반입은 <CPU 전용>이다 → cpu
#   ⚠ 구 주석 폐기(2026-08-30) — "CPU 전용 서버 → cpu (GPU 없음)". ai 서버 장비에 GPU 가
#     <있을 수> 있다. CPU 인 것은 장비가 아니라 <반입한 wheel>이다(torch CPU 판 +
#     onnxruntime CPU 판). 그래서 여기를 cuda 로 바꾸기만 하면 아무 일도 일어나지 않거나
#     조용히 CPU 로 돈다 — 오류가 나지 않으므로 바꿨다고 착각하기 쉽다.
#   ★ GPU 로 옮기려면 조달(휠)·드라이버까지 함께 바꿔야 한다 → docs/11-gpu-migration.md
AI_DEVICE=cpu

# ---- 탐지 백엔드 ----------------------------------------------------------
# · 탐지는 YOLOX 단일(onnxruntime CPU + yolox_s.onnx 가중치). config.py 설정 없음(코드 고정).
#   HF 모델 prefetch 는 SAM2(분할/Track)만 필요 — 탐지(YOLOX)는 HF 불필요.

# ---- 모델 가중치/캐시 경로 ------------------------------------------------
# ★ 설치 루트를 여기에 <절대경로로 박지 않는다> (2026-09-08).
#   AI 장비의 설치 루트는 /GCLOUD/klid-at 이다(KLID_AI_PREFIX) — 다른 서버의 /opt/klid 와 다르다.
#   이 파일은 13-install-ai-server.sh 가 @KLID_PREFIX@ 를 치환해 /etc/klid/ai-server.env 로
#   배치한다. 종전에는 치환 없이 그대로 복사했고, 그래서 설치 루트를 바꿔 설치해도
#   이 두 줄만 옛 경로를 가리켰다. 그때 서버는 <정상 기동하고 /health 도 200 을 준다> —
#   YOLOX 는 weights_missing 사유로 <빈> detections 를 돌려주고 SAM2 는 mock 으로 떨어져,
#   오토라벨링이 조용히 0 건이 된다. 설치 로그에도 오류가 남지 않는다.
#
# · YOLOX ONNX 가중치 경로. 설치 시 @KLID_PREFIX@/ai/weights/yolox_s.onnx 로 배치된다.
#   ★ 상대경로로 둔다 — systemd 유닛의 WorkingDirectory 가 @KLID_PREFIX@/ai 이고
#     ai-server 코드 기본값도 같은 값(app/config.py 의 yolox_weights_path)이라,
#     설치 루트가 어디로 바뀌어도 따라온다. 절대경로가 필요하면 아래를 주석 처리하고
#     직접 적되, 루트를 옮길 때 이 줄도 함께 고쳐야 한다는 것을 기억할 것.
YOLOX_WEIGHTS_PATH=./weights/yolox_s.onnx
# · SAM2 HF 모델 ID(SAM2 분할/Track 사용 시). 폐쇄망은 HF_HOME 캐시에 사전 배치 필요.
SAM2_MODEL_ID=facebook/sam2-hiera-tiny
VLM_MODEL_NAME=openai/clip-vit-base-patch32

# ★ HuggingFace 캐시 디렉토리(오프라인). 설치 시 @KLID_PREFIX@/ai/.hf-cache 로 배치.
#    SAM2 사용 시 이 경로에 모델이 사전 캐시되어 있어야 한다(오프라인 다운로드 불가).
#    ⚠ 여기는 상대경로를 쓸 수 없다 — huggingface_hub 이 이 값을 프로세스 CWD 와 무관하게
#      해석하고, startup_guard 도 절대경로를 전제로 검사한다. 그래서 설치 시 치환한다.
HF_HOME=@KLID_PREFIX@/ai/.hf-cache
# · 완전 오프라인 강제(네트워크 시도 자체 차단). SAM2 캐시가 완비된 경우만 1 권장.
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1

# ---- 보안/제한 ------------------------------------------------------------
# · 입력 image_b64 최대 크기(MB, 1~100)
MAX_IMAGE_SIZE_MB=10
# · CORS allowlist(콤마 구분) — <브라우저>가 직접 호출할 때만 쓰이는 값이다.
#   ⚠ 2대 구성이라고 해서 이 값을 바꿀 필요는 없다. backend → ai-server 호출은 서버 간
#     호출이라 Origin 헤더가 없고, CORS 심사 대상이 아니다. 바꿔야 하는 것은 위
#     AI_BIND_HOST(+방화벽)와 서버 A 의 AI_SERVER_URL 이다.
#   브라우저에서 ai-server 를 직접 부르는 구성을 쓰지 않는다면 이 값은 그대로 둔다.
CORS_ALLOW_ORIGINS=http://127.0.0.1:8080

# ============================================================================
# 참고: 포트(9300)는 코드에서 고정(uvicorn --port 9300, systemd 유닛에 명시).
#       config.py 에 PORT 설정은 없다.
# ============================================================================
