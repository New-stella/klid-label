# ============================================================================
# klid-ai-server 환경설정 (EnvironmentFile=/etc/klid/ai-server.env)
#
#   pydantic-settings 기반(ai-server/app/config.py). 대소문자 무관, extra=ignore.
#   형식: KEY=VALUE (systemd EnvironmentFile — 따옴표/셸확장 없음)
# ============================================================================

# ---- 동작 모드 ------------------------------------------------------------
# · 실제 모델 추론(false) / 고정 mock 응답(true). 기본 false.
AI_MOCK_MODE=false
# ★ CPU 전용 서버 → cpu (GPU 없음)
AI_DEVICE=cpu

# ---- 탐지 백엔드 ----------------------------------------------------------
# · 탐지는 YOLOX 단일(onnxruntime CPU + yolox_s.onnx 가중치). config.py 설정 없음(코드 고정).
#   HF 모델 prefetch 는 SAM2(분할/Track)만 필요 — 탐지(YOLOX)는 HF 불필요.

# ---- 모델 가중치/캐시 경로 ------------------------------------------------
# · YOLOX ONNX 가중치 경로. 설치 시 /opt/klid/ai/weights/yolox_s.onnx 로 배치됨.
#   uvicorn 작업 디렉토리(WorkingDirectory=/opt/klid/ai) 기준 상대경로 './weights/...' 도 동작.
YOLOX_WEIGHTS_PATH=/opt/klid/ai/weights/yolox_s.onnx
# · SAM2 HF 모델 ID(SAM2 분할/Track 사용 시). 폐쇄망은 HF_HOME 캐시에 사전 배치 필요.
SAM2_MODEL_ID=facebook/sam2-hiera-tiny
VLM_MODEL_NAME=openai/clip-vit-base-patch32

# ★ HuggingFace 캐시 디렉토리(오프라인). 설치 시 /opt/klid/ai/.hf-cache 로 배치.
#    SAM2 사용 시 이 경로에 모델이 사전 캐시되어 있어야 한다(오프라인 다운로드 불가).
HF_HOME=/opt/klid/ai/.hf-cache
# · 완전 오프라인 강제(네트워크 시도 자체 차단). SAM2 캐시가 완비된 경우만 1 권장.
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1

# ---- 보안/제한 ------------------------------------------------------------
# · 입력 image_b64 최대 크기(MB, 1~100)
MAX_IMAGE_SIZE_MB=10
# · CORS allowlist(콤마 구분). 동일 서버 backend 만 호출하면 그 주소만 허용 권장.
CORS_ALLOW_ORIGINS=http://127.0.0.1:8080

# ============================================================================
# 참고: 포트(9300)는 코드에서 고정(uvicorn --port 9300, systemd 유닛에 명시).
#       config.py 에 PORT 설정은 없다.
# ============================================================================
