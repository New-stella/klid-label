#!/bin/sh
# ============================================================================
# klid-label backend — JBoss EAP JVM 기동 옵션 예시  [@design DEPLOY-001]
#
#   대상 WAS  : JBoss EAP 8.1 (standalone) + Java 17 — 2026-09-04 현장 실측
#   대상 위치 : $JBOSS_HOME/bin/standalone.conf      (예: /GCLOUD/JBOSS/jboss-eap-8.1/bin/)
#               EAP 의 standalone.sh 가 기동 시 이 파일을 source 한다.
#
#   ⚠ WAS 를 systemd 로 띄우고 있으면 그 유닛이 EnvironmentFile 이나 자체 스크립트로 JAVA_OPTS 를
#     따로 주고 있을 수 있다. 그때는 standalone.conf 가 무시되거나 덮어써질 수 있으므로
#     <실제로 어디서 오는지> 먼저 확인한다:
#         systemctl cat <WAS 유닛명> | grep -iE 'EnvironmentFile|ExecStart|JAVA_OPTS'
#     그 자리에 넣어야 반영된다.
#
#   ★ 이미 standalone.conf 가 있으면 덮어쓰지 말고 <아래 항목만 병합>한다.
#     같은 WAS 에 다른 애플리케이션이 있을 수 있고, 그쪽 옵션이 함께 들어 있다.
#     현장 실측 기동 명령에도 --add-opens / --add-exports / -Djdk.serialFilter 등 EAP 자신의
#     옵션이 다수 붙어 있었다 — 그것들을 지우면 WAS 가 뜨지 않는다.
#
#   ★ 여기 적는 것은 <JVM 기동 옵션>뿐이다. DB 접속 정보·시크릿은 적지 않는다 —
#     그것들은 /etc/klid/application.properties 에 있고, 이 파일은 그 <위치만> 알려 준다.
#     ⚠⚠ 시크릿을 -D 로 넘기지 말 것. 시스템 프로퍼티는 `ps -ef` 에 그대로 보여
#        그 장비의 어느 계정이나 읽을 수 있다(CWE-214). 파일 경로만 넘긴다.
#
#   ⚠ 이 값들을 바꾸면 재배포로는 반영되지 않는다. JVM 기동 옵션이라 WAS 프로세스를
#     다시 띄워야 한다.
#
#   ⚠ 구 파일 폐기(2026-09-04): setenv.sh.example (톰캣 CATALINA_OPTS 예시).
#     대상 WAS 가 JBoss EAP 8.1 로 확인돼 폐기했다. EAP 에는 setenv.sh 도 CATALINA_OPTS 도 없다.
# ============================================================================

# ---- 스프링 외부 설정 --------------------------------------------------------
#   · additional-location 은 <디렉터리>를 가리키고 끝에 슬래시가 필요하다.
#     그 디렉터리의 application.properties / application-<프로파일>.properties 가 읽힌다.
#   · 활성 프로파일은 설정 파일이 아니라 여기서 준다(파일 로드 시점을 프로파일이 정하므로).
#   · 파일은 <WAS 실행 계정>(현장 실측: jboss)이 읽을 수 있어야 한다. 권한이 root:klid 640 이면
#     jboss 계정을 klid 그룹에 넣거나 소유 그룹을 조정한다 —
#     못 읽으면 WAS 는 뜨고 애플리케이션만 설정 없이 기동에 실패한다.
KLID_OPTS="-Dspring.config.additional-location=file:/etc/klid/"
KLID_OPTS="${KLID_OPTS} -Dspring.profiles.active=prd"

# ---- JVM ---------------------------------------------------------------------
#   ⚠⚠ 아래 세 줄은 <WAS 프로세스 전체>에 걸린다. 같은 WAS 에 다른 애플리케이션이 있으면
#     그대로 옮기기 전에 총 사용량을 확인하고, 이미 값이 잡혀 있으면 <그쪽을 존중>한다.
#     특히 MaxRAMPercentage 를 두 번 주면 나중 것이 이기므로 조용히 기존 정책이 바뀐다.
KLID_OPTS="${KLID_OPTS} -XX:MaxRAMPercentage=75.0 -XX:+UseG1GC"
KLID_OPTS="${KLID_OPTS} -Duser.timezone=Asia/Seoul"
#   · 폐쇄망/신규 VM 의 엔트로피 고갈로 SecureRandom 초기화가 수십초~수분 블로킹되는 기동
#     지연을 막는다. /./ 는 JDK 의 알려진 동작을 피하기 위한 의도된 표기이며 오타가 아니다.
#     추가로 OS 에 haveged 또는 rng-tools 설치를 권장한다.
KLID_OPTS="${KLID_OPTS} -Djava.security.egd=file:/dev/./urandom"

# ---- 반영 --------------------------------------------------------------------
#   기존 JAVA_OPTS 를 덮어쓰지 않고 뒤에 붙인다(EAP 자신의 옵션과 다른 앱 옵션 보존).
#   ⚠ 톰캣의 CATALINA_OPTS 가 아니라 JAVA_OPTS 다.
JAVA_OPTS="${JAVA_OPTS} ${KLID_OPTS}"
export JAVA_OPTS

# ---- 확인 --------------------------------------------------------------------
#   기동 후 실제로 걸렸는지 본다(아래는 예시 명령 — 이 파일에서 실행하지 않는다):
#     ps -ef | grep '[j]boss' | tr ' ' '\n' | grep -E 'spring.config|spring.profiles|MaxRAM'
#   애플리케이션이 어떤 설정 파일을 읽었는지는 기동 로그의 스프링 배너 직후 줄에도 남는다:
#     grep -iE 'The following .* profile|config.*location' $JBOSS_HOME/standalone/log/server.log
