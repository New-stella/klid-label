<?xml version="1.0" encoding="UTF-8"?>
<!--
  klid-label backend — 컨텍스트 배포 서술자 예시  [@design DEPLOY-001]

  대상 위치: <WAS_BASE>/conf/Catalina/localhost/api.xml
             (Host 이름이 localhost 가 아니면 그 이름의 디렉터리 아래)

  ★ 파일명이 곧 컨텍스트 경로다. api.xml -> /api
    현재 저작도구 API 주소가 전부 /api 하위이므로 이 이름을 바꾸지 않는다.
    (스프링의 server.servlet.context-path 는 내장 서버 전용이라 이 형상에서 적용되지 않는다.)

  ★ 이 서술자를 쓰는 방식과 webapps 에 직접 두는 방식 중 하나만 고른다.
      (A) 서술자 방식(이 파일) : WAR 를 배포 디렉터리 밖(/opt/klid/app)에 두고 docBase 로 가리킨다.
                                 install.sh 가 갱신한 WAR 를 복사 없이 그대로 쓸 수 있다.
      (B) webapps 방식          : /opt/klid/app/api.war 를 <WAS_BASE>/webapps/api.war 로 복사한다.
                                 이때 WAS 가 풀어 둔 webapps/api/ 디렉터리는 교체 전에 지워야
                                 새 WAR 가 반영된다.
    ⚠ 둘을 동시에 하면 같은 애플리케이션이 두 번 배포될 수 있다.

  ⚠ 비밀값을 이 파일에 적지 않는다. 접속 정보·시크릿은 /etc/klid/application.properties 에 있고,
    그 파일의 위치는 setenv.sh 의 -Dspring.config.additional-location 이 알려 준다.
-->
<Context docBase="/opt/klid/app/api.war"
         reloadable="false"
         antiResourceLocking="false">
  <!--
    path 속성은 여기에 적지 않는다. server.xml 에 정적으로 정의할 때만 유효하고,
    서술자 파일에서는 무시된다 — 컨텍스트 경로는 이 파일의 이름(api.xml)이 정한다.
  -->

  <!--
    풀린 애플리케이션 디렉터리 위치. WAS 실행 계정(<WAS 실행 계정>)이 쓸 수 있어야 한다.
    지정하지 않으면 WAS 기본 위치를 쓴다 — 기본값으로 충분하면 이 요소를 지운다.
  -->
  <!-- <Resources cachingAllowed="true" cacheMaxSize="102400" /> -->

  <!--
    ★★ 프록시 IP 치환 밸브(RemoteIpValve)를 여기에 넣지 말 것.
       getRemoteAddr() 을 X-Forwarded-For 값으로 무검증 치환해, 신뢰 프록시 대조와
       웹훅 시도 횟수 제한이 헤더 한 줄로 우회된다(CWE-348 / CWE-307).
       앱 가드는 WAS 설정 파일을 볼 수 없어 이 경우를 잡지 못한다 — 사람이 확인하는 항목이다.
       클라이언트 IP 해석은 앱의 신뢰 프록시 대역 설정(WEBHOOK_TRUSTED_PROXY_CIDRS)이 담당한다.
       상세: docs/10-was-settings.md 4절
    <Valve className="org.apache.catalina.valves.RemoteIpValve" />   <- 넣지 않는다
  -->

</Context>
